                      <profiles>
                        <profile name="Steel-sinewed aim" id="df79-4730-469e-1b01" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made by a model with this Martial Tradition against an enemy unit that is within Engagement Range of their unit, you can ignore any or all modifiers to that attack’s hit roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
