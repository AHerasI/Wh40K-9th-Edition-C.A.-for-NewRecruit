              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per Command phase, when this model uses its Bondsman ability, it can select a NOBLE HOUSEHOLD QUESTORIS-CLASS model (excluding itself) for that ability to apply to instead of an ARMIGER-CLASS model.</characteristic>
              </characteristics>
