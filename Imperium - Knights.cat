                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an Advance roll or a charge roll is made for a model with this tradition, roll one additional D6 and discard one of the dice results.</characteristic>
