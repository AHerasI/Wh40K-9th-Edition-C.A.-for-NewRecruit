                          <conditions>
                            <condition childId="0eb1-3583-9007-9cc1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Paragons of Honour" id="aee2-5e8e-8f73-387d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When selectin Oaths for the army, you must select one additional Oath to a total of three.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Strike and Shield" id="6cc7-78df-d1a8-bca8" collective="false" hidden="true" import="true" type="upgrade">
                      <comment>QI</comment>
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
