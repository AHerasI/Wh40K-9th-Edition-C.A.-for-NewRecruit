  <categoryEntries>
    <categoryEntry name="Mentor" id="f729-9507-2afc-466c" hidden="false">
      <rules>
        <rule name="Recount the Teachings." id="8f1f-45bc-5ede-def8" hidden="false">
          <description>In your Command phase, you can select a model with this rule to recount a teaching it knows, for do so, roll a D6, on a 3+ that recount is inspiring.</description>
