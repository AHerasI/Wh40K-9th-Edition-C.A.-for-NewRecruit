              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Noble Exemplar: Master of Justice" id="cb63-5fbb-802f-cb3c" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle round, when you use an Stratagem, if the model you select to use that Stratagem is under the effects of this models Bondsman ability, then that Stratagem costs 0 Command points.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="f729-9507-2afc-466c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Crusade Duty" id="34f3-7db5-1cbd-476a" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model is in your Crusade force, at the end of the battle, if you won, roll one D6: on a 4+, you gain 1 additional Requisition point.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
