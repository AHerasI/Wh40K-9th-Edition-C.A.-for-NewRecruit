                      <profiles>
                        <profile name="Machine focus" id="4dfa-f957-f965-83ac" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Martial Tradition is selected to shoot, you can re-roll either one Wound roll or one Damage roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Steel-sinewed aim" id="5988-0793-d7f8-9301" collective="false" hidden="true" import="true" type="upgrade">
                      <comment>QM</comment>
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
