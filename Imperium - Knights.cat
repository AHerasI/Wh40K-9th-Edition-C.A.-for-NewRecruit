                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Martial Tradition is selected to shoot, for the purposes of determining how many attacks are made by weapons with the Blast ability, double the number of models in the target unit.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
