              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is wholly within your deployment zone, each time a wound is allocated to it, reduce the Damage characteristic of that attack by 1 (to a minimum of 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
