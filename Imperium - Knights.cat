              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model uses its Bondsman ability, it also applies to every friendly NOBLE HOUSEHOLD ARMIGER-CLASS model within 6&quot; of this model.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
