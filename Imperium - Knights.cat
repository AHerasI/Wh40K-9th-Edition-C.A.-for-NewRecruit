          <profiles>
            <profile name="Noble Exemplar: Herald" id="7f53-8e50-b861-3dc6" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an ARMIGER-CLASS model is under the effects of this model’s Bondsman ability, when that ARMIGER-CLASS model loses a wound, roll a D6, on a 5+ that wound is not lost.</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="f729-9507-2afc-466c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile name="Herald" id="4253-7715-3bb9-580a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a friendly NOBLE HOUSEHOLD model uses a Bondsman ability, if they are within 9&quot; of this Herald, they can select one NOBLE HOUSEHOLD ARMIGER-CLASS model that is within 9&quot; of this Herald for that Bondsman ability to apply to.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
