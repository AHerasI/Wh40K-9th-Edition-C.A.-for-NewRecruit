                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to any Armour saving throw made by models with this Martial Tradition.</characteristic>
                          </characteristics>
                        </profile>
