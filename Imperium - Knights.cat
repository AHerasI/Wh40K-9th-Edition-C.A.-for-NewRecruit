              <profiles>
                <profile name="Relentless advance" id="47f5-40c5-9c93-3e5f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this tradition makes a Normal Move or Advances in your Movement phase, until the end of your Shooting phase, each time it is selected to shoot it counts as having Remained Stationary.</characteristic>
