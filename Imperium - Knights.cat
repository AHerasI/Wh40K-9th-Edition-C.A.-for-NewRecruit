      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <profiles>
        <profile name="Chivalric Oaths" id="42ea-3331-b4d5-012f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">For each Chivalric Oath that is active for the army: 
- If you acomplish at least one of the requeriments of a Pledge during a battle round, then at the end of that battle round, you gain 1 Honour point, 
- If you incurr in at least one of the requeriments of a Troth during a battle round, then at the end of that battle round, you lose 1 Honour point.
- You commence the Battle with 1 Honour Point, and you can never have less than 0 Honour points, or more than 6.
--- If you have 0 Honour points, your army is considered DISHONOURED.
--- If you have between 1 and 4 Honour points, your army is considered HONOURED, and gains the HONOURED ABILITY.
--- If you have more than 5 Honour points, your army is considered VIRTUOUS, and, in addition of the HONOURED ABILITY, gains the VIRTUOUS ABILITY.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name=" Noble Households" id="9987-5dec-82c2-38a3" collective="false" defaultSelectionEntryId="cf9d-e9cc-fd5b-a9d1" hidden="false" import="true">
