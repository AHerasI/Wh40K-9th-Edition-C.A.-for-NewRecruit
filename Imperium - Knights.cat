              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is on the battlefield, each time you spend a Command point to use a Stratagem you can roll one D6: on a 5+, that Command point is refunded.</characteristic>
              </characteristics>
            </profile>
          </profiles>
