                      <profiles>
                        <profile name="Bloodlusting psyche" id="44f8-fa90-9589-91d8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this ability cannot Remain Stationary, unless in engagement range of enemy units, and must Charge against the nearest visible enemy unit during your Charge phase, and it can Advance and Charge in the same turn.
Each time a unit with this ability kills an enemy model with a melee attack, it can make an additional attack, this attacks cannot generate additional attacks.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
