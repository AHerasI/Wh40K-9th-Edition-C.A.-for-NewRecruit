                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this WARLORD, at the end of your Movement phase, roll one D6 for that unit: on a 4+, that unit suffers 1 mortal wound.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
