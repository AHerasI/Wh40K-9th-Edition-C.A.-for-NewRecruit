          <selectionEntries>
            <selectionEntry name="Greater Daemonic summoning Ritual" id="187d-14b8-68f4-bfbd" collective="false" hidden="false" import="true" type="upgrade">
              <categoryLinks>
                <categoryLink name="Summoner" id="bb59-775e-5644-4b4c" hidden="false" primary="false" targetId="4422-c496-629b-0521"/>
              </categoryLinks>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="12"/>
                <cost name="Pts" typeId="points" value="240"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="points" type="decrement" value="40">
                  <conditions>
                    <condition childId="b815-129f-5c91-cc87" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Greater Daemonic summoning Ritual [14PL]" id="d6a5-87ee-8860-abd2" hidden="false">
                  <description>This unit can summon up to 14PL of Daemon units, divided in up to two units. If the Summoner has any CHAOS MARK, the summoned Daemon units must belong to the same CHAOS MARK, with the exception of Undivided, which can select from any other CHAOS MARK, but if it does, it increases the cost of the Summoned unit by 1PL.
You can Disband any summoned unit in your morale phase. Disbanded units are considered to be routed as if they failed a Morale check.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Daemonic summoning Ritual" id="abb7-26ed-3fa8-6afc" collective="false" hidden="false" import="true" type="upgrade">
              <categoryLinks>
                <categoryLink name="Summoner" id="fa19-588a-906d-c473" hidden="false" primary="false" targetId="4422-c496-629b-0521"/>
              </categoryLinks>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="6"/>
                <cost name="Pts" typeId="points" value="120"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="points" type="decrement" value="20">
                  <conditions>
                    <condition childId="b815-129f-5c91-cc87" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Daemonic summoning Ritual [7PL]" id="c6c0-e6cc-e06a-6acd" hidden="false">
                  <description>This unit can summon up to 7PL of Daemon units, divided in up to two units. If the Summoner has any CHAOS MARK, the summoned Daemon units must belong to the same CHAOS MARK, with the exception of Undivided, which can select from any other CHAOS MARK, but if it does, it increases the cost of the Summoned unit by 1PL.
You can Disband any summoned unit in your morale phase. Disbanded units are considered to be routed as if they failed a Morale check.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
