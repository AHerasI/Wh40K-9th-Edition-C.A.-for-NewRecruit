            <condition childId="33b3-f2a3-9749-2f10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Curse of the Walking Pox" id="f0d3-7582-46a1-3573" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made by a model in this unit, if an INFANTRY enemy model is destroyed (excluding INORGANIC models), one of this unit’s destroyed models is added back to it with 1 wound remaining. Models added back to this unit in this way can be set up within Engagement Range of enemy units that are already within Engagement Range of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mindless Horde" id="2d63-b800-abac-f3f8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform actions. In addition, if this unit is included as part of a Crusade force, it can never gain experience points, it can never have any Battle Honours, and any Out of Action tests taken for it are automatically passed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unending Horde" id="35e1-8b43-46c2-ae23" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fodder" id="8400-5cca-35f2-389d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Morale test is taken for this unit, it is automatically passed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Poxwalker" id="05f5-5419-82ac-1649" collective="false" hidden="false" import="true" type="model">
