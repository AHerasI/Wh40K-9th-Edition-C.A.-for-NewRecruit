                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD attempts to perform a Psychic action, roll one additional D6 and discard one D6 when taking that Psychic test.
- Enemy units within 6&quot; of this WARLORD lose their Objective secured ability.
- This WARLORD generates 1D3 additional Cabal points.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TS - 3. Undying form" id="f644-af3f-4050-8fc7" collective="false" hidden="false" import="true" type="upgrade">
