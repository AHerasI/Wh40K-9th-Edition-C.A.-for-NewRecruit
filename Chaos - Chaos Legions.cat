          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="c509-9b59-c69d-f4b1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1"/>
