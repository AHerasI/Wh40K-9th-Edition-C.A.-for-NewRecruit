        <infoLink name="Disciples of Shadows" id="0381-8578-d161-dfb4" hidden="false" targetId="fe26-a9eb-073c-3e98" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Icon of Entrophy" id="763e-db95-bf22-7d26" hidden="false">
      <profiles>
        <profile name="Icon of Entrophy" id="e480-3789-8c4f-47f2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this ICON can re-roll Morale tests</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Icon of Slaughter" id="facf-d718-aa26-1a8e" hidden="false">
      <profiles>
        <profile name="Icon of Slaughter" id="82a2-c25d-fb4d-2284" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in the bearer&apos;s unit makes a melee attack, if that models unit made a charge move, was charged or performed a Heroic Intervention this turn, add 1 to the Strength characteristic of that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Icon of Pestilence" id="5ae9-547f-bad1-9bf0" hidden="false">
      <profiles>
        <profile name="Icon of Pestilence" id="14e6-a25f-b8e7-bae5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against the bearer&apos;s unit, if the Strength characteristic of that attack either equals or is at least double the Toughness characteristic of this unit, subtract 1 from that attack’s wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Icon of Change" id="1fba-307b-d010-8d96" hidden="false">
      <profiles>
        <profile name="Icon of Change" id="2928-6ca8-693a-2701" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, the first time a saving throw is failed for the bearer&apos;s unit, the Damage characteristic of that attack is changed to 0.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Icon of Enthralling" id="7e40-87a8-c27d-a966" hidden="false">
      <profiles>
        <profile name="Icon of Enthralling" id="302d-20d6-f0a4-70b9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ranged attacks against the unit&apos;s bearer from enemy units within 18&quot; of the ICON must substract 1 from the hit rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Bound Slaanesh" id="3d27-6eee-3d75-16b1" hidden="false">
      <profiles>
        <profile name="Delightful agonies" id="49de-0923-42c7-469f" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Delightful Agonies has a warp charge value of 6. If manifested, select one friendly &lt;LEGION&gt; SLAANESH unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time a model in that unit would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Bound Nurgle" id="4fa1-54b6-a6ec-5bec" hidden="false">
      <profiles>
        <profile name="Putrid Miasma" id="1354-8775-c11a-d5eb" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Putrid Miasma has a warp charge value of 6. If manifested, select one friendly &lt;LEGION&gt; NURGLE unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time an attack is made against that unit, subtract 1 from that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Bound Tzeentch" id="0f02-2e0b-5993-11df" hidden="false">
      <profiles>
        <profile name="Skeins of fate" id="6799-cba4-63e9-a58b" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">8&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Skeins of Fate has a warp charge value of 7. If manifested, select one friendly &lt;LEGION&gt; TZEENTCH unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, models in that unit have a 4+ invulnerable save.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Priest" id="b886-a159-0071-94ff" hidden="false">
      <profiles>
        <profile name="Demagogue [Aura]" id="520e-03b1-246e-ad7a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEGION&gt; CORE, &lt;LEGION&gt; DAEMONIC or CULTISTS unit is within 6&quot; of this model, models in that unit can use this model’s Leadership characteristic instead of their own.</characteristic>
          </characteristics>
        </profile>
        <profile name="Priest" id="d562-cf47-3ee3-2310" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit’s PRIEST model knows Dark Zealotry and one other prayer from the Prayers to the Dark Gods. 
In your Command phase, this unit’s PRIEST model can attempt to chant one prayer it knows that has not already been attempted by a friendly model this turn. Roll one D6: on a 3+, the prayer is heard and takes effect until the start of your next Command phase. Each time a prayer chanted by this unit’s PRIEST model is heard, measure distances and draw line of sight from that PRIEST model.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="1cd5-992c-a325-c766" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1cd5-992c-a325-c766" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Company Commander" id="b58d-3652-a08d-d7de" hidden="false">
      <constraints>
        <constraint id="b8e5-7b55-c0d5-3e2e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Rites of Battle" id="5cd2-e17c-a082-3ffe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>1fbe-9e90-ae47-4283</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEGION&gt; CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Daemon Engine" id="015e-1db1-953a-037b" hidden="false"/>
    <categoryEntry name="Warpsmith" id="1585-2a37-46fe-0baf" hidden="false">
      <profiles>
        <profile name="Master of Mechanisms" id="d73d-cbfb-347d-6cad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can repair one friendly &lt;LEGION&gt; DAEMON ENGINE or &lt;LEGION&gt; VEHICLE model within 3&quot; of it. That VEHICLE model regains up to D3 lost wounds. Each model can only be repaired once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Engine overseer [Aura]" id="de51-d2a3-0962-1528" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Possessed VEHICLES within 6&quot; are not obliged to charge, and pass automatically Unleash checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Posessed" id="d16b-0a7c-0494-a2a4" hidden="false">
      <profiles>
        <profile name="Posessed" id="a4a2-fbe1-bea4-30e3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>No HT</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army includes a POSESSED unit in the battlefield during one of your Command phases, check if it becomes Unleashed, by rolling a D6, becoming unleashed if the roll is lesser or equal to the current Battle Round.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>- Posessed units gains DAEMONIC trait. 
- Each time a Posessed VEHICLE kills an enemy miniature with a melee attack, can attack one time more, this attacks cannot generate more attacks.</comment>
              <conditionGroups>
                <conditionGroup type="or">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <conditions>
                    <condition childId="233f-1dfd-37f9-301f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Posessed unleashed" id="597a-e6dc-5ba0-b575" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- If a POSESSED unit without the CHARACTER Keyword becomes unleashed, in each Movement phase unless in engagement range of enemy units, it cannot Remain Stationary, it must Advance against the nearest visible enemy unit, and it can Advance and Charge in the same turn.
- Unleashed POSESSED units must charge if they can, and always against the nearest able enemy unit.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="233f-1dfd-37f9-301f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Posessed" id="a99a-491b-ed7e-8585" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>HT - Vehicle</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Posessed VEHICLE kills an enemy miniature with a melee attack, can attack one time more, this attacks cannot generate more attacks.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <comment>- Posessed units gains DAEMONIC trait. 
- Each time a Posessed VEHICLE kills an enemy miniature with a melee attack, can attack one time more, this attacks cannot generate more attacks.</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                  <conditions>
                    <condition childId="233f-1dfd-37f9-301f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Posessed" id="28f4-d0b8-b9fc-eb77" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>No HT - Vehicle</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- If your army includes a POSESSED unit in the battlefield during one of your Command phases, check if it becomes Unleashed, by rolling a D6, becoming unleashed if the roll is lesser or equal to the current Battle Round.
- Each time a Posessed VEHICLE kills an enemy miniature with a melee attack, can attack one time more, this attacks cannot generate more attacks.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>- Posessed units gains DAEMONIC trait. 
- Each time a Posessed VEHICLE kills an enemy miniature with a melee attack, can attack one time more, this attacks cannot generate more attacks.</comment>
              <conditionGroups>
                <conditionGroup type="or">
