<catalogue name="Chaos - Chaos Legions" id="239d-fbad-c62c-d354" authorContact="Centuria Astartes Discord" authorName="A. Heras" authorUrl="Centuria Astartes Discord" battleScribeVersion="2.03" gameSystemId="5b78-3a13-0882-b019" gameSystemRevision="4" library="false" revision="2" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <comment>General cost tool:
20pts=1pl
