      <profiles>
        <profile name="Enrage Machine Spirits" id="ac87-e1ee-6617-1027" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can enrage one friendly &lt;LEGION&gt; VEHICLE model within 3&quot;. If it does so, until the start of your next Command phase, each time that VEHICLE model makes a ranged attack, add 1 to that attack’s hit roll. Each model can only be enraged once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
