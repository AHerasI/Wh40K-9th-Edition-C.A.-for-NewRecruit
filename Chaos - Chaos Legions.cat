                    <profile name="Shamblerot [Contagion]" id="944b-e129-0e3b-e21e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit (excluding INORGANIC and VEHICLE units) is within Contagion Range of this unit, at the start of your opponent’s Movement phase, roll one D6, on a 4+, that enemy unit suffers 1 mortal wound; on a 6, that enemy unit suffers D3 mortal wounds.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DG - 2. Living plague" id="c442-5d0c-182e-c76e" collective="false" hidden="false" import="true" type="upgrade">
