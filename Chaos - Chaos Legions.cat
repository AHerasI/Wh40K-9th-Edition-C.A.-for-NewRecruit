    <selectionEntryGroup name="Prayers to the Dark Gods" id="3fdf-a753-0774-d5d8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="68e7-50d1-bd9a-e513" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
        <constraint id="4f4b-2405-7a18-7641" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="2"/>
      </constraints>
      <modifierGroups>
        <modifierGroup>
          <conditions>
            <condition childId="5484-1592-aaa9-07d5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="atLeast" value="1"/>
          </conditions>
          <modifiers>
            <modifier field="4f4b-2405-7a18-7641" type="set" value="3"/>
            <modifier field="68e7-50d1-bd9a-e513" type="set" value="3"/>
          </modifiers>
        </modifierGroup>
      </modifierGroups>
      <selectionEntries>
        <selectionEntry name="1 - Benediction of Darkness" id="9292-a79b-ebbb-4259" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="13f3-5c25-1f9e-efc3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Benediction of Darkness" id="91ab-9c04-7c47-fc46" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">If this prayer is heard, then while a friendly &lt;LEGION&gt; CORE, &lt;LEGION&gt; CHARACTER or CULTISTS unit is within 6&quot; of this PRIEST, each time a ranged attack is made against that unit, it is treated as having the benefits of Light Cover against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="2 - Litany of despair" id="e4f9-e914-d001-63bb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f754-2cf2-53d0-ccd6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Litany of despair" id="8705-0b03-f356-2d0f" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">If this prayer is heard, select one enemy unit within 12&quot; of this PRIEST and roll 3D6: if the result is greater than that units Leadership characteristic, select one of the following to take effect:
- That unit cannot perform actions (if that unit is currently performing an action, it immediately fails).
- That unit cannot fire Overwatch or Set to Defend, and is not eligible to fight in the Fight phase until after all eligible units from your army have done so.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="3 - Omen of potency" id="c4d8-aadd-caab-87df" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1bb7-9ffe-1400-4cb3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Omen of potency" id="f7d5-a8e9-d59e-edfb" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">- Add 3 to the Attacks characteristic of this PRIEST.
- Improve the Strength characteristic of melee attacks made by this PRIEST is equipped with by 2.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="4 - Warp-sight plea" id="9f59-d12d-ca45-5c0f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="53f0-0399-110d-3c44" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Warp-sight plea" id="d3dc-5f19-c771-df3e" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE, CULTISTS or &lt;LEGION&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a ranged attack, re-roll a hit roll of 1 and the target does not receive the benefits of cover against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="5 - Soultearer portent" id="cf53-6992-dcd5-3e52" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f451-d11e-3409-8640" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Soultearer portent" id="18c8-ad45-9113-809d" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE, CULTISTS or &lt;LEGION&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a melee attack, you can ignore modifiers to the hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6 - Illusory supplication" id="bcd8-098b-69a9-2069" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4d30-0846-f465-5863" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Illusory supplication" id="4289-6ef3-5764-0d7a" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
              <characteristics>
                <characteristic name="Effect" typeId="a552-7e17-559f-860e">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE or CULTISTS unit within 3&quot; of this PRIEST. Each time an attack is made against that unit:
- An unmodified hit roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.
- That attack’s hit roll cannot be re-rolled.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dark zealotry" id="24fe-0ae2-f8e8-4b21" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a5e1-0fd3-e613-acbc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d457-4c8d-2c2e-c3db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
