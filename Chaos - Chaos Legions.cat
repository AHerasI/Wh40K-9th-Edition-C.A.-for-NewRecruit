              <profiles>
                <profile name="Capering imps" id="6831-0cb6-f190-f3c6" hidden="false" typeId="2411-9c72-f5d9-7342" typeName="Infernal Pacts">
                  <characteristics>
                    <characteristic name="Effect" typeId="a0e1-289d-a4e8-38b2">If this pact is successful, select one enemy unit within 24&quot; of and visible to this INFERNAL MASTER. Until the start of your next Command phase, that unit cannot receive the benefits of cover, cannot fire Overwatch and cannot Set to Defend.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="4 - Diabolic savant" id="4496-874d-eaf5-0286" collective="false" hidden="false" import="true" type="upgrade">
