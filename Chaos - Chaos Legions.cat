                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to a model with this trait, the Wound roll cannot be re-rolled.</characteristic>
                          </characteristics>
