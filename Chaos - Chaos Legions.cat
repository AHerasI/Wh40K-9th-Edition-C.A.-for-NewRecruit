                      </costs>
                      <profiles>
                        <profile name="Prescience" id="5065-1759-3349-6970" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this trait makes an attack, you can ignore any or all Hit roll modifiers.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="A moment&apos;s peace" id="5505-884b-4c4a-65ba" collective="false" hidden="false" import="true" type="upgrade">
