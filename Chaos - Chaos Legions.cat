    <categoryEntry name="Legion: Night Lords" id="2943-f32a-1dbb-925b" hidden="false">
      <infoLinks>
        <infoLink name="Strength from Dread" id="8986-f038-9411-1c01" hidden="false" targetId="26ce-6f2d-0e1d-7228" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Terror Tactics [Aura]" id="0881-e66f-d4ee-aba2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 9&quot; of this unit, subtract 2 from the Leadership characteristic of models in that unit and subtract 1 from Combat Attrition tests taken for that unit.
While an enemy unit is within 3&quot; of this unit, it loses the Objective Secured ability and any similar abilities that allow them to control an objective marker regardless of the number of enemy models&apos;s wounds within range of that objective marker.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Legion: Black Legion" id="8355-3e5f-b2a3-d2ea" hidden="false">
