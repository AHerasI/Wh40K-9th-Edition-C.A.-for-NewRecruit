              </costs>
              <profiles>
                <profile name="Diabolic savant" id="6778-fe0b-ead9-48e7" hidden="false" typeId="2411-9c72-f5d9-7342" typeName="Infernal Pacts">
                  <characteristics>
                    <characteristic name="Effect" typeId="a0e1-289d-a4e8-38b2">If this pact is successful:
- At the start of your next Psychic phase, if your army is a Cabal of Sorcerers, you generate 1 additional Cabal point.
- In your next Psychic phase, you can re-roll Psychic tests taken for this INFERNAL MASTER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
