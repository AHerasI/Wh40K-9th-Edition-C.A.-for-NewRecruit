                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this WARLORD, halve the Damage characteristic of that attack (rounding down).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TS - 4. Lord of Forbidden Lore" id="e6f0-d3b7-9b0e-e262" collective="false" hidden="false" import="true" type="upgrade">
