                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- You can re-roll Psychic and Deny the Witch tests taken for this WARLORD.
- This WARLORD generates 1D3 additional Cabal points.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TS - 2. Seeker after shadows" id="0348-305e-dbee-c2ae" collective="false" hidden="false" import="true" type="upgrade">
