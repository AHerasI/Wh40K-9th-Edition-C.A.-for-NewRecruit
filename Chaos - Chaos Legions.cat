    <categoryEntry name="Sorcerer" id="4d8a-0c7b-8b4f-9420" hidden="false"/>
    <categoryEntry name="Titanic Daemon Engine" id="c373-da2f-8f9c-ca8b" hidden="false">
      <infoLinks>
        <infoLink name="Explodes 6+ (D6+6&quot; / D6)" id="fe33-475a-695b-027b" hidden="false" targetId="bd0f-186b-3ccc-e655" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Titanic Daemon Engine" id="c0e2-668d-45db-50dc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to declare a charge in a turn in which it Fell Back. 
Each time this model makes a Normal Move, Advances or Falls Back, it can be moved across other models (excluding MONSTER and VEHICLE models) as if they were not there, and when it does so it can be moved within Engagement Range of such models, but cannot finish its move within Engagement Range of any of them.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Special Ammunition" id="ed5a-14d7-45f8-afb3" hidden="false">
      <profiles>
        <profile name="Ammo - Daemonic Bolts" id="9e01-c630-d1a1-96e1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Damage characteristic of that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="5a9a-c8d5-2570-8459" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="11a0-1562-512f-d63b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Whistling Bolts" id="2ed6-8f5e-f51c-be25" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a wound is scored, the target unit reduce their leadership by 2 until the end of the next Morale phase. (Not cumulative with itself or Screaming Bolts)</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="5b82-0ba7-db61-82db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                    <condition childId="129c-c5d6-88c1-8218" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Warpflame Bolts" id="b555-7ec7-1d00-af18" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Improve the Armour Penetration characteristic of that attack to -3.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Dragonfire Bolts" id="da73-876a-4dbb-6a75" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The target does not receive the benefits of cover against that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="e87f-c8ff-111b-3226" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="51da-3457-1b10-cb14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Plague bolts" id="4e67-e79f-1a25-1d4d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When using this ammunition the weapon is considered a Plague weapon.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="33b3-f2a3-9749-2f10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="2226-f82a-fe58-178d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Shrapnel Light Bolts" id="884f-bb34-5b73-836b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Do D3 attacks for each attack the weapon has. Reduce the Armour Penetration characteristic of that attack to 0.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Ammo - Warp-infused Bolts" id="838f-f8ad-79dc-7d1f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">On a unmodified Wound roll of 6, invulnerable saving throws cannot be made against that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="4097-5f68-1097-1f16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
      <rules>
        <rule name="Special Ammunition" id="7d35-5cd8-f6b2-8b38" hidden="false">
          <description>Units with weapons with this ability can select their ammo before shooting with weapons with compatible special ammo ability. 
By default, standard ammo will be shot (no changes to the weapon&apos;s profile).</description>
        </rule>
      </rules>
    </categoryEntry>
