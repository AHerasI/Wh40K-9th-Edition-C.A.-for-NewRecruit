                <profile name="Tainted Narthecium [Aura]" id="503b-b486-5f2a-0718" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;DEATH GUARD&gt; INFANTRY unit is within 3&quot; of this model, each time a model in that unit uses the Mark of Nurgle ability, add 1 to the result of each roll.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Revitalising Malignancy" id="314e-0534-64ba-2c2c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can heal one friendly &lt;DEATH GUARD&gt; INFANTRY model whose unit is within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be healed once per turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
