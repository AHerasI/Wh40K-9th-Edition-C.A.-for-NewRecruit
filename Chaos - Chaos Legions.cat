                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy PSYKER unit is within 6&quot; of this model, subtract 1 from Psychic tests taken for that unit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Toxin of Misery [Aura]" id="b076-ca2a-85a9-7198" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
