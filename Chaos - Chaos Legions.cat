              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1204-bc68-2c54-a9c8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="3CP Rain Fire and Death" id="93f0-c1a5-4639-8d74" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, if a RED CORSAIRS CHARACTER unit from your army is on the battlefield. Select one point on the battlefield and place a marker on that point. On your next Shooting phase you can resolve a Tactical Weapon attack with the following profile:</characteristic>
                  </characteristics>
                </profile>
                <profile name="3CP Rain Fire and Death" id="c7fa-48f2-3f88-3af4" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (6&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D3</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">14</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-4</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D6</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical Weapon.
This weapon can only be fired once per battle. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords, that attack automatically hits the target.
When targeting units with 10 or more models, change this weapon&apos;s Type to Heavy D6.
Blast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Infernal Fusillade" id="c7bc-6199-cf46-bd18" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Thousand Sons</comment>
              <constraints>
                <constraint id="3e1c-e149-7027-880e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Infernal Fusillade" id="52f2-cf33-7bbb-6e88" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when an THOUSAND SONS INFANTRY unit from your army is selected to shoot. Until the end of the phase, each time a model in that unit shoots a bolt weapon, make one additional attack with that weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3CP Blight Bombardment" id="905b-dd3a-f27e-17f9" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Death Guard</comment>
              <categoryLinks>
                <categoryLink name="Tactical Weapon" id="1383-a3b8-218c-e129" hidden="false" primary="false" targetId="9369-4930-4f3e-67a4"/>
                <categoryLink name="Blast" id="39ce-2850-7681-4cef" hidden="false" primary="false" targetId="a30d-0055-6710-6284"/>
              </categoryLinks>
              <constraints>
                <constraint id="167d-9a14-02c6-d950" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="33b3-f2a3-9749-2f10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="3CP Blight Bombardment" id="fcbf-c16f-c0fd-2d9b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, if a DEATH GUARD CHARACTER unit from your army is on the battlefield. Select one point on the battlefield and place a marker on that point. On your next Shooting phase you can resolve a Tactical Weapon attack with the following profile:</characteristic>
                  </characteristics>
                </profile>
                <profile name="3CP Blight Bombardment" id="97f6-c76c-97fe-1c2f" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (6&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D6</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-2</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical Weapon.
This weapon can only be fired once per battle. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords, that attack automatically hits the target.
Each time an attack is made with this weapon against units without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified wound roll of 2+ is always successful.
When targeting units with 10 or more models, change this weapon&apos;s Type to Heavy 2D6.
Blast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="6 - Charge phase" id="a86d-bd2c-bf18-6576" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="2CP Tip of the Spear" id="f79f-ed1a-968a-1a48" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Black Legion</comment>
              <constraints>
                <constraint id="3e00-0aa2-8787-6f06" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="0d4e-60ff-af57-376e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2CP Tip of the Spear" id="05ca-fca2-55eb-05ca" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Charge phase, if no BLACK LEGION units from your army are within Engagement Range of any enemy units. Select the BLACK LEGION CORE, BLACK LEGION POSSESSED or BLACK LEGION CHARACTER unit from your army. Until the end of the turn:
- You can re-roll charge rolls made for that unit.
- Each time a model in that unit makes a melee attack against an enemy unit that is either in range of an objective marker or within your opponent’s deployment zone, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Underhand Scheming" id="c64b-7c76-e677-6f90" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Night Lords</comment>
              <constraints>
                <constraint id="7c45-e198-7693-c3e0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="fb68-626e-f339-d4a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Underhand Scheming" id="780e-9d85-f1f4-5d97" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Charge phase. Select one NIGHT LORDS unit from your army. Until the end of the phase, that unit is eligible to declare a charge in a turn in which it Fell Back.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
