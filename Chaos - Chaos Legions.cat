    <categoryEntry name="Special Heavy Ammunition" id="7495-cee2-d28a-75af" hidden="false">
      <profiles>
        <profile name="Heavy Ammo - Daemonic Bolts" id="9753-160b-0640-afb5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Strength and Damage characteristics of that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="5a9a-c8d5-2570-8459" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="11a0-1562-512f-d63b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heavy Ammo - Screaming Bolts" id="4933-9096-6d95-8790" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a wound is scored, the target unit reduce their leadership by 3 until the end of the next Morale phase. (Not cumulative with itself or Whistling Bolts)</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="5b82-0ba7-db61-82db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                    <condition childId="129c-c5d6-88c1-8218" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heavy Ammo - Warpflame Heavy Bolts" id="94b3-3526-76f5-ade4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Improve the Armour Penetration characteristic of that attack to -3.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heavy Ammo - Diseased Heavy Bolts" id="cc66-935c-c1db-6293" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to that attack’s wound roll against a unit that does not have the INORGANIC, VEHICLE or TITANIC keywords. When using this ammunition the weapon is considered a Plage Weapon.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="33b3-f2a3-9749-2f10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="2226-f82a-fe58-178d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heavy Ammo - Shrapnel Bolts" id="1f6a-a831-a005-7f6a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Do D3 attacks for each attack the weapon has. Reduce the Armour Penetration characteristic of that attack to 0.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heavy Ammo - Fatetwister Bolts" id="3b2f-44c8-975d-89ad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">On a unmodified Wound roll of 6, invulnerable saving throws cannot be made against that attack. In addition, the excess damage of that attack it inflicts is not lost. Instead, keep allocating excess damage to another model in the target unit until either all the excess damage has been allocated or the target unit is destroyed.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="aa78-8665-986f-cd89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="4097-5f68-1097-1f16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
      <rules>
        <rule name="Special Heavy Ammunition" id="7a10-a503-eade-371a" hidden="false">
          <description>Units with weapons with this ability can select their ammo before shooting with weapons with compatible heavy special ammo ability. 
By default, standard ammo will be shot (no changes to the weapon&apos;s profile).</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Heretek Tech Priest" id="fbad-c57e-fbf4-017e" hidden="false">
      <profiles>
        <profile name="Master of Technology" id="60af-b176-0a4f-f6ad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can repair one friendly &lt;LEGION&gt; model or a friendly VEHICLE model within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be repaired once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
  </categoryEntries>
