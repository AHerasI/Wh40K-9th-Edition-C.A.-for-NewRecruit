                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry name="WB - 1. The voice of Lorgar" id="8635-eb19-fd83-fa98" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="630e-0485-847c-698a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
