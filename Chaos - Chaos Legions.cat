                      <conditions>
                        <condition childId="2c5f-769b-663f-092b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Shoot and Fade" id="f1fc-54b2-2a4a-909d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, in your shooting phase, after shooting with a &lt;LEGION&gt; INFANTRY unit within 6&quot; of this WARLORD, that unit can make a Normal Move. 
If it does, that unit is not eligible to delcare a charge with this turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="World Eaters" id="ec15-593e-8bc2-cb84" collective="false" hidden="true" import="true">
