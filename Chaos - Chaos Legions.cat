                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD fights, if it made a charge move or performed a Heroic Intervention this turn, until that fight is resolved, add 1 to the Strength and Attacks characteristics of this WARLORD.
- Each time this WARLORD makes a melee attack, you can re-roll that attack’s hit roll</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="4: Lord of Terror" id="9c38-8749-5713-9bc2" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6a3e-099c-c5d4-5e3e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
