            <selectionEntry name="I - Dark Angels Secessionist - Fallen" id="da52-2f5e-e9c2-cd62" collective="false" hidden="true" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
