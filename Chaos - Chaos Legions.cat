                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Substract 1 from Wound rolls of strength 7 or less against this warlord.
- Once per battle, before making a saving throw for this WARLORD, you can select that, until the end of the turn, this WARLORD has a 3+ invulnerable save.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TS - 6. Aetherstride" id="82a6-03a0-af2d-88ca" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="2014-d14f-e068-eb34" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
