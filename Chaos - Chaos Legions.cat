              <profiles>
                <profile name="Perfidious tome" id="9495-d1f2-2786-1f2b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In each of your Command phases, if the bearer is on the battlefield, it can read from the Perfidious Tome. If it does, roll one D6: on a 1, your opponent gains 1 Command point; on a 4+, you gain 1 Command point.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sorthis&apos; mirror" id="5a73-6c5c-d151-74c9" collective="false" hidden="true" import="true" type="upgrade">
              <constraints>
                <constraint id="ff69-3cb6-fc45-c7e7" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
