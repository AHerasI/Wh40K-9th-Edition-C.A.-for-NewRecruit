              <profiles>
                <profile name="Unholy Fortitude" id="0c53-8dd1-1d6c-fdb0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3: Hatred incarnate" id="42d3-3c7a-f5e4-9e32" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3101-df97-0167-dd2d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
