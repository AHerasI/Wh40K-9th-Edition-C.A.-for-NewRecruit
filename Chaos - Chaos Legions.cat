                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Your WARLORD knows two additional psychic power.
- Your WARLORD can cast one additional psychic power in the Psychic phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TS - 5. Otherworldly prescience" id="71b6-7493-8362-c984" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="f47c-7b93-5a53-af90" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
