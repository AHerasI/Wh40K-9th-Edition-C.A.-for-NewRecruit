        <profile name="Sacrificial Dagger" id="225b-3f5c-127f-f34b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model attempts to manifest a psychic power from the Malefic discipline, if it is within 3&quot; of any friendly &lt;LEGION&gt; INFANTRY units, you can select one of those units and make a sacrifice: if you do so, the selected unit suffers D3 mortal wounds and you can add 2 to the psychic test taken for that psychic power.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Possession [Aura]" id="0312-df0f-02d2-e676" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 12&quot; of this model, each time that unit suffers Perils of the Warp, it suffers 1 additional mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Possession" id="a2f5-3434-8d3e-5245" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">2</characteristic>
            <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">1</characteristic>
            <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite, 2 Malefic Powers</characteristic>
            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="21d4-cb9f-44f3-e5a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="0196-5879-b96b-85dd" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Daemon subjugator" id="5fbf-004d-3961-ade4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In each Command phase, for every Possessed unit within 12&quot; of this model, add 2 to their Unleash check result.</characteristic>
          </characteristics>
        </profile>
