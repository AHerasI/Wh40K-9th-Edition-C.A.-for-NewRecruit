      <profiles>
        <profile name="Mastodon" id="d568-be28-aeae-596b" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 40 &lt;LEGION&gt; INFANTRY models. 
Each JUMP PACK or TERMINATOR model takes the space of two other models and each POSSESSED model takes the space of three other models.
It can transport up to 2 DREADNOUGHT models with a Wounds characteristic of up to 9, which each take up the space of 10 models.</characteristic>
          </characteristics>
        </profile>
