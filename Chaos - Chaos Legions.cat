                    <profile name="Ferric Blight [Contagion]" id="fe13-d468-f03a-1e80" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within Contagion Range of this unit, each time an attack is made by a friendly INEXORABLE model against that enemy unit, substract 1 from any Armor saving throws made by that enemy unit.</characteristic>
                      </characteristics>
                    </profile>
