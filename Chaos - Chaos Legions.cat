        <profile name="Psy-leash device" id="1601-785d-7d21-fdba" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During your Command phase, you can select a friendly CHAOS unit within 6&quot; of this model without DAEMON ENGINE or VEHICLE Keywords. Until your next Command phase, add 2 to the Attacks characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fieldwork" id="45bd-3ebe-dc86-dfa3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can heal one friendly INFANTRY or BEAST model without INORGANIC Keyword within 3&quot; of it. That model regains up to 3 Wounds.
If the selected unit is not at Starting Strength, but all it&apos;s remaining models have all it&apos;s wounds remaining, one of the selected unit&apos;s destroyed models is returned to its unit with its full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic Possession overseer [Aura]" id="a908-f698-4a3a-7e57" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Possessed units within 6&quot; are not obliged to charge, and pass automatically Unleash checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
