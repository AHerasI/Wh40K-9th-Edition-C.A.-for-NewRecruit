                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Diabolic Strength" id="6158-1206-9070-30f0" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Diabolic Strength has a warp charge value of 6. If manifested, select one friendly LEGION INFANTRY or CHAOS SPAWN model within 12&quot; of this PSYKER. Until the start of your next Psychic phase, add 2 to the Strength and Attacks characteristics of that model.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
