      </costs>
      <infoGroups>
        <infoGroup name="Angels of Death" id="d4ae-5c35-496d-ed68" hidden="false">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="2c5f-769b-663f-092b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="29bf-7f89-9955-87fc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="And They Shall Know No Fear" id="0153-98a5-377f-ee90" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Combat Attrition test is taken for an ADEPTUS ASTARTES unit, ignore any or all modifiers.</characteristic>
              </characteristics>
            </profile>
            <profile name="Bolter Discipline" id="bb56-c6db-986d-ef8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Instead of following the normal rules for Rapid Fire weapons, ADEPTUS ASTARTES models shooting Rapid Fire Bolt weapons make double the number of attacks if any of the following apply:
- The shooting model&apos;s target is within half the weapon&apos;s range
- The shooting model is Infantry and it&apos;s unit Remained Stationary in your previous Movement Phase.
- The shooting model is a Terminator or Biker

For the purposes of this ability, a Rapid Fire Bolt weapon is any Bolt weapon with the Rapid Fire type.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Chaotic Astartes" id="c833-7ac1-89ab-e37b" hidden="false">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="2c5f-769b-663f-092b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                    <condition childId="29bf-7f89-9955-87fc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Let the Galaxy burn" id="0a57-9d47-2ac5-0070" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with CHAOTIC ASTARTES Keyword shoots with a flame weapon, when determining how many attacks are made with that weapon this phase, add 2 to the result (e.g. a model shooting with a flamer makes D6+2 attacks).</characteristic>
              </characteristics>
            </profile>
            <profile name="Malicious Volleys" id="2e07-e9ce-4ed2-7b0e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Instead of following the normal rules for Rapid Fire weapons, CHAOTIC ASTARTES models shooting Rapid Fire Bolt weapons make double the number of attacks if any of the following apply:
- The shooting model&apos;s target is within half the weapon&apos;s range
- The shooting model is Infantry and it&apos;s unit Remained Stationary in your previous Movement Phase.
- The shooting model is a Terminator or Biker

For the purposes of this ability, a Rapid Fire Bolt weapon is any Bolt weapon with the Rapid Fire type.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <selectionEntryGroups>
        <selectionEntryGroup name="Marked Legions" id="0e0d-4d6a-6dac-d969" collective="false" hidden="true" import="true">
          <constraints>
            <constraint id="84da-838f-4c08-1cdc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8188-c455-4b27-a25c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="554e-9095-3389-50fd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="III - Emperor&apos;s Children" id="129c-c5d6-88c1-8218" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Flawless perfection" id="eb02-8a17-fd0c-8251" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a model with this trait makes an attack, you can ignore any or all hit roll, Weapon Skill and Ballistic Skill modifiers.
- Each time a model with this trait makes an advance or charge roll, add 2&quot; to the result.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Temptations of Slaanesh" id="80cf-c283-b0d8-76db" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each battle round, after determining who will take the first turn, you gain a pool of 6 dice. These are your Temptation Dice. 
Each time your opponent makes a failed hit roll, wound roll or save roll, you can offer them a Temptation Dice. if they accept your offer, that roll is replaced by a 6. Those replaced rolls cannot be re-rolled or modified.
Each time your opponent accepts your offer of a Temptation Dice, you gain 1D6 Depravity Points.
You cannot offer a Temptation Dice for the same enemy unit more than once per phase.
At the end of the Battle round, any unused Temptation Dice is lost.</characteristic>
                  </characteristics>
                </profile>
                <profile name="20+ Masochistics" id="c2bf-f127-5c35-2a6c" hidden="false" typeId="abe8-8ee5-99a7-d34c" typeName="Depravity Points">
                  <characteristics>
                    <characteristic name="All EMPEROR&apos;S CHILDREN units gain the following abilities when the stated Depravity Points quantity is reached." typeId="52af-138c-6b8e-a9ea">Each time a EMPEROR&apos;S CHILDREN model loses a wound, roll a D6, on a 6+ the wound is not lost.</characteristic>
                  </characteristics>
                </profile>
                <profile name="40+ Peerless counterstrike" id="a5a4-b10b-964d-f5b6" hidden="false" typeId="abe8-8ee5-99a7-d34c" typeName="Depravity Points">
                  <characteristics>
                    <characteristic name="All EMPEROR&apos;S CHILDREN units gain the following abilities when the stated Depravity Points quantity is reached." typeId="52af-138c-6b8e-a9ea">For each unmodified wound roll of 1 made by a melee attack against a EMPEROR&apos;S CHILDREN unit, the unit making that attack suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
                <profile name="60+ Shrieks of agony" id="8e6d-d0a1-93e0-da13" hidden="false" typeId="abe8-8ee5-99a7-d34c" typeName="Depravity Points">
                  <characteristics>
                    <characteristic name="All EMPEROR&apos;S CHILDREN units gain the following abilities when the stated Depravity Points quantity is reached." typeId="52af-138c-6b8e-a9ea">Enemy units within 3&quot; of a EMPEROR&apos;S CHILDREN unit reduces their Leadership characteristic by 2 and substract 1 each roll of Combat atrittion check.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="XII - World Eaters" id="5a9a-c8d5-2570-8459" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name=" The Butchert&apos;s nails" id="d427-6308-301c-9c38" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a unit with this trait fights, if it made a charge move, was charged or performed a Heroic Intervention this turn, then until that fight is resolved, add 1 to the Attacks characteristic of models in this unit.
- Each time a unit with this trait piles-in or consolidates, it can move 5&quot; instead of 3&quot;.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Wrathful devotion" id="12a9-19d0-0f6b-45d4" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">4</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, each time a WORLD EATERS model from your army would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
                <profile name="The Blood Tithe" id="d9c1-dd62-7bae-af53" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If every unit from your detachment has the WORLD EATERS keyword (excluding models with the AGENT OF CHAOS, SERVANTS OF CHAOS or UNALIGNED keyword), you can gain Blood Tithe points (BTP) over the course of the battle, as described below. Keep a note of your Blood Tithe points total.
- Each time a INFANTRY, BIKER, BEAST or SWARM unit without the INORGANIC Keyword is destroyed, you gain 1 BTP.
- Each time a CAVALRY or MONSTER unit without the INORGANIC Keyword is destroyed, you gain 2 BTP.
- Each time a CHARACTER unit or a MONSTER unit with a Wounds characteristic of 10+ were destroyed, you gain 1 additional BTP.
At the end of each phase, after gaining any Blood Tithe points, you can spend them to obtain a Blessing of the Blood God, but you can only purchase one per phase.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Rage-fuelled invigoration" id="7505-4712-95e7-a4f8" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">3</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, add 1 to charge rolls made for WORLD EATERS units from your army.
This Blessing is cumulative with other abilities and itself, and can be adquired multiple times, it&apos;s BTP cost increments by one each time it&apos;s selected.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Spiteful nullification" id="5a21-64d2-9721-4ab2" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">2</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, each time a WORLD EATERS model from your army would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Martial excellence" id="c226-be3e-6a58-fc33" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">5</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, each time a WORLD EATERS model from your army makes a melee attack, an unmodified hit roll of 6 scores one additional hit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Savage guidance" id="3051-78da-7e81-9000" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">5</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, each time a melee attack is made by a WORLD EATERS model from your army, add 1 to that attack’s hit roll.
This Blessing is cumulative with other abilities and itself, and can be adquired multiple times, it&apos;s BTP cost increments by one each time it&apos;s selected.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Total carnage" id="af08-8525-28bc-697c" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">6</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Until the end of the battle, each time a melee attack is made by a WORLD EATERS model from your army, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Reborn in blood" id="b91f-e6bb-47fe-aea3" hidden="false" typeId="39df-2bc2-4875-694e" typeName="Blood Tithe">
                  <characteristics>
                    <characteristic name="BTP" typeId="a470-5b60-f910-bf38">8</characteristic>
                    <characteristic name="Effect" typeId="509b-c801-4421-adb1">Place a destroyed ANGRON model from your army into reserves with 8 wounds remaining. That model is no longer considered to be destroyed, and can be set up again in your Reinforcements step as if it had the Warp Strike ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="XIV - Death Guard" id="33b3-f2a3-9749-2f10" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Contagion range" id="2e50-aac2-44a5-9d81" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Contagion abilities affect enemy models or units within Contagion Range - this changes with the battle round number, increasing as the battle progresses.

Battle Round 1 ---&gt; 1&quot;
Battle Round 2 ---&gt; 3&quot;
Battle Round 3 ---&gt; 6&quot;
Battle Round 4+ -&gt; 9&quot;

Contagion abilities are not affected by abilities that affect Aura abilities, and vice-versa.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntryGroups>
                <selectionEntryGroup name="Warband" id="d558-7a58-49e2-5468" collective="false" defaultSelectionEntryId="8262-9967-e6a3-683f" hidden="false" import="true">
