            <selectionEntry name="Warband - Red Corsairs" id="1204-bc68-2c54-a9c8" collective="false" hidden="false" import="true" type="upgrade">
              <comment>Astral Claws</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Raiders from the Maelstrom" id="0297-1e88-fa95-3206" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Units with this trait are eligible to declare a charge in a turn in which they Advanced.
- Models with this trait count as having an additional wound when determining control of an objective marker, and CORE units gain Objective Secured trait.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warband - Disciples of Bela&apos;kor" id="994d-5586-d60e-c51a" collective="false" hidden="false" import="true" type="upgrade">
              <comment>Special Chaos Mark</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Disciples of Shadows" id="fe26-a9eb-073c-3e98" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against a unit with this trait, if the attacker is more than 12&quot; away, subtract 1 from that attack’s hit roll, and the hit roll cannot be re-rolled.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warband - Creations of Bile" id="d64e-76c2-6608-1e7e" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Experimental Enhancements" id="5747-2b01-257d-0183" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this trait is destroyed by a melee attack, if that model has not fought this phase, do not remove it from play. The destroyed model can fight after the attacking model’s unit has finished making attacks, and is then removed from play. When making these attacks, if any of the destroyed model’s characteristics change as it suffers damage, for the purposes of determining what characteristics on its profile to use, the destroyed model is considered to have 1 wound remaining.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warband - The Confessed" id="01cf-a195-a28c-c556" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Primaris units</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Psychic prowess" id="b2bd-d0ef-b9ae-5be7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Re-roll failed Psychic tests taken for units with this Legion trait.
- All units with this Legion trait gains the PSYKER keyword, and gain access to the Smite psychic power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
