                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Fires of the abyss" id="b80e-4c0d-8e41-3ee4" hidden="false" typeId="2411-9c72-f5d9-7342" typeName="Infernal Pacts">
                  <characteristics>
                    <characteristic name="Effect" typeId="a0e1-289d-a4e8-38b2">If this pact is successful, the closest enemy unit within 15&quot; of and visible to this INFERNAL MASTER suffers D3 mortal wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3 - Capering imps" id="9d64-8f6e-2a63-a97f" collective="false" hidden="false" import="true" type="upgrade">
