                          </conditionGroups>
                          <conditions>
                            <condition childId="62d9-3cd6-aed7-34fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Exalted possession" id="7fa8-bf21-79c4-f462" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This WARLORD gains the DAEMONIC keyword (if it doesn’t already have them).
- This WARLORD add 1 to invulnerable save against ranged attacks.
- Add 1 to the Strength, Attacks and Wounds characteristics of this WARLORD.
- Add 2&quot; to the Move characteristic of this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="WB - 3. Daemonic whispers" id="36e1-02d7-b56f-2187" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="ebfb-fded-4752-ec5a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Daemonic whispers" id="10e5-d13f-359d-3280" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD chants a prayer that is heard, completes an action or psychic action, or manifests a psychic power, roll one D6: if the result is greater than the current battle round number, you gain 1 Command point.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="WB - 4. Master of the union" id="ea47-0ec1-e393-3c69" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="7bfa-f12f-934b-d142" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Master of the union" id="e0fc-28b6-47f1-46ad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly WORD BEARERS DAEMONIC unit within 6&quot; of this WARLORD. Until the start of your next Command phase:
- Add 1 to the Strength characteristic of models in that unit.
- Each time a model in that unit makes a melee attack, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="WB - 5. Diabolist" id="7c71-3589-666f-f9da" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="4008-f5e9-0ea7-c951" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Diabolist" id="f6f4-2b6d-8f62-b340" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an attack is made against this WARLORD, your opponent cannot re-roll the wound roll.
- Each time this WARLORD would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="WB - 6. Hate-fuelled demagoge" id="939d-453c-1159-f552" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0b62-472b-29ae-9f4c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Hate-fuelled demagoge" id="d13f-bb75-eaa4-db40" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly WORD BEARERS or CULTISTS unit within 6&quot; of this WARLORD. Until the start of your next Command phase:
- If that unit is a CULTISTS unit, it gains the Let the Galaxy Burn ability, and models in that unit are considered to have the HERETIC ASTARTES keyword for the purposes of that ability.
- If that unit already had the HERETIC ASTARTES Keyword, each time a model in that unit makes a ranged attack, that attack is considered to be affected by the Wanton acts rule, irrespective if the target is within 12&quot; of the attacking model.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Night Lords" id="6650-e2dd-79df-efac" collective="false" hidden="true" import="true">
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="fb68-626e-f339-d4a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry name="NL - 1. Night haunter&apos;s curse" id="0bd9-78e0-3fb7-93da" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="64e9-6708-4078-af47" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Night haunter&apos;s curse" id="afe8-d084-1e56-18b8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, you can change the result of a single Advance roll, hit roll, wound roll or saving throw made for this WARLORD to be a 6. This counts as an unmodified 6 for all rules purposes.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="NL - 2. One piece at a time" id="d7fc-6e45-88c4-87ce" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="822a-10ea-c045-6a43" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="One piece at a time" id="361f-47f0-e969-4e5a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD is selected to fight, after it has finished making its attacks, if any enemy models were destroyed by those attacks but their unit was not destroyed, select one of those enemy units. Until the end of the next Morale phase, subtract 1 from Combat Attrition tests taken for that enemy unit.
- Each time this WARLORD makes a consolidation move, models in its unit can move in any direction, and can do so even if they are already touching an enemy model, provided each model finishes its move within 3&quot; of an enemy unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="NL - 3. Murderous reputation" id="9d11-ee58-7c0b-6366" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="f7a8-f409-38e1-653a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Murderous reputation [Aura]" id="fb25-0e43-b2df-7a92" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit with the Objective Secured ability is within 6&quot; of this WARLORD, it loses that ability.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="NL - 4. Killing Fury" id="6f7e-e63c-a0a5-6a62" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="c872-1d58-80b0-3ec1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Killing Fury" id="2930-dcc4-d1c9-a062" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD is selected to fight, if it made a charge move, was charged or performed a Heroic Intervention this turn, until that fight is resolved, add D3 to the Attacks characteristic of this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="NL - 5. One with the shadows" id="f0d2-d7f3-5869-773c" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a4b6-1bcc-a757-8667" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="One with the shadows" id="f019-52a1-f318-45c5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this WARLORD:
- Your opponent cannot re-roll the hit roll.
- Subtract 1 from that attack’s hit roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="NL - 6. Battle-lust" id="4c98-b3a9-9549-0990" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="eb8e-8920-cd67-84a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Battle-lust" id="39aa-0946-080f-7adf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, you can select one enemy unit within 3&quot; of this WARLORD. That unit is not eligible to fight this phase until after all eligible units from your army have done so.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Iron Warriors" id="4317-d9e2-cfb7-020a" collective="false" hidden="true" import="true">
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="e87f-c8ff-111b-3226" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
