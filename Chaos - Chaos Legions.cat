            <profile name="  Wrathful presence" id="ede9-1dc4-4b93-0545" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one of the following abilities. This model has that ability until the start of your next Command phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="2. Infectious rage" id="8cd3-384f-db9a-37b9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly LEGION: WORLD EATERS CORE unit is within 6&quot; of this model, add 1 to the attacks characteristic of models in that unit.</characteristic>
              </characteristics>
            </profile>
            <profile name="1. Glorious bloodletting" id="db87-cbfd-9a25-15fb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While another friendly LEGION: WORLD EATERS unit is within 6&quot; of this model, each time a model in that unit makes a melee attack, re-roll a hit roll of 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="3. Righterous slaughter" id="6a6e-6e59-dc3e-53c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a unit is within 6&quot; of this model, that unit cannot Fall Back.</characteristic>
              </characteristics>
            </profile>
