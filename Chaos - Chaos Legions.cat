                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Command phase, if this model is on the battlefield, roll 2D6: on a 7+, you gain 1 Command point.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
