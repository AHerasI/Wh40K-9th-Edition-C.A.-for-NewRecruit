                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Eternal vendetta" id="28b9-b3ff-f15d-24dc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, before the first turn begins, select one enemy unit. 
Until the end of the battle, while a friendly &lt;LEGION&gt; CORE or &lt;LEGION&gt; CHARACTER unit is within 9&quot; of this WARLORD, each time a model in that &lt;LEGION&gt; unit makes an attack against that enemy unit, you can re-roll that attack’s wound roll.
If the selected unit is destroyed, you can select another unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
