                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="3. Grand Strategist" id="ca50-c77a-3b4c-c696" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this WARLORD is on the battlefield, each time you spend a Command point to use a Stratagem, roll one D6: on a 5+, that Command point is refunded.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="4. Superior tactical training" id="d872-459e-3b92-fd8a" collective="false" hidden="false" import="true" type="upgrade">
