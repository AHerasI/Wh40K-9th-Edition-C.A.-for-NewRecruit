          <profiles>
            <profile name="Mobile Siege base" id="b7cd-3554-3c12-2c57" hidden="false" page="65" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beginning of your Command phase, embarked VEHICLE models from your army regains 3 lost wounds (a model can only be repaired once per turn).
In addition, at the beginning of your Command phase, embarked VEHICLE models are re-armed, and can use any &apos;one use only&apos; weapons and abilities it has on its datasheet that it has already used during the battle one additional time.</characteristic>
              </characteristics>
            </profile>
            <profile name="Mobile command center" id="73ff-3345-6073-7317" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units are considered to be in VOX RANGE of this OFFICER unit if are within 120&quot; of this unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
