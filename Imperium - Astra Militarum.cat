    <selectionEntryGroup name=" Character Definition" id="b8e4-216c-16cc-4263" collective="false" hidden="false" import="true">
      <entryLinks>
        <entryLink name=" Warlord" id="3cd6-2769-a0e0-8095" collective="false" hidden="false" import="true" targetId="15e7-ffe5-1f1b-384e" type="selectionEntry">
          <profiles>
            <profile name=" Field promotion" id="25da-c75d-eed4-01c7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the WARLORD is destroyed, select any ASTRA MILITARUM CHARACTER model which is on the Battlefield. 
Roll one D6 to set a random Warlord trait from the Astra Militarum Warlord Traits table.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </entryLink>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Warlord Traits" id="f08f-68c9-f4cb-cd93" collective="false" hidden="true" import="true">
          <constraints>
            <constraint id="635d-b8bd-f705-2e23" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="15e7-ffe5-1f1b-384e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntryGroups>
            <selectionEntryGroup name="Astra Militarum Warlord Traits" id="f71a-9674-1259-11a3" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="ecad-c9ad-0c2e-fd2a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="1. Fast responses" id="0682-56d7-18c5-b297" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="d84b-96f7-d326-d7ec" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="1. Fast responses" id="08af-d8a4-084c-7e7b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This WARLORD can issue an additional order it knows per Battle Round.
You can issue the same order twice per Battle Round.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="2. Tactical mind" id="c116-ab54-1a5d-c45c" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="bb36-90dc-c3cb-784a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="2. Tactical mind" id="da85-7bde-30aa-8f8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per Battle Round, when Enemy reinforcements are deployed within 24&quot; of this WARLORD, you can select one REGIMENT unit in VOX RANGE of this WARLORD. That unit can fire upon the reinforcing enemy unit as if it were Searching for Targets.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="3. Grand Strategist" id="e737-1a10-9871-89d1" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="7a01-152b-bb2a-9889" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
