                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Omen of potency" id="7119-5ce5-e2a1-bc35" hidden="false" typeId="01cd-d908-6359-231e" typeName="Dark Prayers">
                      <characteristics>
                        <characteristic name="Effect" typeId="a552-7e17-559f-860e">- Add 3 to the Attacks characteristic of this PRIEST.
- Improve the Strength characteristic of melee attacks made by this PRIEST is equipped with by 2.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="4 - Warp-sight plea" id="bb36-21ed-90d1-b18a" collective="false" hidden="false" import="true" type="upgrade">
