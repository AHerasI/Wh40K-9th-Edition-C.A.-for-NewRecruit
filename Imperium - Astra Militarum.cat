                  <conditions>
                    <condition childId="dc39-529a-6aa3-33eb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Vicious traps" id="f8bc-19b6-1430-9c8f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your opponent&apos;s Charge phase, when a friendly LIGHT INFANTRY REGIMENT INFANTRY unit is being targetted for a Charge.
Roll a D6. Your opponent must substract that roll from the Charge roll, or select a different target for a Charge.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Dear grid coordinates..." id="8bba-8b98-ccfc-e615" collective="false" hidden="true" import="true" type="upgrade">
              <comment>ARTILLERY</comment>
              <constraints>
                <constraint id="b597-e0c4-467e-148f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="5785-1869-d25b-dd4b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Dear grid coordinates..." id="a0bc-0a15-d504-7b4f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your opponent&apos;s Charge phase, when a friendly unit is being targetted for a Charge. Select one ARTILLERY REGIMENT VEHICLE model from your army. That model can fire Overwatch as if it were the target of that Charge. This Stratagem does not prevent firing Overwatch with the targeted unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
