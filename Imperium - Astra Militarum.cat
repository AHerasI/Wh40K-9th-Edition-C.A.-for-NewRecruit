        <profile name="Improved Warheads" id="6739-45d0-8c96-1e30" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each successful hit scored from an additional attack obtained by the Splash rule made by a REGIMENT VEHICLE model scores an additional hit.</characteristic>
