            <profile name="Rites of Restoration" id="8c80-fe95-7069-1000" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one friendly IMPERIUM INFANTRY unit that is not at its Starting Strength and is within 3&quot; of that HOSPITALLER unit. One of the selected friendly unit’s destroyed models is returned to its unit with it&apos;s full wounds remaining.</characteristic>
              </characteristics>
            </profile>
            <profile name="Medicus Ministorum [Aura]" id="0280-80da-fc1c-5ea0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly IMPERIUM INFANTRY unit is within 3&quot; of this model, each time a model in that unit would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
              </characteristics>
            </profile>
            <profile name="Sacred Healing" id="bf0e-9dbf-43a3-0f8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can heal one friendly IMPERIUM INFANTRY model whose unit is within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be healed once per turn.</characteristic>
              </characteristics>
            </profile>
