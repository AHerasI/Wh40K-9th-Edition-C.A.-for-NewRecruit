                  </costs>
                  <profiles>
                    <profile name="4. Superior tactical training" id="49df-3035-8952-5133" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When you select this Warlord Trait, select one type of Orders (ARMOUR, PLATOON, PREFECTUS or TACTICA) that this WARLORD does not know. This WARLORD knows those Orders in addition to any others it knows, and can issue 1 of that kind per Battle Round.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="5. Acceptable losses" id="6c40-0584-3964-934c" collective="false" hidden="false" import="true" type="upgrade">
