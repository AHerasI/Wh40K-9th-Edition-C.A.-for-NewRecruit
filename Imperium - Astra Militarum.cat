                <characteristic name="S" typeId="59b1-319e-ec13-d466">3</characteristic>
                <characteristic name="AP" typeId="75aa-a838-b675-6484">0</characteristic>
                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">In the Fight phase, if this unit made a charge move this turn, it can make 1 aditional attack with this weapon, and no more than 1 attack can be made with this weapon.
If this weapon targets a unit that has between 6 and 10 models, it always makes a minimum of 3 attacks. If this weapon targets a unit that has more than 10 models, it always makes 6 attacks.</characteristic>
              </characteristics>
            </profile>
