                              <characteristics>
                                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This WARLORD has a 4+ invulnerable save.
Re-roll Invulnerable saving throws of 1 for this WARLORD.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
