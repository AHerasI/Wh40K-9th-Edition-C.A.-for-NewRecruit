            <profile name="Telemetry corrections" id="e6ce-c26d-2997-6080" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your movement phase, select a REGIMENT VEHICLE within 12&quot; of this model. 
Each time an attack affected by INDIRECT FIRE rule is made by that model, add 1 to the hit roll. 
In addition, if a friendly unit is within VOX RANGE of Master of Ordinance&apos;s unit, and within 12&quot; and visual of the attacked unit, re-roll a hit rolls of 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="Telemetry corrections" id="4a05-0dfe-d66c-3403" hidden="true" typeId="5e51-6902-58a8-00f5" typeName="Order">
              <characteristics>
                <characteristic name="Type" typeId="acf4-29e1-933e-277c">SPECIALIST</characteristic>
                <characteristic name="Phase" typeId="d253-ed5c-1a09-ebd1">Command Phase, Shooting Phase</characteristic>
                <characteristic name="Eligible Units" typeId="54d6-e3f7-ad8c-d3a0">REGIMENT VEHICLE (9&quot;)</characteristic>
                <characteristic name="Effect" typeId="a435-9dd9-7056-398e">Each time an eligible unit makes a ranged attack with an INDIRECT FIRE weapon against an enemy unit</characteristic>
              </characteristics>
            </profile>
            <profile name="Telemetry corrections" id="23ea-13bd-f92b-c2c5" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack affected by INDIRECT FIRE rule made by friendly units within 6&quot; of this model add 1 to the hit roll, if a friendly unit within this model VOX RANGE is within 12&quot; and visual of the attacked unit.</characteristic>
              </characteristics>
            </profile>
