            <profile name="Summary Execution" id="0597-13be-4084-f049" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when a friendly ASTRA MILITARUM unit within 6&quot; of this model fails a Morale test, this model can use this ability. If it does so, until the end of the phase, each time a Combat Attrition test is taken for that unit, it is automatically passed.</characteristic>
