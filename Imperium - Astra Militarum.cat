                            <profile name="Hatred incarnate" id="ffda-6d59-b587-1e95" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                              <characteristics>
                                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD fights, if it made a charge move or performed a Heroic Intervention this turn, until that fight is resolved, add 1 to the Strength and Attacks characteristics of this WARLORD.
- Each time this WARLORD makes a melee attack, you can re-roll that attack’s hit roll</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="4: Lord of Terror" id="cb92-2ff4-3db7-a2a7" collective="false" hidden="false" import="true" type="upgrade">
                          <constraints>
                            <constraint id="85bd-5fe8-169c-b664" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                            <constraint id="0f04-cbcb-4311-2f09" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                          </constraints>
                          <costs>
                            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                            <cost name="Pts" typeId="points" value="0"/>
                            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                          </costs>
                          <profiles>
                            <profile name="Lord of Terror [Aura]" id="c3e8-98c3-8165-7901" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                              <characteristics>
                                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this WARLORD:
- Each time a Morale test is taken for that unit, your opponent must roll one additional D6 and discard the lowest result.
- If that unit fails a Morale test, until the end of the phase, it is considered to be below Half-strength for the purposes of Combat Attrition tests.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="5: Eternal vendetta" id="62c7-46a6-0d2a-99e1" collective="false" hidden="false" import="true" type="upgrade">
                          <constraints>
                            <constraint id="16c9-7972-628a-951f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                            <constraint id="39ff-c3ae-5508-70c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                          </constraints>
