    <categoryEntry name="Militarum Officer" id="4406-8f72-bc90-8949" hidden="false">
      <constraints>
        <constraint id="279d-e0e2-2163-5c0c" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="3"/>
      </constraints>
      <profiles>
        <profile name="Militarum Officer" id="4650-63f9-1a0c-8c3d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This OFFICER may issue up to ONE [1] TACTICA ORDERS.</characteristic>
          </characteristics>
          <modifiers>
