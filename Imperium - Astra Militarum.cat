                  <profiles>
                    <profile name=" Field promotion" id="b2c2-8207-744e-d802" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the WARLORD is destroyed, select any ASTRA MILITARUM CHARACTER model which is on the Battlefield. 
Roll one D6 to set a random Warlord trait from the Astra Militarum Warlord Traits table.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </entryLink>
                <entryLink name="Daemonic Summoning Ritual" id="f95e-d56a-77df-7ff9" hidden="false" import="true" targetId="ac45-5667-2dca-c6d8" type="selectionEntryGroup"/>
              </entryLinks>
