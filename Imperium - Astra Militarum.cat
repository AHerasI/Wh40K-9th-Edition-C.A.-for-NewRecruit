      <selectionEntryGroups>
        <selectionEntryGroup name=" Regiment Type" id="1a49-db06-ffa6-ece6" collective="false" defaultSelectionEntryId="521a-24b7-f8db-4c46" hidden="false" import="true">
          <constraints>
            <constraint id="2a32-f273-9e35-789f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d553-50e0-5bfd-bfcb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="  Light Infantry Regiment" id="dc39-529a-6aa3-33eb" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Skirmishers" id="9d47-0b0d-d8d6-6bdc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">REGIMENT INFANTRY is considered to be on DENSE COVER at 12&quot; or more and on LIGHT COVER at 18&quot; or more.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Lascarabines" id="3eb2-73d9-7a3e-bb45" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">REGIMENT INFANTRY units replace their LASGUN with a LASCARABINE.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="  Munitorum Standard Regiment" id="521a-24b7-f8db-4c46" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Established strategies" id="e187-abb7-0878-b7cc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Command phase roll one D6, on a 4+, you gain 1 Command Point.</characteristic>
                  </characteristics>
                </profile>
