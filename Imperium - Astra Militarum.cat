                <profile name="1CP Ambush" id="d076-e3fc-8334-c592" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem before the battle, during the Declare Reserves and Transports step (if you are playing a mission without this step, use this Stratagem during deployment instead). Select up to three REGIMENT INFANTRY, RECON or/and CAVALRY units from your army. If you do so, then in the Reinforcements step of one of your Movement phases, you can set up that units wholly within 6&quot; of the battlefield edge and more than 9&quot; away from any enemy models. You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="2 - Command Phase" id="fdb2-fe81-6215-d69b" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Rushed repairs" id="7581-2a6b-3ef9-7dd3" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="59ee-2735-6191-3dcd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Rushed repairs" id="c161-f250-1485-b221" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your Command phase. Select one REGIMENT VEHICLE model from your army. Roll a D6, on a 1, that model regain 1 wound. On a 2-4, the model regain D3 wounds. On a 5-6 the model regain D3+1 wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Frontline resupply" id="269c-ef15-e745-de78" collective="false" hidden="true" import="true" type="upgrade">
              <comment>AIR ASSAULT</comment>
              <constraints>
                <constraint id="9ec4-3c6b-5f97-8dc6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="901d-9cf4-c32e-cdbf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2CP Frontline resupply" id="784d-8d0f-3f60-14f6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your Command phase. Select one NAVIS IMPERIALIS VEHICLE unit from your army that is not on the battlefield. That unit regains D3 wounds, and used weapons that can only be used once, can be used one time more.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="3 - Movement Phase" id="7607-2f46-988a-1bc8" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Cut them down" id="8e0a-b3b7-7630-72de" collective="false" hidden="false" import="true" targetId="4428-f83f-58af-3292" type="selectionEntry"/>
            <entryLink name="1CP Desperate breakout" id="229e-9f97-2618-382a" collective="false" hidden="false" import="true" targetId="e39e-d7b1-900f-0762" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Deploy Omni-Scramblers" id="f41d-4b0b-9066-da7d" collective="false" hidden="true" import="true" type="upgrade">
              <comment>COMMANDO</comment>
              <constraints>
                <constraint id="4c85-9b61-1f32-cf5f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="4399-7ac5-26a8-3c81" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Deploy Omni-Scramblers" id="1f4a-1474-5e71-851b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the end of your Movement phase. Select one COMMANDO REGIMENT INFANTRY unit from your army that is within 3&quot; of any Objective marker. Until the end of the battle, enemy reinforcements cannot be deployed within 12&quot; of that Objective marker. You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Nail them down" id="4e69-2a1d-0b40-9e85" collective="false" hidden="true" import="true" type="upgrade">
              <comment>SIEGE</comment>
              <constraints>
                <constraint id="d35a-6c95-1e8e-e96b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="fdfe-3c10-2004-aa2b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Nail them down" id="a1b1-e6eb-8ad5-b8c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your opponent&apos;s Movement phase, when a enemy SWARM, BEAST, INFANTRY or CAVALRY unit is selected to FALL BACK from one SIEGE REGIMENT unit. Roll a D6 for each SIEGE REGIMENT unit within engagement range, on a 3+ that unit must Remain Stationary. Add 1 to that roll if the the unit Strength characteristic is higher or equal than the enemy unit Strength characteristic.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Orbital interference" id="2567-cd87-459c-ece6" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Fleet Liaison</comment>
              <constraints>
                <constraint id="bdfa-9918-1c7a-1de2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="4cd6-b2a5-7ccc-be66" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Orbital interference" id="af38-e49c-aae6-4c17" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Reinforcements step of your opponent’s Movement phase, if an FLEET LIAISON model from your army is on the battlefield. If it is the first or the second battle round, you can select one of your opponent’s Strategic Reserve or Reinforcement units. That unit cannot arrive on the battlefield this phase for any reason, even if it has another rule that states it always arrives on the battlefield during a specific Battle round. You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="4 - Psychic phase" id="39d5-9a36-592b-9904" collective="false" hidden="false" import="true"/>
        <selectionEntryGroup name="5 - Shooting phase" id="68ff-1ce7-c7cb-8e94" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Unyielding advance" id="ba54-6a45-6c77-63ba" collective="false" hidden="true" import="true" type="upgrade">
              <comment>ARMOURED</comment>
              <constraints>
                <constraint id="12a2-3900-bb75-5fd7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="4b79-6320-95a3-63e1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Unyielding advance" id="d11e-5776-90b9-67f5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your Shooting phase, when a ARMOURED REGIMENT VEHICLE model is selected to shoot. That model can shoot twice it&apos;s Turret-mounted weapons against the same objective. This Stratagem is not cumulable with Grinding advance ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Overlapping fields of fire" id="d4cb-1849-f5dd-68a8" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1479-3156-57c9-4141" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Overlapping fields of fire" id="7cd7-7465-b42f-1fd1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your Shooting phase. Select an enemy unit that have lost any Wound during that phase. Until the end of that phase, add 1 to the hit roll for attacks made by friendly REGIMENT units against that enemy unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Fighting retreat" id="969a-046c-d453-76f7" collective="false" hidden="true" import="true" type="upgrade">
              <comment>MECHANISED</comment>
              <constraints>
                <constraint id="660f-b6b8-9b31-d97f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="7795-e688-5cdf-5aac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Fighting retreat" id="2b87-8221-747b-4cd6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during your Movement phase. Select one MECHANISED INFANTRY REGIMENT unit that Fell back. Models in that unit can shoot it&apos;s weapons during the next Shooting phase, but if they do, until the end of the turn, each time a model in that unit makes a ranged attack, subtract 1 from that attacks hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
