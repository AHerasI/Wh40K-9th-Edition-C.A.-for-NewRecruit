                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly REGIMENT INFANTRY or REGIMENT CAVALRY unit within VOX RANGE of this WARLORD. That unit gains the SACRIFICEABLE trait until your next command phase.</characteristic>
                      </characteristics>
                    </profile>
