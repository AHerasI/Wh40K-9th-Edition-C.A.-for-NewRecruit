    <profile name="Command Vehicle" id="fddf-4b1a-1e17-d5b4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">OFFICER models embarked within this model can issue ORDERS.
When doing so, measure distances to and from this TRANSPORT model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grinding Advance" id="f093-6f54-0873-e90c" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model Remains Stationary or moves up to half of it&apos;s maximun movement range in the Movement phase, it can shoot its turret weapon twice against the same objective in the following Shooting phase.</characteristic>
      </characteristics>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="699a-1d98-3bd0-529b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
    </profile>
    <profile name="Emergency Plasma Vents" id="5da0-c6c3-0fe5-4917" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model fires a supercharged profile of a plasma weapon, and roll one or more hit rolls of 1, instead being damaged as the weapon profile describes, for any number of hit rolls of 1, the bearer suffers 1 mortal wound after all of this weapon’s shots have been resolved.</characteristic>
      </characteristics>
    </profile>
