                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Warp-sight plea" id="ad79-fc3c-c06c-da79" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE, CULTISTS or &lt;LEGION&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a ranged attack, re-roll a hit roll of 1 and the target does not receive the benefits of cover against that attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="5 - Soultearer portent" id="2b27-72c9-4b4e-d952" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="b6de-4c7b-f64f-5cb5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Soultearer portent" id="c381-e6d1-1d79-49e1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE, CULTISTS or &lt;LEGION&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a melee attack, you can ignore modifiers to the hit roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="6 - Illusory supplication" id="c9c5-26e0-7e61-4b71" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a445-f72c-9aff-8a70" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Illusory supplication" id="ec29-516f-e685-5ebe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this prayer is heard, select one friendly &lt;LEGION&gt; CORE or CULTISTS unit within 3&quot; of this PRIEST. Each time an attack is made against that unit:
- An unmodified hit roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.
- That attack’s hit roll cannot be re-rolled.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Dark zealotry" id="a431-190e-b0eb-9a11" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="67dd-0c6b-88a4-1b46" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="1d7a-48dd-4bf5-201a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
