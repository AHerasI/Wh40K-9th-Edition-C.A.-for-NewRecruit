      <entryLinks>
        <entryLink name="1CP Command re-roll" id="3b8e-d059-8e51-d506" collective="false" hidden="false" import="true" targetId="5988-c6f8-e6da-239c" type="selectionEntry"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 - Before battle" id="88b0-68bc-d318-4055" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="2CP Tellyporta" id="4b8b-7310-3525-4a33" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="30ee-7912-d0ce-73cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2CP Tellyporta" id="b191-9c23-c5c4-a4c6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during deployment. Select one non-MONSTER ORKS unit from your army. You can set up this unit on a tellyporta pad instead of setting it up on the battlefield. If you do so, then in the Reinforcements step of one of your Movement phases, you can set up this unit anywhere on the battlefield that is more than 9&quot; away from any enemy models. If you select a TRANSPORT unit, any embarked units remain embarked when this unit is set up on the battlefield.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="2 - Command Phase" id="9292-fce4-d812-c314" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Get da Loot" id="d2a2-49da-d235-8d4c" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Freeboterz</comment>
              <constraints>
                <constraint id="3698-0b7e-76bc-24da" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="c93f-077d-e535-89e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Get da Loot" id="dda1-d84c-fed2-7648" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Command phase. Select one FREEBOOTERZ INFANTRY unit from your army that is on the battlefield. Until the start of your next Command phase, that unit gains the Objective Secured ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="3 - Movement Phase" id="723a-702b-d60f-50f4" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Cut them down" id="5579-5536-f5e4-1b61" collective="false" hidden="false" import="true" targetId="4428-f83f-58af-3292" type="selectionEntry"/>
            <entryLink name="1CP Desperate breakout" id="d09e-3913-4d8a-d44d" collective="false" hidden="false" import="true" targetId="e39e-d7b1-900f-0762" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Ded Sneaky" id="fb0c-8a2a-035e-7ca4" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Blood Axes</comment>
              <constraints>
                <constraint id="7d94-8b81-5836-6768" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
