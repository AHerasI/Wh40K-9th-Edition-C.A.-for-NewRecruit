      <profiles>
        <profile name="Dok’s Toolz [Aura]" id="7dca-5cb1-aa86-303c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CLAN&gt; INFANTRY or &lt;CLAN&gt; BIKER unit is within 6&quot; of this model, each time a model in that unit would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
