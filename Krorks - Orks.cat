        <profile name="Orky know-wotz" id="1825-d044-0c5b-eab2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can use the Sawbonez ability twice per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fungal Concoctions" id="742b-ba55-e4f6-4c55" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beggining of each Fight phase, you can select a friendly ORK unit without VEHICLE or TITANIC Keywords within 6&quot; of this model.
 Until the end of the phase, each time a ORK model in that unit makes a Melee attack with a weapon without the SQUIG rule, add 1 to the Strength of that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
