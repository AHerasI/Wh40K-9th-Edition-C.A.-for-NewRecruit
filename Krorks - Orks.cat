                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Da Jump" id="b818-87f4-00cd-7abf" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Blessing: Da Jump has a warp charge value of 7. If manifested, select one friendly &lt;CLAN&gt; CORE unit that is within 12&quot; of this PSYKER. Remove that unit from the battlefield and set them up anywhere on the battlefield more than 9&quot; from any enemy models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="4 - Fists of Gork" id="ad5d-281c-70c9-c947" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e015-7ca1-0750-78cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Fists of Gork" id="8a4a-76cc-0283-996a" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Blessing: Fists of Gork has a warp charge value of 6. If manifested, select one friendly ORKS CHARACTER model that is within 12&quot; of this PSYKER and visible to them. Until the start of your next Psychic phase, add 2 to that model’s Strength and Attacks characteristics. If the result of the Psychic test was 11 or more, add 3 to that model’s Strength and Attacks characteristics instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="5 - Da Krunch" id="4234-b727-d9fa-a37b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1136-26e4-f671-785b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Da Krunch" id="330c-bbff-d60d-e367" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Witchfire: Da Krunch has a warp charge value of 6. If manifested, select one enemy unit that is within 18&quot; of this PSYKER. Roll one D6 for each model in that unit; for each roll of 5+, that enemy unit suffers 1 mortal wound. If the result of the Psychic test was 9 or more, add 2 to rolls when resolving this psychic power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="6 - Deff Wave" id="0a64-048b-6a3d-f8e7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="22ab-bbbc-fc89-ba96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Deff Wave" id="2bc0-2121-5fcc-3a2a" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">9</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">9&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Warpfire: Deff Wave has a warp charge value of 9. If manifested, select one model from an enemy unit that is within 9&quot; of this PSYKER and draw a straight line between the closest point of this model’s base and that of the selected model in the target unit. Roll as many D6 as the obtained warp charge for the target unit, and each other unit this line passes over. For each roll of 6, that unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
