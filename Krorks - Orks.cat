    <categoryEntry name="Weirdboy" id="f35b-5a7d-92f1-283d" hidden="false">
      <infoGroups>
        <infoGroup name="Skul!!!" id="0a58-4784-b240-0976" hidden="false">
          <profiles>
            <profile name=" Skul!!!" id="b9bc-4fed-1965-77b4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Once per battle, in your Command phase, you can declare Skul!!!
- Skul!!! lasts until your next Command phase.
- Only one Warcry can be active for your army during a turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Skul!!!" id="8e01-fde6-7eae-9245" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to Saving throws for ORK and GRETCHIN models of your army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Warcry" id="15d1-2eb0-8c0d-b1b0" hidden="false" targetId="6ec6-f35f-b886-5a54" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Waaagh! Energy" id="189a-0a04-f32b-0155" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- While there are 20 or more ORK models within 12&quot; of this model, this model can attempt to manifest one additional psychic power in your Psychic phase.
- Add 1 to Psychic tests taken for this model for every 10 ORK models within 9&quot; of it when the roll is made. If the result of the test is 15+ this model immediately suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Specialist Mob" id="9e2d-9350-03a5-df5d" hidden="false"/>
    <categoryEntry name="Speed Freeks" id="7484-987a-58c9-9462" hidden="false">
      <profiles>
        <profile name="Speed Freeks" id="6479-d377-911f-dcad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">SPEED FREEKS units are eligible to shoot in a turn they fell back.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Mek" id="9daa-b6ae-fc06-236a" hidden="false">
      <infoGroups>
        <infoGroup name="Dakka!!!" id="e91f-5c33-6491-b8e5" hidden="false">
          <profiles>
            <profile name=" Dakka!!!" id="2418-b238-931b-0c62" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Once per battle, in your Command phase, you can declare Dakka!!!
- Dakka!!! lasts until your next Command phase.
- Only one Warcry can be active for your army during a turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Dakka!!!" id="8d58-11e1-41ca-917c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in an ORK unit from your army is selected to make a ranged attack:
- Add 1 to the number of attacks made by Heavy weapons the model has equipped.
- Add 2 to the number of attacks made by Pistol or Assault weapons the model has equipped.
- Duplicate the number of attacks made by Dakka or Rapid fire weapons the model has equipped.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Warcry" id="bf7e-059f-6483-316a" hidden="false" targetId="6ec6-f35f-b886-5a54" type="rule"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Dok" id="56fe-b917-d141-865e" hidden="false">
      <infoGroups>
        <infoGroup name="Ruk!!!" id="8611-05e6-947c-504a" hidden="false">
          <profiles>
            <profile name=" Ruk!!!" id="a769-e7c2-dcc4-8c73" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Once per battle, in your Command phase, you can declare Ruk!!!
- Ruk!!! lasts until your next Command phase.
- Only one Warcry can be active for your army during a turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Ruk!!!" id="e52f-9e11-0246-61c7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Add 2&quot; to the Movement characteristic of ORK and GRETCHIN models of your army.
- Each time an ORK unit from your army is selected to Advance or Charge, roll an additional D6 and discard one dice.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Warcry" id="e43b-91e3-9989-247f" hidden="false" targetId="6ec6-f35f-b886-5a54" type="rule"/>
      </infoLinks>
