  <sharedRules>
    <rule name="Warcry" id="6ec6-f35f-b886-5a54" hidden="false">
      <description>Only one Warcry can be active durin a turn.
Waaagh!!!, Speedwaaagh!!!, Da Great Waaagh!!!, Dakka!!!, Skul!!! and Ruk!!! are considered Warcries.</description>
    </rule>
  </sharedRules>
