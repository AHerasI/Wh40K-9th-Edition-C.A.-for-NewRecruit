              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this WARLORD has made a charge move this turn, until the end of the turn, each time a friendly &lt;CLAN&gt; ORKS unit declares a charge against an enemy unit that is within Engagement Range of this WARLORD, add 1 to the charge roll for that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
