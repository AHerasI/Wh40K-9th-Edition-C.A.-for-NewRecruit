      </modifiers>
      <profiles>
        <profile name="Big Mekaniak" id="0083-0662-ded8-13b8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can repair one friendly &lt;CLAN&gt; VEHICLE model within 3&quot; of it. That VEHICLE model regains up to D3 lost wounds. Each model can only be repaired once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Weapon tinkering" id="9bc1-f2e4-6d30-26a7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beggining of your Shooting phase, you can select a friendly ORK unit within 6&quot; of this model.
Until your next Command phase, when a model in that unit makes a ranged attack, make an additional attack with the weapon.</characteristic>
          </characteristics>
        </profile>
      </profiles>
