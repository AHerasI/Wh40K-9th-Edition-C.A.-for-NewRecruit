        <profile name="Fixin’ Jobs" id="2851-95ac-a885-36f3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of each of your Movement phases, this model can repair one friendly &lt;CLAN&gt; VEHICLE model within 1&quot; (it cannot repair itself). If it does, that model regains up to D3 lost wounds. A model can only be repaired once each turn.</characteristic>
          </characteristics>
        </profile>
