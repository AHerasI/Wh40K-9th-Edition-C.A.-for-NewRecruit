        </profile>
        <profile name="Throat Slittas" id="7458-30bd-ac9f-1379" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes a melee attack against units without INORGANIC, VEHICLE or TITANIC Keyword, if it is within 1&quot; of a terrain feature, add 1 to that attack’s wound roll.</characteristic>
          </characteristics>
        </profile>
