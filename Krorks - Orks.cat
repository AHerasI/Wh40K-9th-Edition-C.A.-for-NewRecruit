      <profiles>
        <profile name="Sneaky Gitz" id="dd18-b365-5618-38ef" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a ranged attack is made against this unit while it is receiving the benefits of cover, a hit roll of 1-3 for that attack fails.
- Each time an attack is allocated to a model in this unit while it is receiving the benefits of cover, add an additional 2 to any armour saving throw made against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Throat Slittas" id="05e9-3e63-9170-6087" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes a melee attack against units without INORGANIC, VEHICLE or TITANIC Keyword, if it is within 1&quot; of a terrain feature, add 1 to that attack’s wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
