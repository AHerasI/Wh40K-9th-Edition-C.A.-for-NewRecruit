    <profile name="Yo gitzs, go a&apos;ead!" id="d8a9-1062-e686-9165" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit contains a Boss Nob in addition to other miniatures, whenever an attack is assigned to the unit, the Thoughness characteristic of the Nob Boss is never considered as the characteristic of the unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Diminutive" id="623d-9f97-d06a-6762" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is allocated to a model in this unit while it is receiving the benefits of cover, add an additional 1 to any armour saving throw made against that attack.</characteristic>
      </characteristics>
    </profile>
