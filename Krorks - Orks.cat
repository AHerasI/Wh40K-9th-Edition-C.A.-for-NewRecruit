              </modifiers>
              <profiles>
                <profile name="1CP Wreckaz" id="f471-5e01-1366-31ae" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Shooting or Fight phase. Select one DEATHSKULLS CHARACTER unit from your army. Until the end of the phase, each time a model in that unit makes an attack that targets a VEHICLE, add 1 to that attack’s wound roll.</characteristic>
