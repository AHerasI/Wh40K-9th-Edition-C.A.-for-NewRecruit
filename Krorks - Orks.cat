      <profiles>
        <profile name="Dead Tough" id="cde7-a15d-c737-b73c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stand yo&apos; groun&apos;, ladz!" id="976b-f564-dc40-d458" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CLAN&gt; CORE or &lt;CLAN&gt; CHARACTER unit is within 6&quot; of this model, each time a model in that unit fails a morale check, you can roll a D3. That unit suffers as many Mortal wounds as the result of the roll, and the morale check is passed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
