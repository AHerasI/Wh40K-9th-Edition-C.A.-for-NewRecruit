<catalogue name="Krorks - Orks" id="7e69-59ee-be76-4062" authorContact="Centuria Astartes Discord, ask for AHeras." authorName="A. Heras" authorUrl="Centuria Astartes Discord" battleScribeVersion="2.03" gameSystemId="5b78-3a13-0882-b019" gameSystemRevision="4" library="false" revision="1" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
