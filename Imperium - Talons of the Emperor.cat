    <selectionEntry name=" Shield Host" id="aa33-7ff8-3fc8-7fd4" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="4228-f94a-622f-476e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="ee5e-90b0-335f-ddfa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name=" Martial Ka’tah" id="6aca-49c7-7e2c-e77c" hidden="false">
          <profiles>
            <profile name="Calistus" id="90a4-d440-9409-c48a" hidden="false" typeId="7bc9-452f-9ced-3cf2" typeName="Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="During your Command phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until your next Command phase." typeId="3460-849f-220e-22e5">Each time a INFANTRY unit makes a Normal Move or Advances in your Movement phase, it counts as having Remained Stationary.</characteristic>
              </characteristics>
            </profile>
            <profile name="Conservai" id="69b3-66af-698c-064a" hidden="false" typeId="7bc9-452f-9ced-3cf2" typeName="Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="During your Command phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until your next Command phase." typeId="3460-849f-220e-22e5">Units can perform an action in a turn in which it Advanced or Fell Back. In addition, while a unit is performing an action, it can shoot without that action failing.</characteristic>
              </characteristics>
            </profile>
            <profile name="Salvus" id="7630-582c-4859-739d" hidden="false" typeId="7bc9-452f-9ced-3cf2" typeName="Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="During your Command phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until your next Command phase." typeId="3460-849f-220e-22e5">Add 1 to the number of Attacks of each ranged weapon a INFANTRY model has equipped.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Martial Ka’tah" id="fcd9-129d-758c-7ac9" hidden="false">
              <description>During your Command phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until your next Command phase.</description>
            </rule>
          </rules>
        </infoGroup>
        <infoGroup name="Martial Ka&apos;tah" id="b9b9-57c5-c2ee-5da9" hidden="false">
          <profiles>
            <profile name="Kaptaris" id="556c-4d17-94d8-b441" hidden="false" typeId="0d1e-c280-37e2-d021" typeName="Melee Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="At the beginning of each Fight phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until the next Fighting phase." typeId="92fa-a3fe-511c-90c6">Each time a melee attack is made against this unit, the hit roll cannot be re-rolled.</characteristic>
              </characteristics>
            </profile>
            <profile name="Rendax" id="d327-dd1b-e76f-99ed" hidden="false" typeId="0d1e-c280-37e2-d021" typeName="Melee Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="At the beginning of each Fight phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until the next Fighting phase." typeId="92fa-a3fe-511c-90c6">Each time a model with this ability makes an attack against a VEHICLE or MONSTER unit, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
              </characteristics>
            </profile>
            <profile name="Datacari" id="76e6-c13d-4ab8-6d23" hidden="false" typeId="0d1e-c280-37e2-d021" typeName="Melee Martial Ka&apos;tah">
              <characteristics>
                <characteristic name="At the beginning of each Fight phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until the next Fighting phase." typeId="92fa-a3fe-511c-90c6">Until that Fight phase is resolved, add 1 to the Attacks characteristic of models with this ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Melee Martial Ka’tah" id="e2d3-9e70-2146-8ac9" hidden="false">
              <description>At the beginning of each Fight phase, you can select one of the three of the following abilities, that affect ADEPTUS CUSTODES units from your army until the next Fighting phase.</description>
            </rule>
          </rules>
        </infoGroup>
      </infoGroups>
      <selectionEntryGroups>
        <selectionEntryGroup name="Shield Host" id="0f9f-7d53-e72c-f2b9" collective="false" defaultSelectionEntryId="d007-ace8-c94d-63e4" hidden="false" import="true">
          <constraints>
            <constraint id="47bd-30bb-85aa-b4d1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a314-1c2f-1fed-d9b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Aquilan Shield" id="d007-ace8-c94d-63e4" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Gilded Guardians" id="9e78-a8c3-931b-353b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this trait are eligible to perform Heroic Interventions as if it were a CHARACTER unit, when doing so, the unit is eligible to perform a Heroic Intervention if it is within 6&quot; horizontally and 5&quot; vertically of an enemy unit. When performing a Heroic Intervention with that unit, you can move each model in that unit up to 6&quot;. All other rules for Heroic Interventions still apply.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dread Host" id="4a78-a243-b993-dbe7" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Instruments of the Emperor&apos;s Wrath [Aura]" id="d54a-108b-23a4-a682" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Subtract 2 from the Leadership characteristic of models within 6&quot;. In addition, each time a Combat Attrition test is taken for that enemy units, subtract 1 from that Combat Attrition test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Emissaries Imperatus" id="5c79-b73e-eb5f-6728" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Heralds of the Throne" id="f130-82c1-9490-5e9e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if a unit with this trait is within Engagement Range of any enemy units, it can fight first that phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Shadowkeepers" id="d21a-be8c-9b84-2b92" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Wardens of the Dark Cells" id="f882-5f14-6eb4-6d94" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within Engagement Range of one or more units with this trait, subtract 1 from the Attacks characteristic of each model in that enemy unit, to a minimum of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Emperor’s Chosen" id="f5d9-9eb4-a5a7-c99c" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Magna Imperator" id="1a5c-02f2-1d69-4b25" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this trait is selected to shoot or fight, you can re-roll one hit roll and one wound roll when resolving that unit’s attacks.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Solar Watch" id="dbfc-6f8a-d0f4-9e59" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Talon Sortie" id="45bd-23ba-da83-4723" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this trait are eligible to declare a charge in a turn in which they Fell Back. In addition, add 1 to Advance and charge rolls for that unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
