        <profile name="Medicus Ministorum Training [Aura]" id="b6e8-5b8b-c9be-f7d2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly IMPERIUM INFANTRY unit is within 3&quot; of this model, each time a model in that unit would lose a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Restoration" id="0c3f-63d3-a3e9-ae38" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one friendly IMPERIUM INFANTRY unit that is not at its Starting Strength and is within 3&quot; of that KNIGHT VESTAL unit. One of the selected friendly unit’s destroyed models is returned to its unit with it&apos;s full wounds remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacred Healing" id="d627-324d-cd3d-d275" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can heal one friendly IMPERIUM INFANTRY model whose unit is within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be healed once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
