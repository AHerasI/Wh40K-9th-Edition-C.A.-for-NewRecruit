          <profiles>
            <profile name="Halo of the Torchbearer" id="cd67-ebcb-8c2c-0742" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, roll one D6 for each enemy unit within 3&quot; of this model. On a 3+, that enemy unit suffers 1 mortal wound, or D3 mortal wounds if that unit’s Leadership characteristic is 7 or less.</characteristic>
              </characteristics>
            </profile>
            <profile name="Halo of the Torchbearer [Aura]" id="ddca-9d04-c054-a9ca" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly EMISSARIES IMPERATUS unit is within 3&quot; of this model, it can ignore any or all modifiers to its Move characteristic, Advance rolls and charge rolls.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Castellan&apos;s mark" id="e93c-4f10-65cc-f843" collective="false" hidden="true" import="true" type="upgrade">
