            <profile name="A long list" id="9b3f-9bc4-498b-3a1d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD makes a ranged attack, the target does not receive the benefits of Light Cover against that attack.
- Each time you select a target for this WARLORD’s ranged weapons, you can ignore the Look Out, Sir rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="4 - Guild Affiliate" id="0826-e85d-456e-5905" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5442-0212-2b9b-1b06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7b55-8950-abf2-cd14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
