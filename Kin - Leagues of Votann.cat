          </modifiers>
          <profiles>
            <profile name="Brôkhyr Forge-master" id="e182-e87f-456e-c163" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle round, if this model is on the battlefield when you use a Stratagem, if the unit selected to use that Stratagem is a friendly &lt;LEAGUE&gt; unit within 6&quot; of this BRÔKHYR FORGE-MASTER, reduce the CP cost of that Stratagem by 1CP. Note that the CP cost is only reduced by 1CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
              </characteristics>
            </profile>
            <profile name="Forge-master’s Eye" id="e2e1-e2b6-4d24-063a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a BRÔKHYR FORGE-MASTER model makes an attack, on an unmodified wound roll of 6, that attack inflicts a number of mortal wounds on the target equal to the damage characteristic of that attack, and the attack sequence ends.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
