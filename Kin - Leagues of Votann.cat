          <profiles>
            <profile name="Nomad Strategist" id="92b1-5532-20d7-9636" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, you can select up to three friendly TRANS-HYPERIAN ALLIANCE units wholly within your deployment zone. Remove those units from the battlefield, then set them up anywhere on the battlefield that is wholly within your deployment zone. If the mission uses the Strategic Reserves rules, any of those units can be placed into Strategic Reserves without having to spend any additional CPs, regardless of how many units are already in Strategic Reserves. If both players have abilities that redeploy units, roll off; the winner chooses who redeploys their units first.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
