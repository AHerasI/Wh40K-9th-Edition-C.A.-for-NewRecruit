              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this WARLORD is on the battlefield, each time you spend a Command point to use a Stratagem you can roll one D6: on a 5+, that Command point is refunded.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6 - Grim demeanour" id="bd42-648f-178e-ed81" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c6db-1e48-78c2-e502" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
