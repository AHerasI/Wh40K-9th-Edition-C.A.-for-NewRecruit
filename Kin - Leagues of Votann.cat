              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a HIGH KÂHL model destroys an enemy unit, if that unit had the BODYGUARD, CHARACTER or TITANIC Keywords, your Army gain 1 Yield Point.</characteristic>
              </characteristics>
