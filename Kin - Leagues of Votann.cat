      <profiles>
        <profile name="Grimnyrs’ Regard [Aura]" id="a85d-9332-9916-9df5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEAGUE&gt; CORE unit is within 6&quot; of this unit, add 1 to Combat Attrition tests taken for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ancestral Ward Crest" id="2dcb-3395-4edd-4eef" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each model in this unit has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="CORV Support" id="b9a8-a6a8-63b1-6754" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit suffers Perils of the Warp, if this unit contains 1 or more DRONE models, 1 of those models is destroyed and the effect(s) of that Perils of the Warp is ignored.
If this unit’s GRIMNYR model is ever destroyed, all of this unit’s remaining DRONE models are also destroyed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
