        <profile name="Kognitâar mantle" id="5ff6-0660-abeb-5ac0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your movement phase, you can select a &lt;LEAGUE&gt; CORE unit within 6&quot; of this unit. Until your next Command phase, if the unit is performing an action, IRONKIN models in that unit can shoot without the action failing.</characteristic>
          </characteristics>
        </profile>
