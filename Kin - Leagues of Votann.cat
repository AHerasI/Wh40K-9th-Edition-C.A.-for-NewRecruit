          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEAGUE&gt; HEARTHGUARD unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="RAM Shield" id="f61e-09b3-c50d-dcd8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack of Strength 7 or less is made against this model, subtract 1 from that attack’s wound roll.</characteristic>
          </characteristics>
        </profile>
