    <selectionEntry name=" Stratagem List" id="6f3e-ca6b-85e9-f809" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="1CP Command re-roll" id="0972-e405-d455-960b" collective="false" hidden="false" import="true" targetId="5988-c6f8-e6da-239c" type="selectionEntry"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 - Before battle" id="4e67-c918-cb80-cf2a" collective="false" hidden="false" import="true"/>
        <selectionEntryGroup name="2 - Command Phase" id="5273-8f1c-af0e-732f" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Appraising Glare" id="ae5f-692e-4013-7239" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Thurial League</comment>
              <constraints>
                <constraint id="92f4-7da6-b34c-0cd2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="f158-cea0-b779-973b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Appraising Glare" id="4344-f628-1067-be59" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when a GREATER THURIAN LEAGUE KÂHL model from your army uses its Grim Efficiency ability. Select a model in that unit. Friendly GREATER THURIAN LEAGUE units without CHARACTER Keyword within 3&quot; of that model also gains the SACRIFICEABLE Keyword.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="3 - Movement Phase" id="79bc-1b1a-87d0-303c" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Cut them down" id="eee9-b493-9f97-3f6b" collective="false" hidden="false" import="true" targetId="4428-f83f-58af-3292" type="selectionEntry"/>
            <entryLink name="1CP Desperate breakout" id="5c86-8068-3e98-029a" collective="false" hidden="false" import="true" targetId="e39e-d7b1-900f-0762" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Accelerated response" id="9490-5c7c-85e5-2dab" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d48e-8150-9306-44f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Accelerated response" id="dc31-df10-b85f-08d5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Movement phase, when a VOTANN unit with the ACCELERATED ability from your army is selected to Advance. Until the end of the phase, add 12&quot; to the Move characteristic of each model in this unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="4 - Psychic phase" id="5cfa-bde6-7c46-58f7" collective="false" hidden="false" import="true"/>
        <selectionEntryGroup name="5 - Shooting phase" id="1cdf-c7b5-b134-8b83" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="2CP Point-blank Fusillade" id="18b5-2141-9518-b930" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bfe6-47c8-b973-b4be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2CP Point-blank Fusillade" id="db52-d717-2ae4-2df2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Shooting phase. Select one VOTANN INFANTRY or VOTANN BIKER unit from your army. Until the end of the phase, models in this unit can make attacks with ranged weapons even when their unit is within Engagement Range of enemy units, but they can only make such attacks against enemy units that they are within Engagement Range of (if a model makes an attack with a beam weapon, that attack is only resolved against that target unit and it cannot hit any other unit). In such circumstances, those models can target an enemy unit even if other friendly units are within Engagement Range of the same enemy unit. Note that if a model in this unit has more than one ranged weapon, you can still choose to target units that are not within Engagement Range of that model’s unit, but that model will only be able to make the attacks with that weapon if all enemy units within Engagement Range of that model’s unit have been destroyed when you come to resolve those attacks. In addition, when a model in this unit shoots a Heavy weapon, subtract 1 from the hit rolls when resolving that weapon’s attacks while any enemy units are within Engagement Range of that model’s unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Optimised Volley" id="259a-dd22-7b67-d42c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c5a7-74ca-daa1-576e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Optimised Volley" id="03f4-34a9-d240-eb44" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a VOTANN unit from your army is selected to shoot. Until the end of the phase, each time a model in that unit makes an attack with a bolt weapons, on an unmodified hit roll of 6, one additional hit is scored; if the target unit contained 11 or more models when this Stratagem was used, then 2 additional hits are scored instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Concussion Blast" id="c7e3-fc0f-9498-990a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e63d-a988-2784-ae1f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Concussion Blast" id="5045-368c-2b5c-6ec8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a VOTANN HEARTHKYN or HERNKYN unit from your army is selected to shoot. Select one enemy unit within 6&quot; of that unit. Until the start of your next Shooting phase:
- The selected enemy unit cannot fire Overwatch or Set to Defend.
- Each time a model in the selected enemy unit makes an attack, subtract 1 from that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Pulsed Beam discharge" id="15ef-3648-f8ce-f1ea" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Ymyr</comment>
              <constraints>
                <constraint id="374f-13ad-c793-48a9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="7673-0aa0-a7e8-a890" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Pulsed Beam discharge" id="c230-5de7-955f-985b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when an YMYR CONGLOMERATE unit from your army is selected to shoot. Select one model in that unit, and then select one beam weapon that it is equipped with. Until the end of the phase, each time a wound is scored with that weapon, the target suffers 1 mortal wound in addition to the normal Damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="6 - Charge phase" id="cd01-7af0-7753-993e" collective="false" hidden="false" import="true"/>
        <selectionEntryGroup name="7 - Fight phase" id="f6b0-0df9-9195-db84" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="2CP Counter-offensive" id="a4bc-a7a1-87af-ca18" collective="false" hidden="false" import="true" targetId="b12f-dc2d-6057-5468" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Bloody Expectations" id="f178-a919-4817-80b2" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Kronus</comment>
              <constraints>
                <constraint id="1a2b-65de-937f-9af8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="a666-5e6a-8201-33ca" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Bloody Expectations" id="ca58-9eb9-1f6e-35d3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a KRONUS HEGEMONY unit from your army is selected to fight. Until the end of the phase, each time a model in that unit makes a melee attack, an unmodified hit roll of 6 scores 1 additional hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Waste not your last breath" id="7212-4211-abd1-b8d2" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Urani</comment>
              <constraints>
                <constraint id="b6bf-344a-4db5-5a14" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="2cb8-d161-10dd-5ff2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Waste not your last breath" id="e941-7f79-123e-1f12" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase when an URANI-SURTR REGULATES CHARACTER model from your army that has not already been selected to fight this phase is destroyed. Do not remove that model from play - it can fight after the attacking model’s unit has finished making attacks. After resolving the destroyed model’s attacks, it is then removed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="8 - Morale phase" id="e11b-2143-4e1b-6bdd" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Insane bravery" id="8b52-7a2a-d62f-2375" collective="false" hidden="false" import="true" targetId="fd81-28f9-2791-da19" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="9 - Taking casualties" id="a092-ddfd-32e9-7366" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Emergency debarkation" id="0881-e129-fd39-3ca7" collective="false" hidden="false" import="true" targetId="415e-3aee-52d6-8680" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP New-found Nemesis" id="ceda-758b-d2da-d271" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d955-2951-f016-2ee2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP New-found Nemesis" id="9e4d-b9de-9cc9-0e3b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when a VOTANN WARLORD or KHÂL model from your army is destroyed. Every unit from your Army without CHARACTER Keyword gains the SACRIFICEABLE Keyword until the end of the Battle, but from that point, SACRIFICEABLE units from your Army cannot use Abilities or Stratagems that able to re-roll a Hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Cult of Veneration" id="404a-707c-347f-edee" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Hyperian</comment>
              <constraints>
                <constraint id="75dc-9ab6-df4a-bf73" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="12b9-f34c-821b-b183" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Cult of Veneration" id="416b-982f-0f23-a094" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in any phase, when a TRANS-HYPERIAN ALLIANCE model from your army would lose a wound as the result of a mortal wound. Until the end of the phase, each time that model, or another model in its unit, would lose a wound as the result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Hernkyn Yaegirs" id="ab0b-92fd-d2c5-4139" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Faction: Kin" id="5606-7b08-3eac-e816" hidden="false" primary="false" targetId="4c9f-f934-ed79-84fe"/>
