                          <characteristics>
                            <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">3</characteristic>
                            <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">3</characteristic>
                            <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite, &lt;ORDO&gt; power, 3 from Telethesia discipline.</characteristic>
