                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a CHAOS KNIGHT CHARACTER from your Army gains the Veteran, Heroic or Legendary rank. 
That model can be upgraded to have a Favour of the Dark Gods; increase its PL accordingly.
You cannot purchase this Requisition if doing so would cause your total PL to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Chosen of the Pantheon" id="d261-7fa2-baab-91ba" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="314a-66cb-3014-3ab1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Chosen of the Pantheon" id="3961-3238-e6ea-b336" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition at any time. 
Select one UNDIVIDED model from your Army. 
Replace that model’s UNDIVIDED Keyword with either KHORNE, TZEENTCH, NURGLE or SLAANESH.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Ascension to Daemonhood" id="a621-a4a7-dc5b-58a1" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="ddba-b7dd-66ae-23e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Ascension to Daemonhood" id="2773-07a0-27da-60d4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a CHAOS LEGIONS INFANTRY CHARACTER, CHAOS LEGIONS CAVALRY CHARACTER or CHAOS LEGIONS BIKER CHARACTER unit from your Army gains the Heroic or Legendary Rank. 
Remove that CHARACTER from your Army and replace it with a EXALTED LORD (excluding named characters) from the same Warband.
The new unit must share the same Mark as the removed CHARACTER.
You cannot purchase this Requisition if doing so would cause your total Power Level to exceed your Army&apos;s Supply Limit. 
The new EXALTED LORD starts with the same number of experience points as the CHARACTER it replaced and gains the appropriate number of Battle Honours for its rank.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Ascension to Power" id="29e9-8e48-e4ac-8d98" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="ddba-b7dd-66ae-23e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Ascension to Power" id="167f-de71-64d4-d649" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a THOUSAND SONS CHARACTER, RUBRIC MARINES or SCARAB OCCULT unit from your Army gains the Veteran, Heroic or Legendary rank.
That unit gains a Legion Command upgrade. If the upgraded unit is a OSIRON PATTERN DREADNOUGTH, it must be upgraded with an Ascension ritual instead.
You cannot purchase this Requisition if doing so would cause your total Power Level to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Deadly pathogens" id="5a2f-1de4-b2b1-cb0e" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="ddba-b7dd-66ae-23e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
