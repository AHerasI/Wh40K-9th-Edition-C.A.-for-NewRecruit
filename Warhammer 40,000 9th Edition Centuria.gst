                    <profile name="Shang" id="cf52-7269-8bbf-9f82" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model manifests the Smite psychic power, you can select one enemy unit within 18&quot; of and visible to this model to be affected, instead of the closest enemy unit.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Paralysis Grenades" id="af7c-7d07-f2b6-dd1f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this model made a charge move this turn, you can select one enemy unit that is within Engagement Range of this model. Until the end of that phase, that enemy unit cannot be selected to fight until all other eligible units have done so.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
