                  </modifiers>
                  <profiles>
                    <profile name="Angels of Death" id="ebcb-9af9-e2a4-2936" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <comment>gains 1 experience point for each of the following:</comment>
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the battle, if there are no models from the enemy army remaining on the battlefield, each unit from your army that is on the battlefield gains 2 experience points and this mision is achieved.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Quest of Atonement (+1RP)" id="1c42-48c2-245a-b6ea" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="8e1a-293a-a6e6-316d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                            <condition childId="f892-bc01-eb8f-678f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Quest of Atonement" id="8296-c444-97d1-016c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of a Battle, you can select units in your army that has one of the following Battle Scars: Shell Shock, Disgraced or Non communicative. If during the battle, an attack made by that unit during the battle destroyed an enemy CHARACTER, or a WARLORD, MONSTER or VEHICLE unit, then the selected unit loses one of the aforementioned Battle Scars, gains 5 experience points and this mision is achieved.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Pursuit of Excellence (+1RP)" id="4454-f1b8-97c0-ca7d" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="afc4-a516-5f64-a5f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Pursuit of Excellence" id="3591-e4dc-1524-18d1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the battle, if the ADEPTUS CUSTODES unit from your army that has the lowest number of experience points (if two or more are tied, select one of them) achieve all of the following, it gains 3 experience points and this mision is achieved.
- That unit does not gain any Battle Scars during this Battle.
- That unit destroyed at least 2 enemy units during this Battle.
- That unit achieved a tactical objective during this Battle.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Tech Scavengers (+1RP)" id="00d1-98f8-7189-a06f" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
