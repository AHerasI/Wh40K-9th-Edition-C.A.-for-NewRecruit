            <profile name="Evasive" id="81d9-74f3-4f43-82eb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against this unit, a hit roll of 1-3 for that attack fails. Substract 1 from that attack&apos;s hit roll.
In adition, each time an attack is made against this model, that attack’s wound roll cannot be re-rolled.</characteristic>
              </characteristics>
            </profile>
            <profile name="Somewhat hysterical" id="cfd2-def8-4082-1201" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit can never be selected to be a WARLORD or receive a WARLORD trait.</characteristic>
              </characteristics>
            </profile>
            <profile name="Urban enviorments Close Quarter Combat specialty" id="b44c-97b7-d6c0-a6a5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit is eligible to shoot and charge in a turn in which Fell Back.
This unit ignores all Difficult Ground movement, advance and charge roll penalties.
This unit can use a Grenade weapon both in engagement range of enemy units and in the same turn of it&apos;s other weapons.</characteristic>
              </characteristics>
            </profile>
          </profiles>
