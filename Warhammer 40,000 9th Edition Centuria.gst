                  <profiles>
                    <profile name="Souls for strength" id="86b7-4d42-55d9-f77d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of a Battle, if at least five enemy units were destroyed by a melee attack by YNNARI units from your Army, each YNNARI unit from your army gains 2 experience points and this mision is achieved.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
