    <profile name="Skillful Parry" id="4ee4-0937-e94e-6728" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against this unit, a hit roll of 1-3 for that attack fails. Substract 1 from that attack&apos;s hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Masterful Parry" id="16a8-9e0d-a147-54b9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against this unit, a hit roll of 1-4 for that attack fails. Substract 1 from that attack&apos;s hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Teleport Strike" id="6301-eaed-f948-13b8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, you can set up this unit as Reinforcements instead of setting it up on the battlefield. If you do, then in the Reinforcements step of one of your Movement phases you can set up this unit anywhere on the battlefield that is more than 6+D3&quot; away from any enemy models.</characteristic>
      </characteristics>
    </profile>
    <profile name="Epic Character" id="280e-9b13-3bda-7f8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model cannot lose more than 3 wounds in the same phase. Any wounds that would be lost after that point are not lost.</characteristic>
      </characteristics>
    </profile>
    <profile name="Death from Below" id="90cf-c0c0-fbd5-5e92" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, if every model in this unit has this ability, then you can set up this unit underground instead of setting it up on the battlefield. If you do, then in the Reinforcements step of one of your Movement phases you can set up this unit anywhere on the battlefield that is more than D3+6&quot; away from enemy models.</characteristic>
      </characteristics>
    </profile>
    <profile name="Quick Response" id="9334-58b2-273b-198c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Melee attack is made against a unit with this ability, a hit roll of 1-2 for that attack fails. 
Substract 1 from that attack&apos;s hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mega-Bolter" id="f2b3-ee9b-dbf4-e8c1" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
