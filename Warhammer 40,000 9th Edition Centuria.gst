                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="a6e9-7968-4980-dcfa" childName="Aeldari mix (all missions)" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                            <condition childId="7959-2c70-fa98-9842" childName="Drukharii" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Soul Trap" id="cdda-dbe6-f421-882f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition once after a battle in which two enemy CHARACTER units were destroyed by a melee attack made by an ARCHON, SUCCUBUS or HAEMONCULUS unit from your Army.
You can purchase the Soul trap upgrade for that unit.
You cannot purchase this Requisition if doing so would cause your total PL to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Paths of the Aeldari" id="b59c-3990-b5a1-69b5" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="a6e9-7968-4980-dcfa" childName="Aeldari" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                            <condition childId="bafc-494f-4fce-550f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Paths of the Aeldari" id="14e3-a52d-3a8a-462b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition either before or after a battle.
Select a ASURYANI TROOP unit without ASPECT WARRIOR Keyword from your Army that has Veteran, Heroic or Legendary rank.
You can replace that unit with a ASPECT WARRIOR unit, excluding CRIMSON HUNTER and CHARACTER units.
The new unit must be drawn from the same Craftworld as the unit it replaced (the new unit cannot contain more models than the unit it replaced). 
You cannot purchase this Requisition if doing so would cause your total PL to exceed your Army’s Supply Limit.
The new unit has the same number of experience points and the same Battle Honours and Battle Scars as the unit it replaced. 
If a Battle Honour cannot be applied (e.g. a Weapon Enhancement for a weapon that a model cannot be equipped with), select a new Battle Honour to replace it.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - A grand performance" id="3961-cbc6-6a27-78d6" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="a6e9-7968-4980-dcfa" childName="Aeldari" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="A grand performance" id="31e2-8673-0c34-1749" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition either before or after a battle.
Select a RILIETANN CHARACTER unit from your Army that has Veteran, Heroic or Legendary rank.
That model is upgraded with a Pivotal Role; increase its PL accordingly.
You cannot purchase this Requisition if doing so would cause your total PL to exceed your Army’s Supply Limit.
The new unit has the same number of experience points and the same Battle Honours and Battle Scars as the unit it replaced. 
If a Battle Honour cannot be applied (e.g. a Weapon Enhancement for a weapon that a model cannot be equipped with), select a new Battle Honour to replace it.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Exalted Daemon" id="bef6-5891-9277-ace8" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="84c7-a444-0943-c5b0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Exalted Daemon" id="ebd6-4fc9-9b37-236c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a GREATER DAEMON unit from your Army gains the Heroic or Legendary rank.
That model is upgraded to a Exalted Daemon; increase its PL accordingly.
You cannot purchase this Requisition if doing so would cause your total PL to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Dark Favour" id="8083-35ea-fb1e-315d" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="314a-66cb-3014-3ab1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
