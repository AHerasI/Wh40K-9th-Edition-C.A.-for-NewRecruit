                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ORDO XENOS CORE unit within 6&quot; of this WARLORD makes a ranged attack, an unmodified hit roll of 6+ scores an additional hit.</characteristic>
                                  </characteristics>
