                  </modifiers>
                  <profiles>
                    <profile name="Deadly pathogens" id="c2bb-c018-e319-40ce" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a DEATH GUARD CHARACTER or DEATH GUARD CHAMPION model from your Army gains the Veteran, Heroic or Legendary rank.
That unit gains a Deadly pathogen upgrade.
You cannot purchase this Requisition if doing so would cause your total Power Level to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Heretek Cult induction" id="cc37-238b-c758-f60e" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="9830-50bc-8bf6-0c65" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Heretek Cult induction" id="9518-f0bb-4c84-c7d3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a TECH PRIEST model from your Army gains the Veteran, Heroic or Legendary rank.
Select a Logician Cult Detachment from your army.
You can change that Cult to a Empyric Engineers, Silica Animus or Xenotech Cult.
That Detachment must contain a TECH PRIEST with a Veteran, Heroic or Legendary rank.
You cannot purchase this Requisition if doing so would cause your total Power Level to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Allegiance ritual" id="c25d-cf6f-b540-7fdb" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="dbdb-fe42-464b-11b5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Allegiance ritual" id="b0f1-74d6-18be-5632" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a TECH PRIEST model from your Army gains the Veteran, Heroic or Legendary rank.
Select a Dark Mechanicum Detachment from your army that contains said TECH PRIEST.
You can either select a God in the pantheon for you detachemnt to worship or, if the Detachment is a Hellforge Worlds Cult, replace that cult for an Abominable Intelligence Cult.
That Detachment must contain a TECH PRIEST with a Veteran, Heroic or Legendary rank.
You cannot purchase this Requisition if doing so would cause your total Power Level to exceed your Army&apos;s Supply Limit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Normalized field adaptations" id="34e3-12ad-3bf8-0769" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="9830-50bc-8bf6-0c65" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Normalized field adaptations" id="9e72-f65c-e411-d7f1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a TECH PRIEST model from your Army gains the Heroic or Legendary rank.
Each time your Army uses the Adaptative Approach ability, and select to push the bounds, you can roll a second D6, and discard one of the dice.
Effects of this ability are not cumulative.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Special Requisition" id="a97a-fb6f-09c6-5ebe" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="11ce-a278-40c1-3c3a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="6030-15c5-bda1-858c" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Special Requisition" id="8f63-af55-7571-fcb2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when a OFFICER model from your Army gains the Veteran, Heroic or Legendary rank.
That model can be upgraded with a Special requisition; increase its PL accordingly.
You cannot have this Requisition active more than once in an Army.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Regiment of renown" id="e569-0752-e0a4-7bd4" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="-1"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
