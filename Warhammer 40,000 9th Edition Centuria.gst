                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Infernal pact " id="933a-6810-56af-791e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After both sides have finished deploying, your opponent must set up one objective marker anywhere on the battlefield that is not within their own deployment zone. 
This objective marker does not count as an objective marker for any rules purposes other than for this mision. 
At the end of the battle, if you control that objective marker, this mission is acomplished, and you can select one CHAOS KNIGHT or CHAOS HERETEK CULT unit that is within range of it. 
That unit gains 3 experience points and, if it has any Battle Scars, you can remove one of them.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Claim and despoil (+1RP)" id="4cce-5d5d-9052-50d9" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
