                  </profiles>
                </selectionEntry>
                <selectionEntry name="1RP - Soul Trap" id="1923-16ae-7f05-3a37" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
