    <categoryEntry name="Heavy Armour Plating" id="b66f-e4bb-3335-6222" hidden="true">
      <profiles>
        <profile name="Heavy Armour Plating" id="4338-2006-c89e-f767" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Add 2 to armour Saving throws made for the bearer.
- Substract 1 from Wound rolls of Strength 7 or less.
- Re-roll failed armour Saving throws from attacks of Strength 7 or less.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Reinforced Armour Plating" id="45a6-4825-db8c-9cff" hidden="true">
      <profiles>
        <profile name="Reinforced Armour Plating" id="b371-9012-4d33-740d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Add 1 to armour Saving throws made for the bearer.
- Substract 1 from Wound rolls of Strength 6 or less.
- Re-roll failed armour Saving throws from attacks of Strength 6 or less.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Reactive Armour system" id="1739-89ed-792c-4025" hidden="true">
      <rules>
        <rule name="  Reactive Armour system" id="8401-d6fe-eb0f-4717" hidden="false">
          <description>Each time the damage of a ranged attack of Strength 8 or more is going to be allocated to a model with this ability, it consume a Reactive Armour packcage, or a Multi-Purpose Reactive Armour packcage can be consumed at will for the purposes of this ability, and the damage of that attack changes to 1.
The use of a Multi-Purpose Reactive Armour packcage must be determined before rolling to determine the damage the attack does.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Smokescreen" id="43bc-4b29-4482-4d3a" hidden="false">
      <rules>
        <rule name="    Smokescreen" id="ea88-5165-21a1-1c91" hidden="false">
          <description>Once per phase, when an attack is declared to a unit with a model with this ability, it can use a Smokescreen charge. If doing so, during the remain of that phase, attacks made against that unit will suffer a -1 to hit rolls penalty.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Crusade" id="d79c-14e3-9777-40d2" hidden="false"/>
    <categoryEntry name="Breaching Vehicle" id="32e3-a565-9834-5c1d" hidden="false"/>
    <categoryEntry name="Ordo Xenos" id="0eb0-346d-12e6-5924" hidden="false">
      <profiles>
        <profile name="Ordo Xenos" id="842f-a974-bf7d-5fbd" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a unit without CHAOS, IMPERIUM or UNALIGNED Keyword, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Xenos Hunters" id="08ad-b755-b58d-02ae" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a unit without CHAOS, IMPERIUM or UNALIGNED Keyword, re-roll a hit roll of 1.
After both sides have finished deploying their armies, select one Battlefield Role. Until the end of the battle, each time a model with this tactic makes an attack against an enemy unit with that Battlefield Role, re-roll a wound roll of 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Servitor" id="24da-1c1f-5930-7a41" hidden="false">
      <profiles>
        <profile name="Mindless Automaton" id="6249-75e5-bec8-c81a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform any actions unless a is within 6&quot; of a friendly MACHINE CULT unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Machine Cult" id="8f9d-ecd1-ee5b-ce9b" hidden="false"/>
    <categoryEntry name="Bodyguard" id="b9f1-de64-cd51-3db4" hidden="false">
      <profiles>
        <profile name="Bodyguard" id="240a-993b-59bc-47e1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly non VEHICLE CHARACTER unit within 3&quot; of this unit, that CHARACTER unit can use the Look Out, Sir rule even if this unit contains fewer than 3 models.
While a friendly non VEHICLE CHARACTER unit is within 3&quot; of this unit, enemy units in engagement range of both cannot declare attacks against the CHARACTER unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Grav-chute" id="d5bc-1a9d-d2a6-ba84" hidden="false">
      <infoLinks>
        <infoLink name="Death from Above" id="312a-868a-4b5c-2011" hidden="false" targetId="2a93-0488-0277-cb07" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Wrecked" id="972c-53fd-93b7-624b" hidden="false">
      <rules>
        <rule name="Wrecked" id="7f62-cf25-93cb-6b1f" hidden="false">
          <description>- Distances are measured to and from the hull of this model, except for it&apos;s weapons. 
- When this model is destroyed, if it doesn&apos;t explode don&apos;t remove it from the battlefield. Instead it become WRECKED, add a marker to it, and from this moment the model is considered as an OBSTACLE for all rules purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="S.Ammo: Boltgun" id="2e83-4dcd-008e-8da0" hidden="false">
      <infoLinks>
        <infoLink name="Special-Issue Ammunition: Boltgun Ammo" id="3ed2-aa52-bc18-0480" hidden="false" targetId="b4aa-63ec-fd2e-978e" type="rule"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="S.Ammo: Hvy. Boltgun" id="b990-3327-639a-d9b0" hidden="false">
      <infoLinks>
        <infoLink name="Special-Issue Ammunition: Heavy Boltgun Ammo" id="57e0-d048-5fb4-18d2" hidden="false" targetId="dfdc-a0cc-daf0-a194" type="rule"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Semi-autonomous device" id="9ebf-0236-1064-1d99" hidden="false">
      <profiles>
        <profile name="Fire-control Data-link" id="5ced-44ea-2c70-cd10" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit can use the Ballistic Skill of friendly MACHINE CULT unit that is within 6&quot; of it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Wraithbone" id="31ea-67f7-bd8b-9e54" hidden="false">
      <profiles>
        <profile name="Wraithbone regeneration" id="059c-2891-6c90-611e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Models with Damage Tables regain 1 wound per own Command phase in their first stage of degradation, and 1D3 wounds otherwise.
- Models without Damage Tables regain 1 wound per own Command phase unless stated otherwise.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Turret-mounted" id="f28c-7e4e-75e1-2474" hidden="false">
      <rules>
        <rule name="Turret-mounted weapon" id="a5b3-873a-4892-5bb0" hidden="false">
          <description>While this unit is within Engagement Range of an enemy unit, this unit may chose to shoot with this weapon against any elegible enemy unit, even those outside Engagement Range. While doing so, a hit roll modifier of -1 is applied.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Sponsor-mounted" id="ceeb-83af-6f77-8baa" hidden="false"/>
    <categoryEntry name="Hull mounted" id="6018-2ce0-fcc7-6ed7" hidden="false"/>
    <categoryEntry name="Nemesis Weapon" id="e6a0-6ca3-a8b1-f687" hidden="false">
      <rules>
        <rule name="Nemesis Weapon" id="aef4-6754-c588-4299" hidden="false">
          <description>Re-roll wound rolls against DAEMON or DAEMONIC units.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Sacrificeable" id="f55d-9d66-abc1-f34f" hidden="false">
      <rules>
        <rule name="Sacrificeable" id="a769-214c-5fd6-0c0b" hidden="false">
          <description>In the shooting phase, you can select as eligible unit for firing enemy units in engagement range of friendly units with this Keyword.
When doing so, subtract 1 from each attack hit roll, and each unmodified failed hit roll of 1 is considered a sucesful hit roll against the friendly unit, which must be resolved as a normal attack against it.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Imperium&apos;s Servants" id="3c6d-c9b3-cd33-e5e5" hidden="false">
      <rules>
        <rule name="Faction: Imperium&apos;s Servants" id="e66c-00fe-15b1-564a" hidden="false">
          <description>This Keyword counts as an Faction: Unaligned Keyword in regard army building.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Tactical Weapon" id="9369-4930-4f3e-67a4" hidden="false">
      <rules>
        <rule name="Tactical Weapon" id="bfed-24ab-daff-ecb9" hidden="false">
          <description>When firing a Tactical Weapon, first, during one of your Shooting phases, place a marker anywhere in the battlefield.
Then, in your next Shooting phase, you can either: 
- Rectify Telemetry: Move the marker up to D6&quot;, and the attack is executed in that point, affecting each unit within the range indicated in the weapon&apos;s datasheet.
- Assing new objective: Remove the marker from the battlefield and place it again anywhere in the battlefield.
- Cancel the attack: Remove the marker from the battlefield. If the Tactical Weapon attack is due to a Stratagem, half of the CP cost is refunded (rounding up).*

*The cost is calculated including modifiers due army&apos;s or character&apos;s abilities.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Vehicle Section" id="780f-68a5-fbfb-bdea" hidden="false">
      <rules>
        <rule name="Vehicle Section" id="ce9a-ee86-9484-91f3" hidden="false">
          <description>The first time this unit is set up, all models in this unit must be placed within 6&quot; of each other. From that point onwards, each operates independently and is treated as a separate unit for all rules purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Chariot" id="05b0-317f-2c5f-4f3f" hidden="false"/>
    <categoryEntry name="Daemonic Weapon" id="5aed-0671-5df2-2c0d" hidden="false">
      <rules>
        <rule name="Daemonic Weapon" id="ceb7-51c4-b64f-a172" hidden="false">
          <description>For each wound roll of 6, it inflicts 1 mortal wound in addition to any other damage the weapon inflicts.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Daemonic" id="27fc-c23f-28a9-0a7c" hidden="true">
      <profiles>
        <profile name="Otherworldly being" id="e034-fbb2-3611-be8b" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>9b11-1c04-9151-afdb</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save.
In your Command phase, this model regains 1 Wound, up of the maximum Wounds characteristic of the model.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="3b77-decb-d468-6bcc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Otherworldly beings" id="aa7a-4469-3a0e-ae17" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>9b11-1c04-9151-afdb</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 5+ invulnerable save.
Inyour Command phase, a model in this unit regains 1 Wound, up of the maximum Wounds characteristic of the model.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="3b77-decb-d468-6bcc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Daemon" id="2282-b372-38e7-1908" hidden="false">
      <profiles>
        <profile name="Otherworldly being" id="9b11-1c04-9151-afdb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>9b11-1c04-9151-afdb</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save.
In your Command phase, this model regains 1 Wound, up of the maximum Wounds characteristic of the model.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Open-topped" id="cdc5-4a32-031d-f86e" hidden="false">
      <rules>
        <rule name="Open-topped" id="3a51-3cb4-8b87-f01b" hidden="false">
          <description>INFANTRY, BEAST or SWARM units embarked in the transport can make ranged attacks with any weapon that cannot ignore the &quot;Look-out, Sir&quot; rule, during the Shooting phase, as if were part of the transport model. These models are included as the vehicle in regard the Big Guns Never Tire rule.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Agents of the Imperium" id="3df1-502a-7c81-42fc" hidden="false">
      <constraints>
        <constraint id="f08f-69c5-0ce1-cdf4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="f08f-69c5-0ce1-cdf4" type="set" value="-1">
          <conditions>
            <condition childId="cfc5-43e4-b02e-d1f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Defence tactics" id="7b2a-54fd-32b3-7fc7" hidden="false">
          <description>When a INFANTRY unit from Faction: Agents of the Imperium fires Overwatch or Searching for Targets and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Aeldari" id="1924-ef18-000b-d2ba" hidden="false">
      <infoLinks>
        <infoLink name="Lightning Reflexes" id="705e-9d06-5ae1-096c" hidden="false" targetId="4bed-9edb-ac60-e62a" type="profile">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Close combat specialists" id="bd6c-c2f1-5554-6104" hidden="false">
          <description>When a unit from Faction: Aeldari fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+.
If the unit has the INFANTRY Keyword and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Drukhari" id="137f-9a86-a5a7-ce94" hidden="false">
      <profiles>
        <profile name="Martial training" id="e82a-4512-cf5a-6149" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against a INFANTRY or BIKER unit with this ability, a hit roll of 1-2 for that attack fails. 
Substract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Blade artists" id="5bca-e02d-fb19-6cb7" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes an attack with a melee weapon, on an unmodified wound roll of 6, improve the Damage characteristic by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Power from Pain" id="8c4c-4d2f-6aa2-b7ec" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each battle round, this ability gains additional effects. These effects are cumulative.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Chaos Mark: Nurgle" id="2226-f82a-fe58-178d" hidden="false">
      <profiles>
        <profile name="Chaos Mark of Nurgle" id="d397-aae4-b6fd-3f63" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chaos Boon of Decay" id="9ec9-e3c3-a2d2-c8f4" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to a model with this ability, subtract 1 from the Damage characteristic of that attack (to a minimum of 1). This ability is cumulative with other abilities that reduce damage.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="27fc-c23f-28a9-0a7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="2282-b372-38e7-1908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="d8d3-6bf7-9b21-8e58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Chaos Mark: Tzeentch" id="4097-5f68-1097-1f16" hidden="false">
      <profiles>
        <profile name="Chaos Mark of Tzeentch" id="9239-5610-bf5e-19b6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to armor saving throws made by models with this ability.
In addition, each time a model with this ability would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chaos Boon of the Change" id="11af-5a6a-d6dd-bdb2" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each phase end, if a unit with this ability has rolled any roll of 5+ in an invulnerable saving throw, one of it&apos;s models regains 1D3 Wounds. 
If all models in the unit are at it&apos;s maximun wound characteristic, a destroyed model of the unit returns at full wounds.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="27fc-c23f-28a9-0a7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="2282-b372-38e7-1908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="d8d3-6bf7-9b21-8e58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Chaos Mark: Khorne" id="11a0-1562-512f-d63b" hidden="false">
      <profiles>
        <profile name="Chaos Mark of Khorne" id="1c5d-e618-7df5-f933" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability makes a melee attack, an unmodified hit roll of 5+ scores one additional hit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chaos Boon of Might" id="3c02-8ea3-2429-9076" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability makes a melee attack, an unmodified wound roll of 6 does it&apos;s damage as Mortal Wounds and the attack sequence ends.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="27fc-c23f-28a9-0a7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="2282-b372-38e7-1908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="d8d3-6bf7-9b21-8e58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Chaos Mark: Slaanesh" id="5b82-0ba7-db61-82db" hidden="false">
      <profiles>
        <profile name="Chaos Mark of Slaanesh" id="bda2-7526-e654-66f0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models with this ability fight first in the Fighting phase.
If a enemy unit has an ability that makes to fight last, this ability nullifies it and both has no effect.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chaos Boon of the Excess" id="beae-2746-70ac-5d6a" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the unit of a model with this ability has Charged, have been Charged, or made an Heroic intervention, add 2 to the model&apos;s Attack characteristic. In addition, melee attacks against units with this ability must substract 1 for each Hit roll, and the Hit roll cannot be re-rolled.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="27fc-c23f-28a9-0a7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="2282-b372-38e7-1908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="d8d3-6bf7-9b21-8e58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="If the unit of a model with this ability has Charged, have been Charged, or made an Heroic intervention, add 3 to the model&apos;s Attack characteristic. In addition, melee attacks against units with this ability must substract 1 for each Hit roll, and the Hit roll cannot be re-rolled.">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="3b77-decb-d468-6bcc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Chaos Mark: Undivided" id="51da-3457-1b10-cb14" hidden="false">
      <profiles>
        <profile name="Chaos Boon of the Entropy" id="4aef-c27f-f36c-988c" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Substract 1 for each wound roll fom melee attacks against units with this ability.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="27fc-c23f-28a9-0a7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="2282-b372-38e7-1908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                    <condition childId="d8d3-6bf7-9b21-8e58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Chaos Mark of Entropy" id="062f-3515-0504-dc6c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Rolls of 2 in Morale test are treated as rolls of 1. 
Units affected by this ability are considered to be 3&quot; closer of friendly units in regard range-affected abilities.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Anhrathe" id="e4fb-5ce1-c38a-63ae" hidden="false">
      <profiles>
        <profile name="Martial training" id="682c-fdd1-9de4-5132" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against a INFANTRY or BIKER unit with this ability, a hit roll of 1-2 for that attack fails. 
Substract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Reavers of the Void" id="2f63-e47f-1880-9298" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes a ranged attack, if the target is within 12&quot;, and has not the VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
          </characteristics>
        </profile>
        <profile name="Masters of the close quarters" id="41a0-9def-e62c-d037" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute activates the ability Reavers of the Void, the hit roll of 6 that automatically wounds the target is treated as an unmodified wound roll of 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Battle focus" id="5cf5-5552-6554-b387" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">ANHRATHE INFANTRY and BIKER units are eligible to shoot in a turn in which it Advanced, but if it does so, then until the end of the phase, models in this unit can only make attacks with Assault or Pistol weapons they are equipped with, and when resolving those attacks, that unit is treated as having Remained Stationary.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Rillietann" id="a509-dda6-0e06-c75b" hidden="false">
      <profiles>
        <profile name="Swift beyond belief" id="0e64-48dd-7cc9-e74b" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against a INFANTRY or BIKER unit with this ability, a hit roll of 1-3 for that attack fails. 
Substract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Holofield" id="668b-feeb-6a72-2f5a" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">&lt;SAEDATH&gt; INFANTRY and BIKER models have a 5+ invulnerable save.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Gravitic belt." id="b7ef-9872-de76-5356" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time &lt;SAEDATH&gt; INFANTRY or BIKER units makes a Normal Move, Advances, Falls Back or makes a charge move, until that move is finished, models in this unit can move horizontally through models and terrain features (they cannot finish a move on top of another model, or its base).</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Rising crescendo" id="3e2b-3ef7-e7e3-e03e" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">SAEDATH INFANTRY or BIKER units are eligible to declare a charge in a turn in which it Advanced.
SAEDATH INFANTRY or BIKER units are eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Drukhari Servants" id="2f12-f4c0-1931-f355" hidden="false">
      <infoLinks>
        <infoLink name="Blade artists" id="5fcf-72e5-4e2a-6956" hidden="false" targetId="5bca-e02d-fb19-6cb7" type="profile"/>
        <infoLink name="Power from Pain" id="a579-f064-4044-9cce" hidden="false" targetId="8c4c-4d2f-6aa2-b7ec" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Volkite Weapon" id="3ef9-3ebd-bd6c-9f9d" hidden="false"/>
    <categoryEntry name="Defence Battery" id="4e3c-7805-755a-6bf1" hidden="false">
      <rules>
        <rule name="Defence Battery" id="dbc6-f7f2-a8a0-1146" hidden="false">
          <description>The first time this unit is set up, all models in this unit must be placed within 12&quot; of each other. From that point onwards, each operates independently and is treated as a separate unit for all rules purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Bomb Weapon" id="1528-91b6-dd4d-e036" hidden="false">
      <rules>
        <rule name="Bomb Weapon" id="ad78-1b77-eb97-fb0c" hidden="false">
          <description>Once per turn, after this model has made a Normal Move or has Fallen Back in your Movement phase, you can, either select one model it moved across, or place a marker in any point of the path of movement.
You can make attacks with one of the Bomb weapon options the unit has, when doing so, affecting each unit within the range indicated in the weapon&apos;s datasheet.
Bomb weapons cannot be used during the Shooting phase.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Summoner" id="4422-c496-629b-0521" hidden="false">
      <profiles>
        <profile name="[Action] Summon ritual" id="41ad-6e4b-7841-4a50" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit with the Summoner Keyword can do this action at the beggining of the Command phase, and it ends at the end of the Movement phase, before the Reinforcements step.
Roll 3D6, if you roll any double roll result, the unit making this action suffers 1 mortal wound. If you roll three rolls of the same result, the unit making this action suffers 1D3 mortal wounds.
Then, you can select, from the Chaos - Daemons library, up to two units without CHARACTER Keyword, without any upgrade, with a PL cost equal or lesser than half the result (rounding up), and set it up on the battlefield wholly within 12&quot; of the Summoner and 9&quot; away from enemy models, as reinforcements.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Orks" id="946d-1c4c-20d6-9eda" hidden="false">
      <profiles>
        <profile name="Mob rule" id="9c10-cab0-73fc-3c92" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Leadership characteristic of the unit is either the highest score in the unit&apos;s model&apos;s datasheet or the remaining number of models of the unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="&apos;Ere we go" id="ce1c-b500-8106-b321" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll charge rolls made for units with this ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Tyranids" id="a9de-36e3-d3ac-6337" hidden="false">
      <rules>
        <rule name="Synaptic link Range" id="48ea-de0b-ed1a-ded9" hidden="false">
          <description>When selecting a unit within Synaptic Link range of a &lt;HIVE FLEET&gt; SYNAPSE unit, you can select any unit that is within SYNAPSE range of that unit.
If, however, there are any other friendly &lt;HIVE FLEET&gt; SYNAPSE units that are also within SYNAPSE range of that unit, then you can instead select one of the units that is within SYNAPSE range of any of those &lt;HIVE FLEET&gt; SYNAPSE units.
If those &lt;HIVE FLEET&gt; SYNAPSE units also have other &lt;HIVE FLEET&gt; SYNAPSE units within SYNAPSE range of themselves, then they increase the area over which units can be selected from in the same manner. This continues for as long as there are friendly &lt;HIVE FLEET&gt; SYNAPSE units within SYNAPSE range.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Genestealer cults" id="f1f2-1cf5-3d5c-e63d" hidden="false">
      <infoLinks>
        <infoLink name="Death from Below" id="26ee-83cd-0dc7-6c97" hidden="false" targetId="90cf-c0c0-fbd5-5e92" type="profile">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="1"/>
                <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Endless assault" id="faf9-5906-2ad2-33d2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this ability is destroyed, if there is an ambush marker remaining in the battlefield, you can set up the unit again concealed in any ambush marker present in the battlefield.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="848a6ff2-0def-4c72-8433-ff7da70e6bc7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="primary-category" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Concealed" id="638b-dc8e-9b1b-adf7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, you can set up this unit in ambush instead of setting it up on the battlefield.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Chaos Servants" id="39bd-1989-42e4-056c" hidden="false">
      <rules>
        <rule name="Faction: Chaos Servants" id="c634-4d78-31ad-459c" hidden="false">
          <description>This Keyword counts as an Faction: Unaligned Keyword in regard army building.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Beam" id="e0a1-e75a-bb09-b142" hidden="false">
      <rules>
        <rule name="Beam" id="52d1-bafc-6b7f-9c59" hidden="false">
          <description>Each time an attack is made with this weapon, if a hit is scored, draw a straight line between the closest point of this model’s base (or hull) and that of the closest model in the target unit. Make one wound roll against the target unit, and each other unit this line passes over.</description>
          <modifiers>
            <modifier field="name" type="set" value="Beam weapon"/>
          </modifiers>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Ynnari" id="a898-c576-fd0c-3c21" hidden="false">
      <profiles>
        <profile name="Martial training" id="d4a2-4f84-efdb-8306" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against a INFANTRY or BIKER unit with this keyword, a hit roll of 1-2 for that attack fails. 
Substract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3d52-fccf-10c0-3fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                    <condition childId="1c6f-0311-3eba-3180" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Cult of the Death God" id="088e-3486-8102-6d0b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- At the start of the Fight phase, if a unit with this attribute is within Engagement Range of any enemy units, it can fight first that phase.
- Each time an attack is made by a model with this attribute, if that model’s unit is below its Starting Strength, add 1 to that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Combined transport" id="13e3-4915-f89b-b135" hidden="false">
      <rules>
        <rule name="Combined transport" id="1abd-3094-515d-f657" hidden="false">
          <description>This unit models are considered to share their combined transport capacity.
This means that a unit can embark within this unit even if it would normally exceed it&apos;s models individual transport capacity.
The embarked models are considered to be split between the multiple transports. Take note of which models are embarked on each model.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Assault ramp" id="d7c1-93c2-0c88-7c3c" hidden="false"/>
    <categoryEntry name="Splash" id="a1e8-34a8-13a9-7a54" hidden="false">
      <rules>
        <rule name="Splash" id="8ee5-8b59-ff9f-c8bf" hidden="false">
          <description>If a hit is scored against the target unit, select an enemy model from that unit.
Make D3 additional attacks against any other unit within 3&quot; of that model with the Splash weapon&apos;s profile.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Blast" id="a30d-0055-6710-6284" hidden="false">
      <rules>
        <rule name="Blast" id="3264-6e19-ff75-cfa1" hidden="false">
          <description>Blast weapons can never be used to make attacks against a unit that is within Engagement Range of the firing model’s unit.
If a Blast weapon targets a unit that has between 6 and 10 models, it always makes a minimum of 3 attacks for each dice used to determine the number of attacks.
When a Blast weapon targets a unit that has 11 or more models, make the maximum possible number of attacks.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Terminator Armour" id="a85f-24e5-cfc3-9345" hidden="false">
      <infoLinks>
        <infoLink name="Teleport Strike" id="4a62-e1ea-ec93-8116" hidden="false" targetId="6301-eaed-f948-13b8" type="profile"/>
        <infoLink name="Impervious to small weapons fire" id="a79a-4224-d824-79ad" hidden="false" targetId="b48e-9a4a-2fdc-5d7c" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Pariah" id="bc53-fe5a-4bab-fefd" hidden="false">
      <profiles>
        <profile name="Psychic Null" id="351d-9640-2b67-5fec" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot be affected by Psychic powers.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unsettling presence [Aura]" id="c566-fcf3-2313-e441" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- While a unit that doesn&apos;t share the same Faction Keywords with this unit is within 12&quot; of it, the Leadership characteristic of it&apos;s models is reduced by 1.
- Any PSYKER unit within 12&quot; of this unit substracts 1 to any Psychic test and suffers Perils of the Warp on any dice roll that includes a double, instead of only a double 1 or double 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp&apos;s Anathema [Aura]" id="6f8c-67fd-2bf6-2470" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any DAEMON or DAEMONIC unit within 6&quot; of this unit suffers D3 Mortal wounds in each Command phase.
While a unit is within 6&quot; of this unit, it loses the following abilities:
- Chaos Mark
- Chaos Boon
- Synapse
- Any active Psychic Blessing
- Any active Psychic Malediction
- Otherworldly being
- Warp infused
- Favored by Tzeentch</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Talons of the Emperor" id="cee0-4459-2f94-b827" hidden="false"/>
    <categoryEntry name="Ordo Hereticus" id="2981-f499-19fc-bc80" hidden="false">
      <profiles>
        <profile name="Ordo Hereticus" id="2604-c2ec-4ea4-675e" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a CHAOS, GENESTEALER CULTS or PSYKER unit, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Heretics bane" id="fdd2-9a98-2659-547e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a unit with CHAOS, GENESTEALER CULTS or PSYKER Keywords, re-roll a hit roll of 1.
Add 1 to the Charge rolls of this unit if the target of that charge has CHAOS, GENESTEALER CULTS or PSYKER Keywords.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Necrons" id="7d00-3cab-35df-e030" hidden="false">
      <profiles>
        <profile name="Living Metal" id="945f-32e2-4ad4-420c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Command phase, each unit regains up to 1D3 lost wounds.
For each Wound that can be regained, restore one Wound of one Model within the unit that have less Wounds remaining that it&apos;s Wounds Characteristic. 
If all the models within the unit have all it&apos;s Wounds, but the unit it&apos;s not at it&apos;s Starting Strength, one destroyed model is returned with one Wound remaining.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mechanical endurance" id="ff2f-1948-6fdd-78f9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this model, subtract 1 from the Damage characteristic of that attack (to a minimum of 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Defence protocols" id="6ca8-eb37-dcf3-9a78" hidden="false">
          <description>When a unit from Faction: Necrons fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+.
If the unit has the INFANTRY Keyword and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
        <rule name="Reanimation Protocols" id="0240-7e73-185c-f0f2" hidden="false">
          <description>Each time an enemy unit shoots or fights, after it makes its attacks, if any models in this unit were destroyed as a result of those attacks but this unit was not destroyed, this unit&apos;s reanimation protocols are enacted and those destroyed models begin to reassemble.

Each time a unit&apos;s reanimation protocols are enacted, make Reanimation Protocol rolls for that unit by rolling a number of D6 equal to the combined Wounds characteristics of all the reassembling models. Each Reanimation Protocol roll of 5+ is put into a pool. A Reanimation Protocol roll can never be modified by more than -1 or +1.

If the number of dice in that pool is greater than or equal to the Wounds characteristic of any of the reassembling models, select one of those models to be Reanimated. A Reanimated model:
- Is added back to its unit with its full wounds remaining.
- Can only set up within Engagement Range of enemy units that are already within Engagement Range of the Reanimated model&apos;s unit.
- Cannot, if it is your Charge phase, be set up closer to any enemy units that are targets of a charge declared by its unit this phase.
- No longer counts as having been destroyed for the purposes of Morale tests this turn.

You then reduce the number of dice in that pool by a number equal to the Wounds characteristic of the Reanimated model and repeat this process until either there are no more reassembling models, or the number of dice remaining in the pool is less than the Wounds characteristic of any of the reassembling models. Any models that did not Reanimate fail to reassemble, and any dice remaining in the pool are discarded.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Airborne Predator" id="7468-bb7b-3ad0-2c43" hidden="false"/>
    <categoryEntry name="Faction: Leagues of Votann" id="19cc-753a-2747-0898" hidden="false">
      <rules>
        <rule name="CQB training" id="d0b7-b98e-5af6-3265" hidden="false">
          <description>When a unit from Faction: Leagues of Votann fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+.
If the unit has the INFANTRY Keyword and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
        <rule name="Eye of the Ancestors" id="9a33-d3ba-4d5e-ab9f" hidden="true">
          <description>Judgement tokens.
Each time a VOTANN model from your army makes an attack against a unit that has one or more Judgement tokens, apply the applicable bonus from the table below to that attack.
1 JT ---&gt; Priority Target Identified: You can re-roll Wound rolls of 1.
2 JT ---&gt; Eminent Threat: You can ignore any or all Hit roll modifiers.
3 JT ---&gt; Now We’ve Got a Grudge to Settle: You can re-roll the Hit roll.

Gaining Judgement tokens.
Enemy units will gain Judgement tokens (to a maximum of 3) throughout the battle as follows:
- Each time an enemy unit destroys a VOTANN unit from your army, that enemy unit gains 1 Judgement token.
- Each time an enemy unit successfully completes an action or a psychic action within 12&quot; of a VOTANN unit from your army, it gains 1 Judgement token.
- At the end of each of your opponent’s turns, you can select one enemy unit within range of an objective marker that your opponent controls and were controled by you in the previous turn. That unit gains 1 Judgement token.

If a unit with any Judgement tokens is removed from the battlefield (e.g. because it embarked on a TRANSPORT, is entering Strategic Reserves, etc.) make a note of how many Judgement tokens it had when it was removed. If that unit is set up on the battlefield again, place the corresponding number of Judgement tokens next to it again.

If a unit with one or more Judgement tokens splits up into two or more smaller units, each of those units gains a number of Judgement tokens equal to that of the original unit. If two or more units combine to form a single large unit, and any of those units had one or more Judgement tokens, make a note of how many are on the unit with the most just before they combined - the new larger unit has a number of Judgement tokens equal to this.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Psychic Weapon" id="c255-697b-b3ac-c826" hidden="false">
      <rules>
        <rule name="Psychic Weapon" id="632b-f9ac-8077-5272" hidden="false">
          <description>Attacks with this weapon have the rule INDIRECT FIRE when targeting enemy units within half of the maximum range of the weapon</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Faction: Dark Mechanicum" id="e851-7bcc-dd32-dc00" hidden="false">
      <rules>
        <rule name="Defence tactics" id="5dca-0e6e-6b5a-da34" hidden="false">
          <description>When a unit from Faction: Dark Mechanicus fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+.
When a INFANTRY  or INORGANIC BEAST unit from Faction: Dark Mechanicus fires Overwatch or Searching for Targets and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Automata" id="5d6c-12da-407d-ff32" hidden="false">
      <comment>5d6c-12da-407d-ff32</comment>
      <profiles>
        <profile name="Mechanic resilience" id="cc78-0dea-47d4-a8d1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit would lose a wound, roll one D6: on a 6+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Cognis weapon" id="4293-c67b-6fec-89a8" hidden="false">
      <comment>4293-c67b-6fec-89a8</comment>
      <rules>
        <rule name="Cognis weapon" id="358b-1579-2fe9-aee1" hidden="false">
          <description>Re-roll hit rolls of 1 each time a COGNIS WEAPON is selected to make any attacks.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Radium weapon" id="a9a5-a716-6444-034e" hidden="false">
      <rules>
        <rule name="Radium weapon" id="6d8d-a8e5-dad3-2453" hidden="false">
          <description>Each time an attack is made with RADIUM weapons against an enemy unit without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Torrent" id="795f-a8d3-dc18-cb2e" hidden="false">
      <rules>
        <rule name="Torrent" id="0ab2-052b-fb3f-7ed4" hidden="false">
          <description>Each time an attack is made with this weapon, that attack automatically hits the target.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Anathema Psykana" id="d553-2aae-77fc-b50a" hidden="false">
      <comment>d553-2aae-77fc-b50a</comment>
      <rules>
        <rule name="CQB training" id="9372-4c23-efb6-f1c2" hidden="false">
          <description>When a unit from Anathema Psykana fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+ instead of a 6.
If the unit has the INFANTRY Keyword and is in a terrain with the DEFENSIBLE trait, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Monster pack" id="d0c7-0b01-3021-cc38" hidden="false">
      <rules>
        <rule name="Monster pack" id="c204-a36d-ef97-e116" hidden="false">
          <description>The first time this unit is set up, all models in this unit must be placed within 6&quot; of each other. From that point onwards, each operates independently and is treated as a separate unit for all rules purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Platoon" id="1724-9147-143d-875e" hidden="false">
      <rules>
        <rule name="Platoon" id="59af-5b42-a6a9-b9be" hidden="false">
          <description>The first time this unit is set up, all squads in this unit must be placed within 3&quot; of each other. From that point onwards, each squad operates independently and is treated as a separate unit for all rules purposes.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Icarus mount" id="1f9d-db7b-1926-9dfa" hidden="false">
