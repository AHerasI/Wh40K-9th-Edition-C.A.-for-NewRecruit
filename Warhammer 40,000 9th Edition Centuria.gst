                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When an enemy unit is set up on the battlefield as Reinforcements, you can select one friendly ORDO HERETICUS CORE unit within 12&quot; of this WARLORD. The selected unit can shoot at that enemy unit as if it were your Shooting phase.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
