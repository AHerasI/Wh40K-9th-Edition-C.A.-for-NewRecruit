              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Assault Drill [1] (8+ Wounds remaining)" id="87e4-f78d-a9d1-4033" hidden="false" typeId="800f-21d0-4387-c943" typeName="Model">
