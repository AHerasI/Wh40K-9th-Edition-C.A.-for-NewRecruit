    <profile name="Omni-scrambler" id="a3fa-e298-db4d-642f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy units that are set up on the battlefield as reinforcements cannot be set up within 12&quot; of this unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Turbo-boost" id="7f7b-4afb-4694-7434" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model Advances, add 6&quot; to its Move characteristic for that Movement phase instead of rolling a dice.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Shield" id="2162-abc8-c255-f1f8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
