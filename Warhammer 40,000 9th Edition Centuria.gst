          </costs>
          <profiles>
            <profile name="Experience Point" id="109c-4c5a-0906-64c6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit gains an EXP point each time it ends an acomplished mission being deployed in the battlefield at least once.
In addition, a unit gain a extra EXP point if it managed to do one of the following during the battle:
- Destroy at least 2 enemy units.
- Acomplish at least 1 tactical objectives.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
