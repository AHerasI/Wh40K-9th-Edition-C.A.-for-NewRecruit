                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Regiment of renown" id="6c8b-6667-cd3a-06e8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Purchase this Requisition when you add a ASTRA MILITARUM Detachment to your army.
You can select a Regiment of renown as a Regimental Doctrine.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
