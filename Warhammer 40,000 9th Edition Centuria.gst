        <profile name="Daemon Hunters" id="582c-326f-7844-fd4b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a unit with CHAOS, DAEMON or DAEMONIC Keyword, re-roll a hit roll of 1.
In addition ORDO MALLEUS units ignore Daemonic Terror Ability.</characteristic>
          </characteristics>
