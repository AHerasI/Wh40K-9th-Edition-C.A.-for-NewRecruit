              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Faction: Chaotic Astartes" id="b096-59fd-a5eb-5739" hidden="false">
      <rules>
        <rule name="Let the Galaxy burn" id="a1dd-4985-1893-b97e" hidden="true">
          <description>Each time a model in a unit with this Keyword shoots with a flame weapon, when determining how many attacks are made with that weapon this phase, add 2 to the result (e.g. a model shooting with a flamer makes D6+2 attacks).</description>
        </rule>
        <rule name="CQB training" id="bfd7-d54a-d763-f947" hidden="false">
          <description>When a unit from Faction: Chaotic Astartes fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+.
If the unit has the INFANTRY Keyword and is in a DEFENSIBLE terrain feature, it scores a hit on a unmodified roll of 3+.</description>
        </rule>
      </rules>
    </categoryEntry>
