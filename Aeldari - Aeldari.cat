                <constraint id="ebe2-c488-ab0e-bc8d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="1 - Assail" id="5a4c-7f58-968c-12f4" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Assail" id="2302-4901-0f6c-4eab" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: Assail has a warp charge value of 6. If manifested, select one enemy unit within 12&quot; and visible for this PSYKER. That unit suffers D3 mortal wounds.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="2 - Flame Blast" id="0394-2fdf-5673-debd" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Flame Blast" id="3fe5-3b26-5254-7d19" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: Flame Blast has a warp charge value of 7. If manifested, select one enemy unit within 12&quot; and visible for this PSYKER. Roll a D6 for each model in that unit, on a 5+ the target unit suffers 1 mortal wound.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="3 - Freeze Time" id="7eba-1ea5-4a7a-2367" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Freeze Time" id="c37a-f4bc-fedc-0258" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">8</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Freeze Time has a warp charge value of 8. If manifested, until the start of your next Psychic phase, when a model in the PSYKER&apos;s unit is destroyed, if it does not explode, instead of using any other abilities that take effect as a result of a model being destroyed, that model is not removed from play until the start of a morale phase. 
Until that happens, that model is still considered to be in play, but no further attacks can be allocated to it.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="4 - Weapon Jinx" id="a878-0a89-9ad9-0d8c" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Weapon Jinx" id="9a27-8c2f-ce63-49c5" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction: Weapon Jinx has a Warp charge of 6. If manifested, select one enemy unit within 12&quot; of this PSYKER. Until the start of your next Psychic phase, substract 1 from the number of attacks made by ranged weapons of models in that unit (to a minimun of 1).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="5 - Terrify" id="9d5c-80ea-ede2-4367" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Terrify" id="ab91-d7aa-83e9-e73a" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">8</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction: Terrify has a Warp charge of 8. If manifested, select one enemy unit within 12&quot; of this PSYKER. Until the start of your next Psychic phase:
- Subtract 2 from the Leadership characteristic of that unit.
- At the start of the Fight phase, if that unit is within Engagement Range of any units from your army, that unit is not eligible to fight this phase until after all eligible units from your army have done so.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="6 - Quicken" id="500c-c05a-8d8e-c89f" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Quicken" id="6f60-2072-1a96-893b" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                      <characteristics>
                        <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                        <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                        <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Quicken has a warp charge value of 7. If manifested, the PSYKER&apos;s unit can immediately make a Normal Move, Advance or Fall Back as if it were the Movement phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
