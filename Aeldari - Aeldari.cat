    <categoryEntry name="Support plattform" id="1592-ecbc-18f4-e28a" hidden="false">
      <rules>
        <rule name="Crewed Platform" id="0a76-169e-c147-2c10" hidden="false">
          <description>When the last INFANTRY model in this unit is destroyed, any remaining Support plattform models in this unit are also destroyed.Support plattform models are not counted when determining a unit’s Starting Strength, or whether that unit is below Half-strength. The destruction of Support plattform models is ignored for the purposes of Morale tests.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Drukhari Cult" id="3a61-d37b-c578-6715" hidden="false"/>
    <categoryEntry name="Drukhari Kabal" id="395b-75d9-5ac9-7a81" hidden="false"/>
