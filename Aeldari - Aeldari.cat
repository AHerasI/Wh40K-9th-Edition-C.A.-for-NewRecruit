<catalogue name="Aeldari - Aeldari " id="660d-ebea-6c82-200b" authorContact="Centuria Astartes Discord" authorName="A. Heras" authorUrl="Centuria Astartes Discord" battleScribeVersion="2.03" gameSystemId="5b78-3a13-0882-b019" gameSystemRevision="4" library="false" revision="2" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <readme>Inspired from the original Warhammer 40,000 9th Edition database, created by BSData Developers, @WH40k Data Dev, from https://www.bsdata.net/contact.

Additional reference data obtained from Wahapedia, https://wahapedia.ru/</readme>
  <categoryEntries>
    <categoryEntry name="Shuriken weapon" id="3fbb-02be-3bb6-a18b" hidden="false">
      <rules>
        <rule name="Shuriken weapon" id="8635-5954-c2e8-a8b1" hidden="false">
          <description>Each time an attack is made with a shuriken weapon, on an unmodified wound roll of 6, improve that attack’s Armour Penetration characteristic by -2.</description>
        </rule>
      </rules>
    </categoryEntry>
    <categoryEntry name="Poisoned weapon" id="7512-bcba-18b0-eadc" hidden="false">
      <rules>
        <rule name="Poisoned weapon" id="c98f-2097-7769-8a38" hidden="false">
          <description>Each time an attack is made with a Poisoned weapon against a unit (excluding INORGANIC, VEHICLE or TITANIC units), an unmodified wound roll of the value beside is always successful.</description>
        </rule>
      </rules>
    </categoryEntry>
