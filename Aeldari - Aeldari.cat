      </infoLinks>
      <profiles>
        <profile name="Nightfury Clan" id="1f41-5dd7-560f-4cc5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an attack is made against this model, if the attacker is more than 12&quot; away, this model benefits of Light Cover and Dense Cover against that attack.
- Each time this model would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7fe0-e12e-cdd0-19bd" childName="Nightfury Clan" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Sabre-claw Clan" id="4123-8281-f49a-604e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack with a melee weapon, an unmodified hit roll of 6 scores 1 additional hit, and you can re-roll Advance rolls and Charge rolls.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="2684-2c81-68de-eabd" childName="Sabre-claw Clan" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Sea-talon Clan" id="3635-ed2e-d01e-3b4c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a melee attack, on an unmodified wound roll of 6, add 1 to the Damage characteristic of that attack, and, if is not at it&apos;s Starting Strength, add 1 to that attack’s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="dc81-9158-5533-d57a" childName="Sea-talon Clan" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Swifthorn Clan" id="1708-c167-53dd-91b3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unless Fell Back during this turn, during the Shooting phase, this model is considered to have Remained Stationary, and, each time this model makes a ranged attack, the target does not receive the benefits of Cover against that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="367c-c72c-8351-4f85" childName="Swifthorn Clan" field="selections" includeChildSelections="true" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
