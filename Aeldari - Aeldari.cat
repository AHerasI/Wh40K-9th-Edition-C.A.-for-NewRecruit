              <profiles>
                <profile name="Shards of Light" id="f60c-3f67-7736-ad72" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: Shards of Light has a warp charge value of 6. If manifested, select one enemy unit within 18&quot; of and visible to this PSYKER.
- That enemy unit suffers 1 mortal wound. If it is a VEHICLE or MONSTER unit, or a unit that contains 6 or more models, it suffers D3 mortal wounds instead.
- Until the start of your next Psychic phase, subtract 2 from the Leadership characteristic of models in that enemy unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="6 - Webway Dance" id="4de8-d6d8-bb6e-f071" collective="false" hidden="false" import="true" type="upgrade">
