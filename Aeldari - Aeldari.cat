                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Diviners of fate" id="3772-1de2-13eb-a0b4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you make a Strands of Fate roll, you can double the amount of dices rolled.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
