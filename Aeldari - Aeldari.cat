      <profiles>
        <profile name="Wave Serpent shield" id="83d4-f511-cb01-3426" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is equipped with a Wave Serpent shield:
- This model has a 5+ invulnerable save against ranged attacks.
- Each time a ranged attack of strength 8 or less is made against this model, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wave Serpent" id="8759-b41e-960e-f027" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 12  YNARII INFANTRY, ANHRATHE INFANTRY or ASURYANI INFANTRY or BEAST models. Each WRAITHBONE model takes the space of two INFANTRY models. It cannot transport JUMP PACK models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
