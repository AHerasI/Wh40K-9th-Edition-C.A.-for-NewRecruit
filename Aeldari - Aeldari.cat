            </modifier>
          </modifiers>
        </profile>
        <profile name="Interceptor" id="1587-50c1-ee30-5393" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack against a unit with the AIRCRAFT Keyword. ignore the Hard to hit rule.</characteristic>
          </characteristics>
