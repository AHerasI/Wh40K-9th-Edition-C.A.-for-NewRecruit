              <profiles>
                <profile name="Lord of Crystal Bones" id="8f39-b1f4-236e-f119" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model shoots, if any hits are scored, unless the target is a VEHICLE, TITANIC or MONSTER unit, until the start of your next turn:

- Subtract 2&quot; from the Move characteristic of models in the target unit (to a minimum of 0&quot;).
- The target cannot fire Overwatch or Set to Defend.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Rift Ghoul" id="a3f1-2572-5f84-b4e7" collective="false" hidden="true" import="true" type="upgrade">
              <constraints>
                <constraint id="42e9-b883-29a8-d4a5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
