        <profile name="Tantalus Aethersails" id="f36a-e6e7-5ee1-bbe2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model Advances, do not make an Advance roll. Instead, until the end of the phase, add 12&quot; to the Move characteristic of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scything Charge" id="0e2f-fe57-c745-0032" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model finishes a charge move, roll one D6 for each enemy unit within Engagement Range of it: on a 4+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
