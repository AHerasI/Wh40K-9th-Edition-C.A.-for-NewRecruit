                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Aspect of the Spear [Aura]" id="1b25-c814-0dca-d58e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a friendly ASPECT WARRIOR unit made a charge move this turn while it was within 6&quot; of this AUTARCH model, each time a model in that unit makes a melee attack, add 1 to that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aspect of the Spider" id="7972-7b17-031c-6edd" collective="false" hidden="false" import="true" type="upgrade">
