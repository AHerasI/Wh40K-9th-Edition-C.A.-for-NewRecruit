                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 3&quot; to the Range characteristic and 1 Attack to shuriken weapons a unit with this attribute are equipped with.</characteristic>
