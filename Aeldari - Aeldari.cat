      <profiles>
        <profile name="Children of the Open skies" id="328d-9db2-241e-de41" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an Advance roll is made for a unit with this attribute, treat a dice roll of 1-2 as 3 instead.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="bb21-30f8-d7e1-cdb9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Students of Vaul" id="f9c3-c082-7446-f384" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack with Strength characteristic of 7 or less is allocated to a VEHICLE model with this attribute, add 1 to any armour saving throws made against that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="instanceOf" value="0"/>
                        <condition childId="c8fd-783f-3230-493e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
                      </conditions>
