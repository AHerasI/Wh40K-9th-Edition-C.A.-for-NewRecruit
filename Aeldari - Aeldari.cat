                              <profiles>
                                <profile name="Children of Khaine" id="2ade-bba0-775e-08fe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack, on an unmodified wound roll of 6, add 1 to the Damage characteristic of that attack.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Children of Morai-heg" id="3ce6-5ded-f6b1-dc0a" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="16f7-67bc-e1c4-91cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Children of Morai-heg" id="8251-90ef-cdb9-fbe7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack, if that model’s unit is below its Starting Strength, add 1 to that attack’s hit roll.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Children of Prophecy" id="c350-12e8-8123-cb35" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="b131-4a85-52e3-8e31" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Children of Prophecy" id="1e26-48e9-9b1c-eddf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test or Deny the Witch test is taken for a PSYKER unit with this attribute, you can re-roll any or all dice results of 1-2.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Children of the Open skies" id="bb21-30f8-d7e1-cdb9" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="e0d5-4a1d-2ab4-3820" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
