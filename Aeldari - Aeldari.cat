          <selectionEntries>
            <selectionEntry name="1 - Favour of Cegorach" id="91fa-5e8c-fbce-12ea" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6501-056c-9001-f863" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
