              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly STRIKING SCORPIONS unit is within 6&quot; of this model, add 2 to the Leadership characteristic of models in that unit and that unit has the Objective Secured ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Sustained Assault" id="f5ea-4df7-a2bc-1bff" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made by this model, an unmodified hit roll of 6 scores 1 additional hit.</characteristic>
              </characteristics>
            </profile>
            <profile name="The Scorpion’s Bite" id="9bae-8e79-87fd-bdf8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer makes a melee attack that targets a unit without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified wound roll of 6 inflicts 2 mortal wounds on the target in addition to any normal damage.</characteristic>
              </characteristics>
            </profile>
