    <profile name="Reavers of the Void" id="bb84-c0d7-f47f-72af" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes a ranged attack, if the target is within 12&quot;, and has not the VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
      </characteristics>
