        <profile name="Fade Away" id="9b91-57d9-25b5-eb94" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Movement phase, if this unit is within 12&quot; of the edge of the battlefield, you can remove it from the battlefield and then, in the Reinforcements step of your next Movement phase, you can set this unit back up wholly within 12&quot; of the edge of the battlefield and more than D3+6&quot; from any enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shade Weavers" id="e671-ec1c-bcb1-3a09" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot be targeted by ranged attacks unless the attacking model is within 18&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
