                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- At the start of the Fight phase, if a unit with this attribute is within Engagement Range of any enemy units, it can fight first that phase.
- Each time an attack is made by a model with this attribute, if that model’s unit is below its Starting Strength, add 1 to that attack’s hit roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
