          </modifiers>
        </profile>
        <profile name="Connoisseurs of pain" id="0370-9af3-9ae9-b19e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- At the start of your Command phase, this unit regains 1 lost wound.
- Each time an attack of strength 7 or less is made against a unit with this attribute, a wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
          </characteristics>
          <modifiers>
