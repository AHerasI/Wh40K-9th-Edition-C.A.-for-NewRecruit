                    <condition childId="f3b7-baae-999e-6b41" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Wrath of the dead" id="d92f-5cdc-335e-72c5" hidden="true" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">WRAITHBONE BEAST or MONSTER units with this attribute are eligible to perform Heroic Interventions as if they were a CHARACTER unit.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditionGroups>
                        <conditionGroup type="or">
                          <conditions>
                            <condition childId="bbdb-5d3a-4cf8-3a73" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="instanceOf" value="0"/>
                            <condition childId="bbdb-5d3a-4cf8-3a73" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="false" type="instanceOf" value="0"/>
