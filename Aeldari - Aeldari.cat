              </modifiers>
              <profiles>
                <profile name="Spectre of Despair" id="a6da-7677-fb6d-ea11" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- During deployment, you must set up this model haunting the foe instead of setting it up on the battlefield. In the Reinforcements step of one of your Movement phases, you can set this model up anywhere on the battlefield that is more than 9&quot; away from any enemy models.
- Each time a charge roll is made for this model, roll one additional D6 and discard one of the dice.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
