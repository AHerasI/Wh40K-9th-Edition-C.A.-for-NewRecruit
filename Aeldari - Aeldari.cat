              <profiles>
                <profile name="Aspect of the Avenger [Aura]" id="ff02-a59c-e8a9-325a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ASPECT WARRIOR unit is within 6&quot; of this AUTARCH model, that unit gains the Objective Secured ability. If that unit already has the Objective Secured ability, each remaining Wound of models in this unit count as having an additional Wound when determining control of an objective marker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aspect of the Spectre" id="eb1f-9472-c1c7-4ad6" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0198-350b-772d-9cef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Aspect of the Spectre [Aura]" id="ab16-2678-9e56-b41d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an enemy model is destroyed by a melee attack made by a friendly ASPECT WARRIOR unit within 6&quot; of this AUTARCH model, until the end of the turn it&apos;s unit must substract 1 from any Attrition test taken.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aspect of the Dragon" id="c673-e7f3-496d-e47d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fb22-e18c-9cd8-be7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
