                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD would lose a wound as the result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Towering arrogance [Aura]" id="508f-d082-3f3d-3827" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly KABAL OF THE POISONED TONGUE unit is within 6&quot; of this WARLORD, each time a Combat Attrition test is taken for that unit, ignore any or all modifiers.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
