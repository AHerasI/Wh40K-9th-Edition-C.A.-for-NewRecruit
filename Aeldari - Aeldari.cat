                              </costs>
                              <profiles>
                                <profile name="Slashing impact" id="d969-ab20-bbcb-924a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute finishes a charge move, you can select one enemy unit (excluding VEHICLE or TITANIC units) within Engagement Range and roll one D6: on a 6, that enemy unit suffers 1 mortal wound.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Stimulant Innovators" id="9e49-3ca9-6cef-9a3a" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="d3ed-d955-bdb5-3b08" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Stimulant Innovators" id="8531-1263-69d9-4dd6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Once per battle, in your Command phase, you can declare that units with this attribute will use their experimental concoctions. When you do so, roll one D6 on the Combat Drugs table or select one from it. 
- Every unit with this attribute that has the Combat Drugs ability gains this additional ability (which is cumulative with any abilities they already have) until the end of the turn.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Test of skill" id="3938-8348-b276-3992" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="a5b5-156e-86fc-732e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Test of skill" id="f6aa-9a67-2e43-21d7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes a melee attack that targets a MONSTER or VEHICLE unit, add 1 to that attack’s wound roll.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Trophy Takers" id="dcba-1da1-c598-e480" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="8f96-3ddd-69e0-6475" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Trophy Takers" id="9042-f8ec-1179-e7d2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Morale test is taken for an enemy unit that had any models destroyed by a melee attack made by a unit with this attribute, roll one additional D6 and discard the lowest result.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Acrobatic Display" id="2cd9-f22d-84a9-921e" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="afc5-0be3-c211-003f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Acrobatic Display" id="3cdb-6d83-bdad-b27c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a imit with this attribute consolidates or piles in, models in that unit can move horizontally through other models and terrain features (they cannot finish a move on top of another model, or its base).</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                          </selectionEntries>
                        </selectionEntryGroup>
                      </selectionEntryGroups>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup name="Haemonculus coven" id="c489-1c45-83bd-6856" collective="false" defaultSelectionEntryId="5077-d11c-a001-c148" hidden="false" import="true">
                  <constraints>
                    <constraint id="7fcf-0b04-f807-3520" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="7365-24f6-86ce-c2b8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <selectionEntries>
                    <selectionEntry name="Coven of the twelve" id="5077-d11c-a001-c148" collective="false" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="Pts" typeId="points" value="0"/>
                        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Butchers of flesh" id="04d5-1126-b9fe-b572" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a model with this attribute makes an attack with a melee weapon (excluding Relics), improve the Damage characteristic of that attack by 1.
- If a unit with this attribute is performing an action, it can still make attacks with ranged weapons without that action failing.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="The dark creed" id="4990-d27d-16f9-ede4" collective="false" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="Pts" typeId="points" value="0"/>
                        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Distillers of fear" id="fb6b-86c0-f149-bbe7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this attribute have the following abilities:

Aura of Terror [Aura]: While an enemy unit is within 6&quot; of a unit with this attribute , subtract 1 from the Leadership characteristic of models in that unit, and subtract 1 from Combat Attrition tests made for that unit.

Each time you make a melee attack for a unit with this attribute that targets a unit with a Leadership characteristic that is equal to or lower than the attacking units Leadership characteristic, add 1 to that attack’s hit roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="The prophets of flesh" id="536d-8dd4-13d4-7bf0" collective="false" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="Pts" typeId="points" value="0"/>
                        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Connoisseurs of pain" id="3391-ae75-77f2-49db" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Command phase, each CHARACTER, GROTESQUES or MONSTER unit with this attribute regains 1 lost wound.
Each time an attack of strength 7 or less is made against a unit with this attribute, a wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Other covens" id="fae8-8fa3-4e96-ef97" collective="false" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="Pts" typeId="points" value="0"/>
                        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                      </costs>
                      <selectionEntryGroups>
                        <selectionEntryGroup name="Coven Attributes" id="3b39-0767-2af7-ee4d" collective="false" hidden="false" import="true">
                          <constraints>
                            <constraint id="ee7d-4600-a58a-455f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
                            <constraint id="f55f-35cb-06ce-4b4e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="2"/>
                          </constraints>
                          <selectionEntries>
                            <selectionEntry name="Obsessive Collectors" id="edd5-71b2-1adb-e517" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="2d9b-e2a2-bc9c-78b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Obsessive Collectors" id="9ce1-e9d5-7acd-a294" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an enemy unit is destroyed by a melee attack made by a unit with this attribute, a model in that attacking unit can regain D3 lost wounds. 
Each model can only be healed once per turn. 
- If the attacking unit is a WRACK unit, D3 destroyed models can be added back to the unit. These models can only be set up within Engagement Range of enemy units that are already within Engagement Range of this unit and no longer count as having been destroyed for the purposes of Morale tests this turn.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Dark Harvest" id="b53c-4ef9-bd24-71ca" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="4cf5-5f55-55e9-6a24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Dark Harvest" id="8282-83b3-87f7-e018" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this attribute finishes a charge move, you can select one enemy unit (excluding INORGANIC, VEHICLE and TITANIC units) within Engagement Range and roll one D6: on a 4+, that enemy unit suffers 1 mortal wound.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Dark Technomancers" id="dcbc-5ef1-52b4-49e5" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="fce0-6c0a-a986-9dc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Dark Technomancers" id="65ef-4980-fabf-c462" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a unit with this attribute is selected to shoot, you can enhance any or all ranged weapons models in that unit are equipped with (liquifier guns and twin liquifier guns can never be enhanced). 
- If you do so, until the end of the phase, each time an attack is made with an enhanced weapon, add 1 to that attack’s wound roll and add 1 to the Damage characteristic of that attack, but that attack’s hit roll cannot be re-rolled. 
- If any unmodified hit rolls of 1 are made for attacks with an enhanced weapon, the bearer’s unit suffers 1 mortal wound after shooting with this weapon. If the bearer is a VEHICLE or MONSTER model, it suffers D3 mortal wounds instead.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Experimental Creations" id="5b60-f651-b714-f7d1" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="8e27-5bb6-0f1f-bc2e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Experimental Creations" id="bc9b-8b9d-c3a9-111b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Strength characteristic of models with this attribute.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Enhanced Sensory Organs" id="f638-279c-20a7-d35c" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="69d2-cc68-3d91-c53b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Enhanced Sensory Organs" id="71e5-137c-a069-ccfa" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack, the target does not receive the benefits of Light Cover or Heavy Cover against that attack.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Hungry for Flesh" id="891b-854f-e000-1254" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="67ef-8afd-dd61-5a0a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Hungry for Flesh" id="5cba-3c75-68dd-5fc0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll charge rolls made for units with this attribute.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Masters of Mutagens" id="f8b4-9097-6c4d-be95" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="100f-8d42-0ee4-eee2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Masters of Mutagens" id="4fee-46b6-470c-e6c0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes a melee attack with a poisoned weapon that targets a unit that is not INORGANIC, VEHICLE or TITANIC, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Artists of the Flesh" id="fcb5-c571-4885-62b2" collective="false" hidden="false" import="true" type="upgrade">
                              <constraints>
                                <constraint id="d44d-d92b-8918-d720" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                              </constraints>
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Artists of the Flesh" id="44b7-dbb2-5042-91c5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to a model with this attribute (excluding VEHICLE models), unless that attack has a Strength characteristic of 8 or more, subtract 1 from the Damage characteristic of that attack (to a minimum of 1).</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
