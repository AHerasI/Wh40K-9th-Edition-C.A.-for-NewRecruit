    <selectionEntry name=" Stratagem List" id="936e-fcae-bcfd-2a63" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="1CP Command re-roll" id="4c90-4087-3bbd-3f47" collective="false" hidden="false" import="true" targetId="5988-c6f8-e6da-239c" type="selectionEntry"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 - Before battle" id="6121-fa6d-2a5b-9dc8" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="3/1CP Webway Strike" id="9b65-c9d7-20b3-3337" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bef4-8a31-a39c-9d6a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="3/1CP Webway Strike" id="defc-76fb-45f3-c75a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem before the battle, when declaring reserves and transports (if you are playing a mission without this step, use this Stratagem during deployment instead). You can spend 1CP to set up one AELDARI INFANTRY or AELDARI BIKER unit from your army in the webway instead of setting it up on the battlefield each.
In the Reinforcements step of one of your Movement phases, you can set up any units in the webway anywhere on the battlefield that is more than 9&quot; away from any enemy models.
You can use this Stratagem up to 3 times.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Insidious Misdirection" id="e074-749f-5ffa-66bf" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Poisoned Tongue</comment>
              <constraints>
                <constraint id="762a-e0aa-3482-7998" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="8cce-3ddd-1ecb-6b49" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Insidious Misdirection" id="e82c-724c-cc7e-d9da" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the first battle round. Select up to three KABAL OF THE POISONED TONGUE units from your army and redeploy them. If the mission uses the Strategic Reserves rules, any of those units can be placed into Strategic Reserves without having to spend any additional CPs, regardless of how many units are already in Strategic Reserves. If both players have abilities that redeploy units, roll off; the winner chooses who redeploys their units first.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="2 - Command Phase" id="b1bf-38c4-7eb7-debe" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Agents of Vect" id="cc1f-838e-4f58-8a6a" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Black Hearth</comment>
              <constraints>
                <constraint id="57c3-f268-fb29-b992" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="fc3d-c302-a5a0-5730" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Agents of Vect" id="c2f6-a734-2e09-24e2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem after your opponent uses a Stratagem (excluding Command Re-roll). Until the end of the battle, the CP cost your opponent must pay to use that Stratagem again is increased by 1. This Stratagem can only be used once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Guided Wraithsight" id="35ba-c8b3-1938-f6c1" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Iyanden</comment>
              <constraints>
                <constraint id="fe0b-ae24-d1f7-eee4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="f93e-b6a1-6bc4-6cbb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Guided Wraithsight" id="932f-6a79-c5c7-5f79" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase. Select one IYANDEN SPIRITSEER or WRAITHSEER model from your army and one friendly IYANDEN WRAITHBONE CORE unit. Until your next Command phase, that WRAITHBONE unit is considered to be within range of that SPIRITSEER model’s Spirit Mark ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="3 - Movement Phase" id="c776-b82d-3ac6-df24" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Cut them down" id="6eee-260b-b3e8-2ffc" collective="false" hidden="false" import="true" targetId="4428-f83f-58af-3292" type="selectionEntry"/>
            <entryLink name="1CP Desperate breakout" id="2b26-ffa7-6c0d-e6e8" collective="false" hidden="false" import="true" targetId="e39e-d7b1-900f-0762" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Cegorach&apos;s Jest" id="f417-5fb8-025c-b457" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Harlequins</comment>
              <constraints>
                <constraint id="80ce-6f28-222b-cdc9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="5ca6-543a-da77-3ffc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Cegorach&apos;s Jest" id="dcbd-53fd-f103-1a46" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your opponent’s Movement phase, when an enemy unit within Engagement Range of a RILLIETANN INFANTRY unit from your army Falls Back. After that enemy unit has finished that move, select one RILLIETANN INFANTRY unit from your army that was within Engagement Range of that enemy unit at the start of the phase. The selected unit can either consolidate up to 6&quot; or shoot as if it were your Shooting phase. If the selected unit shoots, it can only target that enemy unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Pathfinder Ambush" id="3e6f-d6fd-a4db-4803" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Alaitoc</comment>
              <constraints>
                <constraint id="8dbd-061a-82aa-8e50" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="7d5c-0041-1b41-a04d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Pathfinder Ambush" id="d0fd-5e9a-e808-1535" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Reinforcements step of your opponent’s Movement phase, after an enemy unit has been set up on the battlefield. Select one ALAITOC RANGERS unit from your army that is either on the battlefield or in Strategic Reserves.
- If that RANGERS unit is in Strategic Reserves, set it up anywhere on the battlefield within 24&quot; of that enemy unit and more than 9&quot; away from any enemy models.
- At the end of the phase, that RANGERS unit can shoot as if it were your Shooting phase, but until the end of the phase, it can only target the enemy unit that was just set up on the battlefield (and only if that enemy unit is an eligible target).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2/1CP Feigned Retreat" id="ae5a-331e-623e-dd6d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7502-df62-ca38-63c5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2/1CP Feigned Retreat" id="05f8-448d-e5be-fc79" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Movement phase, when an AELDARI unit from your army Falls Back. You can select for that unit to be eligible to shoot this turn or eligible to declare a charge this turn, or both. If you select both, this Stratagem costs 2CP; otherwise, it costs 1 CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Swift Outflanking" id="7b4e-1fdc-d96c-d15d" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Dukhari</comment>
              <constraints>
                <constraint id="274a-0062-4dcd-85db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1d51-ba7c-07d3-a293" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Swift Outflanking" id="84d8-ee29-6710-f7b3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the end of your Movement phase. Select one DRUKHARI TRANSPORT unit from your army that is wholly within 9&quot; of any battlefield edge. Remove that unit from the battlefield. That unit is placed into Strategic Reserves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="4 - Psychic phase" id="2b4c-2a9f-46c6-7c4f" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="3CP Eldrich Storm" id="112a-723d-abea-619f" collective="false" hidden="true" import="true" type="upgrade">
              <comment>No Dukhari</comment>
              <categoryLinks>
                <categoryLink name="Tactical Weapon" id="99e2-bccd-ab3c-c3ac" hidden="false" primary="false" targetId="9369-4930-4f3e-67a4"/>
                <categoryLink name="Blast" id="1777-8e8e-cdc6-fbb8" hidden="false" primary="false" targetId="a30d-0055-6710-6284"/>
                <categoryLink name="Torrent" id="cb57-f755-8327-a912" hidden="false" primary="false" targetId="795f-a8d3-dc18-cb2e"/>
              </categoryLinks>
              <constraints>
                <constraint id="a558-33dd-1dc9-1f87" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1d51-ba7c-07d3-a293" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="3CP Eldrich Storm" id="64b7-361b-bc7f-6e18" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase, if a PSYKER CHARACTER model from your army is on the battlefield. Until the end of your turn, any number of PSYKER models from your army that are on the Battlefield can attempt to perform Empower Storm [Action].</characteristic>
                  </characteristics>
                </profile>
                <profile name="3CP Eldrich Storm" id="6aee-480a-9886-304b" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (6&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D6</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">-</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">-</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical. Blast. Torrent. On a Wound roll of 4+, that unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Empower Storm [Action]" id="9311-a375-708f-dbd7" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">5</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Psychic action: Empower Storm has a Warp charge value of 5. If manifested, you can place a marker on the battlefield as stated in the Tactical Weapon rule, and make attacks with Eldrich Storm weapon profile using that same rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Unparalleled Mastery" id="358c-027c-4ef5-219e" collective="false" hidden="true" import="true" type="upgrade">
              <comment>No Dukhari</comment>
              <constraints>
                <constraint id="86f5-5d54-2186-12d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1d51-ba7c-07d3-a293" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Unparalleled Mastery" id="db40-57dc-f2d6-2da5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Psychic phase. Select one AELDARY PSYKER model from your army. That unit can attempt to manifest one additional psychic power this phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Crucible of Malediction" id="fe8e-c4ef-cdb5-b259" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Dukhari</comment>
              <constraints>
                <constraint id="686c-3f94-653d-383a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1d51-ba7c-07d3-a293" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Crucible of Malediction" id="e358-4f19-0974-7e70" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Psychic phase. Select one HAEMONCULUS unit from your army and roll one D6 for each enemy PSYKER unit within 12&quot; of it; for each roll of 4+, that PSYKER unit suffers D3 mortal wounds. You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="5 - Shooting phase" id="821f-d103-3982-36cb" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Discipline of the Black Guardians" id="053a-5839-38bd-5f7f" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Ulthwè</comment>
              <constraints>
                <constraint id="f929-5070-76f0-8fb4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="2940-0543-965f-7783" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Discipline of the Black Guardians" id="8c80-4892-8e6b-26b7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase or the Fight phase, when you select an ULTHWÉ GUARDIANS, WINDRIDERS or HEAVY WEAPON PLATFORMS unit to shoot or fight. Until the end of the phase, each time a model in that unit makes an attack, add 1 to that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Wrath of the Shrines" id="a8c0-75bd-c08c-7c6b" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Biel-tan</comment>
              <constraints>
                <constraint id="3581-e1ed-82e5-9774" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="d294-6bda-13ec-342f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Wrath of the Shrines" id="3179-c24d-baa2-f413" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase or the Fight phase, when a BIEL-TAN ASPECT WARRIOR unit from your army is selected to shoot or fight. Until the end of the phase, each time a model in that unit makes an attack, an unmodified hit roll of 6 scores 1 additional hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Masters of the Shadowed Sky" id="3d9c-9442-adff-e3ad" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Flayed Skull</comment>
              <constraints>
                <constraint id="e1ee-faf1-9a0c-e0dc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="cfd1-6f2e-d6eb-2d76" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Masters of the Shadowed Sky" id="33c2-f25d-7fb4-407c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when you select a KABAL OF THE FLAYED SKULL unit from your army to shoot with. Until the end of the phase, each time that unit makes an attack that targets a unit that can FLY, add 1 to that attack’s hit roll and ignore the Hard to Hit rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP An esoteric kill, delivered from afar" id="1806-d1f9-d0a1-8bfa" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Dark Creed</comment>
              <constraints>
                <constraint id="d00e-4146-b125-5a26" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="4990-d27d-16f9-ede4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP An esoteric kill, delivered from afar" id="e742-0cd9-8426-3396" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when you select a DARK CREED CORE or DARK CREED CHARACTER unit from your army to shoot with. Until the end of the phase, each time you select a target for an attack made by this unit, you can ignore the Look Out, Sir rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="6 - Charge phase" id="99b6-86cf-23ef-1d04" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Warriors of the Raging Winds" id="85e2-e3dd-0bd4-adce" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Saim-hann</comment>
              <constraints>
                <constraint id="5d2b-7319-1dc8-0104" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
