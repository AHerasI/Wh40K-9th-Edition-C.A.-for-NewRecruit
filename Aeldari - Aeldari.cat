                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD fights, after any pile-in moves, until that fight is resolved, you can choose for its Attacks characteristic to be equal to 3 plus the number of enemy models that are within 2&quot; of it.</characteristic>
                      </characteristics>
                    </profile>
