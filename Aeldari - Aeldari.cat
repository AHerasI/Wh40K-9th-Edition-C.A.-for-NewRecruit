    <categoryEntry name="Kabal: Black hearth" id="5a01-ffa1-d30e-e9c9" hidden="false">
      <profiles>
        <profile name="Thirst for power" id="0f61-c5ad-835f-452f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Units with this attribute that have the Power From Pain ability treat the current battle round as being one higher than it actually is when determining what effects they gain.
- All DRHUKARI SERVANTS units in the Detachment that have the Power From Pain ability also treat the current battle round as being one higher than it actually is when determining what effects they gain.
- Each time a unit with this attribute is selected to shoot or fight, you can re-roll one hit roll when resolving that unit’s attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Kabal: Flayed skull" id="b104-2322-8b24-cd32" hidden="false">
      <profiles>
        <profile name="Slay from the skies" id="de7d-2a48-c157-11e3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute that can FLY or that is embarked upon a TRANSPORT unit that can FLY makes a ranged attack, the target does not receive the benefits of Light Cover against that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Kabal: Obsidian rose" id="302d-5c07-47b4-9597" hidden="false">
      <profiles>
        <profile name="Flawless workmanship" id="db51-50cf-f2b9-2648" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this attribute is selected to shoot or fight, you can re-roll one wound roll when making that unit’s attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Kabal: Poisoned tongue" id="efc7-bf1c-bc2e-7cb4" hidden="false">
      <profiles>
        <profile name="The serpent&apos;s kiss" id="9a76-311c-64ed-6331" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an enemy unit has any models destroyed by an attack made with a poisoned weapon by a model with this attribute, until the end of the turn, subtract 1 from Combat Attrition tests taken for that enemy unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Kabal: Other" id="cf66-4c25-9895-a203" hidden="false">
      <profiles>
        <profile name="Dark Mirth [Aura]" id="fdee-a69a-fd6a-3aed" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While it is within 12&quot; of this unit, each time an enemy unit is selected to make a Normal Move, Advance, Fall Back or is selected to charge, roll one D6: on a 5+, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3c66-ccc0-7267-87f1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Deadly Deceivers" id="0687-a9b0-aa36-d7fe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this attribute are eligible to shoot in a turn in which they Fell Back, but if they do, then until the end of the turn, each time a model in that unit makes a ranged attack, subtract 1 from that attack’s hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="db4d-0246-6ea8-3d09" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Disdain for Lesser Beings" id="adf6-749e-05a3-7d15" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a Combat Attrition test is taken for a unit with this attribute, add 1 to that Combat Attrition test.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="0d4a-da65-e799-41ab" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Merciless Razorkin" id="545a-0c2f-9022-a4ad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack with a shard or splinter weapon, an unmodified hit roll of 6 scores 1 additional hit.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="7403-6caf-b154-78c5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Mobile Raiders" id="0770-9ea1-38a4-666d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">INFANTRY and BIKER models with this attribute can shoot in the shooting phase as if were remained stationary in the previous movement phase.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="81be-832f-1d99-5d83" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Soul Bound" id="8ffb-d526-7c6a-625d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="29d2-646b-5e72-3752" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Torturous Efficiency" id="830d-2ae0-2708-1626" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack with a ranged weapon, on an unmodified wound roll of 6, improve the Damage characteristic of that attack by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="2f65-4093-b89e-0020" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Toxin Crafters" id="24c2-a22e-7c67-250e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a model with this attribute makes an attack with a poisoned weapon, on an unmodified hit roll of 6, change that attack’s Poisoned Weapon ability to Poisoned Weapon (2+).
- Each time a model with this attribute makes an attack with a poisoned weapon, re-roll a wound roll of 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="df3a-d79a-56c5-62e5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Twisted Hunters" id="5491-2440-fb24-c830" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Obsession makes an attack against a CHARACTER unit without VEHICLE or MONSTER Keywords, add 1 to that attacks hit roll and wound roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="719c-c5a2-86dc-93ef" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Cult: Cult of strife" id="30ee-a197-4ddf-6b93" hidden="false">
      <infoLinks>
        <infoLink name="The spectacle of murder" id="074c-e9bf-f10e-7da9" hidden="false" targetId="c6de-0143-dd9b-37cb" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Cult: Cult of the cursed blade" id="6f27-1a32-d731-e8d2" hidden="false">
      <profiles>
        <profile name="Only the strong will thrive" id="3bda-a06f-f6f3-8b38" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you make an unmodified saving throw of 6 for a model with this attribute against a melee attack, after the attacking model’s unit has finished making its attacks, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Cult: Cult of the red grief" id="6577-597e-cbf4-3e78" hidden="false">
      <infoLinks>
        <infoLink name="The speed of the kill" id="062c-85ab-61ef-9355" hidden="false" targetId="634a-0838-0089-c76a" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Cult: Other" id="c3c1-89e1-e76b-c2b3" hidden="false">
      <profiles>
        <profile name="Acrobatic Display" id="f730-3947-ca51-98e4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a imit with this attribute consolidates or piles in, models in that unit can move horizontally through other models and terrain features (they cannot finish a move on top of another model, or its base).</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="2cd9-f22d-84a9-921e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Agile Hunters" id="c3d6-4cc4-ed40-bb71" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a model with this attribute makes an attack that targets a unit that can FLY, add 1 to that attacks hit roll.
- If a unit with this attribute with the Combat Drugs ability has the Hypex ability, add 4&quot; to that unit’s Move characteristic instead of 3&quot;.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="c7ac-ed7e-486b-6b49" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Berserk Fugue" id="794e-0d19-22b0-7c0f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a model with this attribute makes a melee attack, if that model’s unit made a charge move, was charged or performed a Heroic Intervention this turn, an unmodified hit roll of 6 scores 1 additional hit.
- Each time a model with this attribute would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="6b63-ea07-cb43-46a5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Slashing impact" id="52d5-247f-ed2e-ae31" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute finishes a charge move, you can select one enemy unit (excluding VEHICLE or TITANIC units) within Engagement Range and roll one D6: on a 6, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f8e5-37fe-b916-5f80" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Stimulant Innovators" id="a705-3b05-c3c8-64fb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Once per battle, in your Command phase, you can declare that units with this attribute will use their experimental concoctions. When you do so, roll one D6 on the Combat Drugs table or select one from it. 
- Every unit with this attribute that has the Combat Drugs ability gains this additional ability (which is cumulative with any abilities they already have) until the end of the turn.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="9e49-3ca9-6cef-9a3a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Test of skill" id="e665-5d14-0022-c800" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes a melee attack that targets a MONSTER or VEHICLE unit, add 1 to that attack’s wound roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3938-8348-b276-3992" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="The Art of Pain" id="11ac-70ba-dfed-ea0b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a unit with this attribute that has the Power From Pain ability is within Engagement Range of any enemy units, treat the current battle round number as being one higher when determining what effects the Power From Pain ability has.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="e218-3a32-2076-7f4c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Trophy Takers" id="4467-e46a-7f3e-a2df" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Morale test is taken for an enemy unit that had any models destroyed by a melee attack made by a unit with this attribute, roll one additional D6 and discard the lowest result.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="dcba-1da1-c598-e480" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Coven: Coven of the twelve" id="8f79-aa14-065f-5499" hidden="false">
      <infoLinks>
        <infoLink name="Butchers of flesh" id="3ba5-5893-1931-6dba" hidden="false" targetId="04d5-1126-b9fe-b572" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry name="Coven: The dark creed" id="fff4-ca2d-4b20-6d0c" hidden="false">
      <profiles>
        <profile name="Aura of Terror [Aura]" id="ab32-241d-4aa2-2ed0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of a unit with this Obsession, subtract 1 from the Leadership characteristic of models in that unit, and subtract 1 from Combat Attrition tests made for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Distillers of fear" id="e25d-c787-fc0d-cace" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you make a melee attack for a unit with this attribute that targets a unit with a Leadership characteristic that is equal to or lower than the attacking units Leadership characteristic, add 1 to that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Coven: The prophets of the flesh" id="e215-df2b-572a-a8c3" hidden="false">
      <profiles>
        <profile name="Connoisseurs of pain" id="4385-795a-7420-2c17" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack of strength 7 or less is made against a unit with this attribute, a wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                        <condition childId="ef18-746a-369f-43a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
