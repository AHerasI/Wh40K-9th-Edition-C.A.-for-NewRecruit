                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a melee attack, unless the target is a VEHICLE, TITANIC or MONSTER unit, an unmodified wound roll of 2+ is always successful.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Lord of Crystal Bones" id="2ea8-5377-4058-46af" collective="false" hidden="true" import="true" type="upgrade">
              <constraints>
                <constraint id="eadb-cf97-5dbc-3c42" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
