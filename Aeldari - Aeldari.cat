                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Units with this attribute are eligible to declare a charge in a turn in which they Fell Back.
- You can re-roll Advance rolls, Battle focus and Charge rolls made for units with this attribute.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
