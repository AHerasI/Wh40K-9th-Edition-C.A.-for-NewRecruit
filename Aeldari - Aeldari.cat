      <profiles>
        <profile name="Falcon" id="1d3d-6823-937b-34b4" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 6 YNARII INFANTRY, ANHRATHE INFANTRY or ASURYANI INFANTRY or BEAST models. Each WRAITHBONE model takes the space of two INFANTRY models. It cannot transport JUMP PACK models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cloudstrike" id="e52d-d0d4-0040-f399" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- This Transport can start the battle set up high in the skies.
- This Transport can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules, and it must set up more than D3+6&quot; away from any enemy models.
- Any units embarked within this Transport can immediately disembark after it has been set up on the battlefield, it&apos;s models can&apos;t be set closer than the TRANSPORT model.</characteristic>
          </characteristics>
        </profile>
      </profiles>
