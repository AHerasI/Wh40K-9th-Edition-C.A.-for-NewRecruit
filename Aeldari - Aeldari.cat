                <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">2</characteristic>
                <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite or 1 Runes of Fortune, all of the psychic powers from the Revenant discipline.</characteristic>
                <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
              </characteristics>
            </profile>
          </profiles>
