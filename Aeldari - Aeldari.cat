            <selectionEntry name="2 - Drukhari" id="1d51-ba7c-07d3-a293" collective="false" hidden="false" import="true" type="upgrade">
              <categoryLinks>
                <categoryLink name="Faction: Drukhari" id="1a61-5d1c-be88-7ad1" hidden="false" primary="false" targetId="137f-9a86-a5a7-ce94"/>
