              </modifiers>
              <profiles>
                <profile name="Rift Ghoul" id="7f46-1207-0fb9-81d0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack:
- The target does not receive the benefits of cover against that attack.
- On an unmodified wound roll of 4+ against units without INORGANIC, VEHICLE or TITANIC Keyword, that attack inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Spectre of Despair" id="20f9-eab8-a3a2-45df" collective="false" hidden="true" import="true" type="upgrade">
              <constraints>
                <constraint id="5cbd-8699-dcc3-4cac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
