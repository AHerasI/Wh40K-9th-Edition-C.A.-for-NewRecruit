                    <infoLink name="Asuryani Oucast" id="796b-3a5c-d76d-0c80" hidden="false" targetId="5fd7-16bd-38db-9b01" type="profile"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Gloom field" id="50ce-c506-0e09-618b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against the bearer’s unit, if the attacking model is more than 18&quot; away, then the bearer’s unit is treated as having the benefits of Light Cover against that attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
