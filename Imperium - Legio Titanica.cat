          </constraints>
          <selectionEntries>
            <selectionEntry name="Legio Victorum" id="8dec-0edd-5bb9-cae1" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Foe Slayers" id="7979-b444-9d7f-8ecf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability makes an attack, if that models unit has remained stationary in the previous movement phase, add 1 to that attack’s hit roll, and you can ignore any or all modifiers to the Hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Legio Astorum" id="68b4-8a35-3600-dd57" collective="false" hidden="false" import="true" type="upgrade">
              <comment>FW Lucius</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Warp Runners" id="fbd2-4eb7-c5b7-dd59" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models with this ability which have a Damage Table are considered to have double the number of wounds remaining for the purposes of determining what those characteristics are.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Legio Astraman" id="30df-76b3-9c78-2a04" collective="false" hidden="false" import="true" type="upgrade">
              <comment>FW Graia</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Morning Stars" id="2ff8-b701-7ae2-c273" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability would lose a wound as a result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
