                  </constraints>
                  <selectionEntries>
                    <selectionEntry name="Optimized point defence systems" id="7028-6965-2b56-09be" collective="false" hidden="false" import="true" type="upgrade">
                      <costs>
                        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="Pts" typeId="points" value="0"/>
                        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Optimized point defence systems" id="0ca8-999d-6eaf-ebbb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a unit with this ability fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+ instead of a 6.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
