                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Units with this adaptation are eligible to perform Heroic Interventions as if they were a CHARACTER unit.</characteristic>
                      </characteristics>
                    </profile>
