        <profile name="Instinctive Behaviour" id="7ede-275e-0f62-3357" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a unit with this ability is not in SYNAPSE range during the Morale Phase, it must roll a Morale test, regardless if the unit have lost any models during the turn, and substract 1 from the Attrition test.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
