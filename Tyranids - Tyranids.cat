        <profile name="Fear of the Unseen" id="3cbb-7ade-6a1d-48d7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within Engagement Range of this model, that unit cannot be selected for Stratagems used by your opponent, and that unit cannot be affected by Stratagems used by your opponent when that unit is selected to shoot or fight.</characteristic>
          </characteristics>
        </profile>
