      <profiles>
        <profile name="Bombardment Organism" id="a0f8-be66-330d-b025" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, when you set up this model, it can be set up anywhere on the battlefield that is more than 12&quot; away from the enemy deployment zone and any enemy models.</characteristic>
          </characteristics>
        </profile>
