        <profile name="Shrouding Spores [Aura]" id="9b44-290c-3d36-b02e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HIVE FLEET&gt; unit that is not TITANIC is within 6&quot; of this model, is considered to be in Dense Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prey Adaption [Aura]" id="5dd7-3775-b962-316d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HIVE FLEET&gt; unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
