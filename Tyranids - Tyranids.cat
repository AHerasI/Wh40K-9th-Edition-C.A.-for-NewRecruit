      <profiles>
        <profile name="Harpoon Barbs" id="424b-b8fa-d276-cfec" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when an enemy unit within Engagement range is selected to Fall Back, roll 1D6, if the result of that roll is greater than the Strength characteristic of all the models of that unit, that unit must Remain Stationary instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unnatural resilience" id="28f1-11e3-d87b-b421" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability would lose a wound as the result of a mortal wound, roll one D6; on a 5+ that wound is not lost.</characteristic>
          </characteristics>
        </profile>
