                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Biomorphology - Relentless hunger" id="ae2a-0af5-7362-f3e9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation fails a charge, it can make a Normal Move of up to 3&quot;.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Wreathed in the shadow" id="3cfd-756b-6a3d-803a" collective="false" hidden="false" import="true" type="upgrade">
