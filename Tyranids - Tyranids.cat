        <profile name="Massive Grasping Tendrils" id="3fa1-5fe6-42ac-9dab" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when an enemy unit (excluding AIRCRAFT units) within Engagement Range of this model is selected to Fall Back, this model can use this ability. If it does so, roll one D6, adding 1 if that unit has the INFANTRY keyword: on a 3+, that unit cannot Fall Back and must Remain Stationary instead.</characteristic>
          </characteristics>
        </profile>
