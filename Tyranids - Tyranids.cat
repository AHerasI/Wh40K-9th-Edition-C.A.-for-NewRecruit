                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is allocated to a model with this Adaptation while it is receiving the benefits of cover from a terrain feature, add an additional 1 to any armour saving throw made against that attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
