                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">---404---</characteristic>
                  </characteristics>
                  <modifierGroups>
                    <modifierGroup>
                      <modifiers>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="You can re-roll charge rolls made for units from your army with this adaptation.">
                          <conditions>
                            <condition childId="37d0-e852-44f1-8771" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a unit with this adaptation Advances, do not make an Advance roll. Instead, until the end of the phase, add D3+3&quot; to the Move characteristic of models in that unit.">
                          <conditions>
                            <condition childId="355e-f2e2-e7cb-5031" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a unit with this adaptation is selected to shoot or fight, you can re-roll one hit roll when resolving that unit’s attacks.">
                          <conditions>
                            <condition childId="1b0d-b129-a9fd-6281" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a unit with this adaptation is selected to shoot or fight, you can re-roll one wound roll when resolving that unit’s attacks.">
                          <conditions>
                            <condition childId="cfe2-cd03-e896-8713" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a unit with this adaptation is targeted by a weapon with the Blast rule, halve the number of models in that unit (rounding up) when determining how many attacks are made with that weapon.">
                          <conditions>
                            <condition childId="923c-fb7a-310c-61ee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a model with this adaptation makes a ranged attack that targets a unit within half range, improve the Armour Penetration characteristic of that attack by 1.">
                          <conditions>
                            <condition childId="816e-41d9-8441-3a09" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Add 1&quot; to the Move characteristic of models with this adaptation, and each time a model with this adaptation makes a consolidation move, it can move up to an additional 3&quot; (to a maximum of 9&quot;).">
                          <conditions>
                            <condition childId="1149-dd9f-46b6-f7fb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                    </modifierGroup>
                  </modifierGroups>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Feed Biomorphologies (0-1)" id="8ee4-2d64-356a-be04" collective="false" hidden="true" import="true">
              <constraints>
                <constraint id="1d15-517f-e325-dc35" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="816e-41d9-8441-3a09" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                        <condition childId="1149-dd9f-46b6-f7fb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                        <condition childId="cfe2-cd03-e896-8713" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                        <condition childId="1b0d-b129-a9fd-6281" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
