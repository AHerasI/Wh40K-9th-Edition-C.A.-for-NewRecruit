    <selectionEntry name=" Stratagem List" id="8647-6d8b-d940-aca1" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="1CP Command re-roll" id="cb81-a2d1-7cf9-054f" collective="false" hidden="false" import="true" targetId="5988-c6f8-e6da-239c" type="selectionEntry"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 - Before battle" id="efc1-6b1a-98df-6d55" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Buried in wait" id="35ed-36d8-fc10-52a9" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Jormungandr</comment>
              <constraints>
                <constraint id="b5a2-99b2-4ce3-6b0e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="923c-fb7a-310c-61ee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Buried in wait" id="7dff-7a8f-94ef-50fb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem before the battle, during the Declare Reserves and Transports step (if you are playing a mission without this step, use this Stratagem during deployment instead). Select one JORMUNGANDR unit from your army (excluding TITANIC units). You can set up that unit near to the surface instead of setting it up on the battlefield. If you do so, then in the Reinforcements step of one of your Movement phases, you can set up that unit anywhere on the battlefield that is more than 9&quot; away from any enemy models. You can only use this Stratagem once, unless you are playing a Strike Force battle (in which case you can use this Stratagem twice), or an Onslaught battle (in which case you can use this Stratagem three times).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="2 - Command Phase" id="509c-3e31-9387-c8d1" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Rapid Regeneration" id="1930-0ab1-cc1b-b237" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bf24-af24-4c16-c7b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Rapid Regeneration" id="84b9-b84a-7b41-3053" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase. Select one &lt;HIVE FLEET&gt; model from your army. That model regenerates and regains up to D3 lost wounds. Each model can only be regenerated once per turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="3 - Movement Phase" id="65d5-77f8-97c1-341e" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Cut them down" id="037c-401f-bafa-1b40" collective="false" hidden="false" import="true" targetId="4428-f83f-58af-3292" type="selectionEntry"/>
            <entryLink name="1CP Desperate breakout" id="b395-4849-8dc7-23d5" collective="false" hidden="false" import="true" targetId="e39e-d7b1-900f-0762" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Oportunistic Advance" id="f7a0-73c2-2de4-0640" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Kraken</comment>
              <constraints>
                <constraint id="0a74-8da0-1024-5671" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="355e-f2e2-e7cb-5031" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Oportunistic Advance" id="bfbd-36ba-0824-dcf8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Movement phase, when a KRAKEN unit from your army is selected to move. Until the end of the turn:
- Each time that unit Advances, do not make an Advance roll. Instead, until the end of the phase, add 8&quot; to the Move characteristic of models in that unit (note that a unit cannot be affected by both this Stratagem and the Bounding Advance Stratagem, in the same phase).
- Models in that unit do not suffer the penalty to hit rolls incurred for firing Assault weapons in the same turn that their unit has Advanced.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="4 - Psychic phase" id="9407-edb2-7726-f52f" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP The Deepest Shadow" id="6e46-2b5e-8233-0cc4" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Kronos</comment>
              <constraints>
                <constraint id="cf86-50de-0897-eaa9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="816e-41d9-8441-3a09" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP The Deepest Shadow" id="24db-9c07-bd98-dc21" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your opponent’s Psychic phase, when an enemy unit fails a Psychic test. Select one KRONOS PSYKER unit from your army within 18&quot; of that enemy unit. That enemy unit suffers D3 mortal wounds and, until the end of the phase, that KRONOS PSYKER unit gains the following ability:

Deepest Shadow [Aura]: While an enemy PSYKER unit is within 18&quot; of this unit, each time a Psychic test taken for that unit is failed, that unit suffers D3 mortal wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Power of the Hive Mind" id="5010-cddd-74d6-b000" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2e28-3188-dd51-496e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Power of the Hive Mind" id="a227-9305-083f-e166" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Psychic phase. Select one &lt;HIVE FLEET&gt; PSYKER CHARACTER unit from your army. Until the end of the phase, that unit can attempt to manifest one additional psychic power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="5 - Shooting phase" id="0218-8019-f7f6-ac20" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Shard Lure" id="6dc2-466d-2fed-ec2f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="39da-c5d9-12b9-a3c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Shard Lure" id="8a18-5cda-700f-60bf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a ranged attack made by a model in a &lt;HIVE FLEET&gt; SYNAPSE unit from your army scores a hit against an enemy unit. Until the end of the turn, each time a friendly &lt;HIVE FLEET&gt; unit declares a charge, if that enemy unit is within SYNAPSE range and is one of the targets of that charge, roll one additional D6 and discard one of the dice when making the charge roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="6 - Charge phase" id="d9bf-b607-bfe9-3787" collective="false" hidden="false" import="true"/>
        <selectionEntryGroup name="7 - Fight phase" id="15ff-22a9-f0c0-475b" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="2CP Counter-offensive" id="4f1c-afbe-2a8c-124a" collective="false" hidden="false" import="true" targetId="b12f-dc2d-6057-5468" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Blinding Venom" id="da89-45e6-1c60-85c0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="94f6-9d12-0b09-5073" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Blinding Venom" id="4807-5cfd-0c2b-d09e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Fight phase. Select one enemy unit without INORGANIC, VEHICLE or TITANIC Keywords within Engagement Range of any MINOR BIOFORM units from your army. Until the end of the phase:
- Each time a model in that enemy unit makes an attack, the hit roll cannot be re-rolled.
- Each time a model in that enemy unit makes a melee attack, subtract 1 from that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Combined Assault" id="ca0f-a1d6-7c6d-736d" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Leviathan</comment>
              <constraints>
                <constraint id="76bb-7c78-5e7b-49f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1b0d-b129-a9fd-6281" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Combined Assault" id="01ef-19c6-107d-4ba5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase. Select one enemy unit within Engagement Range of two or more LEVIATHAN units from your army. Until the end of the phase, each time a LEVIATHAN model makes a melee attack against that enemy unit, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Death Frenzy" id="03e5-562e-8a74-261d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="61a0-a919-161b-a06e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2CP Death Frenzy" id="c55c-0945-e686-6671" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a &lt;HIVE FLEET&gt; CHARACTER model from your army that has not already been selected to fight this phase is destroyed, instead of using any rules that are triggered when that model is destroyed (e.g. the Death Throes rule). 
Do not remove that model from play - it can fight after the attacking model’s unit has finished making attacks. When making those attacks, if the destroyed model’s characteristics can change as they suffer damage, that model is considered to have its full wounds remaining for the purpose of determining what those characteristics are. After resolving the destroyed model’s attacks, it is then removed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Voracious Appetite" id="4f4f-1405-7138-9d05" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0cb0-332a-7833-458b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Voracious Appetite" id="daba-6e9d-a8b3-0a9a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a &lt;HIVE FLEET&gt; MONSTER model from your army is selected to fight. Until the end of the phase, each time that model makes a melee attack, you can re-roll the wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Critical Mass" id="c09a-fd4d-604c-3b4e" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Hydra</comment>
              <constraints>
                <constraint id="1cc3-0b2b-5fef-8a4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="1149-dd9f-46b6-f7fb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Critical Mass" id="f2b8-31c4-2278-e8cf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a HYDRA unit from your army is selected to fight. Until the end of the phase, each time a melee attack made by a model in that unit targets an enemy unit with fewer models than its own, you can re-roll the wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Hyper-Toxicity" id="028c-ed1e-2137-807e" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Gorgon</comment>
              <constraints>
                <constraint id="0aaf-b15b-9727-3d59" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="cfe2-cd03-e896-8713" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Hyper-Toxicity" id="5bea-6f6f-b8e4-fd76" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a GORGON unit with TOXIN SACS from your army is selected to fight. Until the end of the phase, each time a model in that unit makes a melee attack, the TOXIN SACS ability wounds on a unmodified hit roll of 4+ instead of on a 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="8 - Morale phase" id="d0aa-f83a-5526-9cab" collective="false" hidden="false" import="true">
