                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">3</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Blast. Bomb. This weapon wounds on a 2+ against units without INORGANIC, VEHICLE or TITANIC Keywords.</characteristic>
              </characteristics>
            </profile>
            <profile name="Spore Mine Cysts" id="bede-d51a-7666-f385" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Instead of using the Bomb profile, you can select a point on the battlefield the unit has moved across, and set up a new friendly SPORE MINES unit of 3 models on the battlefield, not within 6&quot; of any enemy units and within 2&quot; of the selected point.</characteristic>
              </characteristics>
            </profile>
          </profiles>
