                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this adaptation makes a consolidation move, it can move up to an additional 3&quot; (to a maximum of 9&quot;).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Heightened reflexes" id="fd8d-0a25-a467-7ad8" collective="false" hidden="false" import="true" type="upgrade">
