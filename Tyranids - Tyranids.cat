    <categoryEntry name="Common Bioforms" id="3ca4-2e6a-008b-e891" hidden="false">
      <profiles>
        <profile name="Common Bioform" id="939e-70f0-7712-21de" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this unit loses it&apos;s last model outside any Morale Phase, and a CONTROL-LINK BIOFORM is on the Battlefield, roll a D6, on a 3+, you can return the unit at Starting Strength to the battlefield as reinforcements.
At the end of the battle the unit is considered to be destroyed.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5a8c-457f-9197-5972" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Common Bioform" id="25e2-f7d2-5a45-6a96" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <comment>Tyrant.</comment>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this unit loses it&apos;s last model outside any Morale Phase, and a CONTROL-LINK BIOFORM is on the Battlefield, roll a D6, on a 3+, you can return the unit at Starting Strength to the battlefield as reinforcements. While a friendly HIVE TYRANT model is on the battlefield, add 1 to the result of that roll.
At the end of the battle the unit is considered to be destroyed.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5a8c-457f-9197-5972" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
