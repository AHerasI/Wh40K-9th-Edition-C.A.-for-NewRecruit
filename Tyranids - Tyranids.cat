      <profiles>
        <profile name="Unstopable Onslaught" id="75c9-4b1f-0e11-a3d1" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Synapse</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Blessing: Unstoppable Onslaught has a warp charge value of 7. If manifested, select one friendly BEHEMOTH unit within Synapse range of this PSYKER. Until the start of your next turn, each time a model in that unit makes a melee attack against units of Toughness characteristic of 6 or less, add 1 to that attack’s wound roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Hive Fleet Kraken" id="d05c-e20a-b0ee-5a2e" hidden="false">
      <infoLinks>
        <infoLink name="Fleet Adaptation - Questing Tendrils" id="54aa-2c7b-80bc-e226" hidden="false" targetId="9fca-aee7-ae70-cc8f" type="profile"/>
        <infoLink name="Adaptations" id="fe63-31cd-8adc-128e" hidden="false" targetId="723f-adca-9e01-321d" type="infoGroup"/>
      </infoLinks>
      <profiles>
        <profile name="Synaptic lure" id="8c10-a5a9-3d65-8d2e" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">5</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot; or Synapse</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Malediction: Synaptic Lure has a warp charge value of 5. If manifested, select one enemy unit within Synapse range of this PSYKER or one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time a friendly KRAKEN unit declares a charge, if that enemy unit is one of the targets of that charge, you can re-roll the charge roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Hive Fleet Leviathan" id="4ee8-8aa3-95a0-2902" hidden="false">
      <infoLinks>
        <infoLink name="Adaptations" id="7896-8a74-54c0-302c" hidden="false" targetId="723f-adca-9e01-321d" type="infoGroup"/>
      </infoLinks>
      <profiles>
        <profile name="Hive Nexus" id="1ea5-80a8-e43c-cc2a" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Synapse</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Blessing: Hive Nexus has a warp charge value of 7. If manifested, select one friendly LEVIATHAN CORE unit within Synapse range of this PSYKER and select one unactive Synaptic Imperative ability of a friendly LEVIATHAN model that is also within Synapse range of this PSYKER. 
Until the start of your next turn, that unit benefits from that SYNAPSE model’s Synaptic Imperative ability as if it was active for your army (in addition to the one that is currently active for your army).</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="e691-aad7-d21c-1023" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry name="Hive Fleet Gorgon" id="5da8-11c6-98f0-9f76" hidden="false">
      <infoLinks>
