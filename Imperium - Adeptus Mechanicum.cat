                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="0df5-03b2-7019-7e2f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2CP Plasma Specialists" id="2026-671a-c2b7-d1a5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a RYZA unit is selected to shoot. Until the end of the phase, each time a model in that unit makes an attack with a plasma weapon, add 1 to the Damage characteristic of that attack. In addition, until the end of the turn, the unit cannot lose both models or Wounds when using an OVERCHARGED profile of plasma weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
