                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, each SKITARII CORE model in your army with this dogma can either make a normal Move or, in addition to any other abilities they may have that allow them to make a normal Move, move an additional 3&quot;. They cannot end this move within 6&quot; of any enemy models.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                            </selectionEntry>
                            <selectionEntry name="Rugged explorators" id="2592-945f-c7a6-81c6" collective="false" hidden="false" import="true" type="upgrade">
                              <costs>
                                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                                <cost name="Pts" typeId="points" value="0"/>
                                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                              </costs>
                              <profiles>
                                <profile name="Rugged explorators" id="4576-74d3-f595-c3a9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Models in this unit do not suffer the penalty to hit rolls incurred for firing Heavy weapons in the same turn that their unit has moved.
- VEHICLE models in this unit do not suffer the penalty to hit rolls incurred for firing Assault weapons in the same turn that their unit has Advanced.</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
