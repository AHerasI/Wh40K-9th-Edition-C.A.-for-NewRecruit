          <profiles>
            <profile name="Emotionless clarity" id="abcd-808f-f263-afc9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;FORGE WORLD&gt; CORE unit whitout SKITARII Keyword within 6&quot; of this WARLORD. Until the start of your next Command phase, that unit is eligible to charge in a turn in which it Fell Back.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="M - Panegyric procession" id="c0a2-9f23-5b95-3b09" collective="false" hidden="true" import="true" type="upgrade">
          <constraints>
            <constraint id="666c-21f1-14ad-5d25" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b892-55c4-53ab-9712" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
