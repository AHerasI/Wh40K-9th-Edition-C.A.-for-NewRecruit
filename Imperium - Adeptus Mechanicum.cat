      <profiles>
        <profile name="Voltagheist Blast" id="ee4c-b3a4-70f8-2c7a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After this unit finishes a charge move, select one enemy unit within Engagement Range of this unit and roll one D6 for each model from this unit that is within Engagement Range of that enemy unit: for each 6+, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Siphoned Vigour" id="b2fb-2144-773b-4350" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this unit destroys an enemy unit for the first time, until the end of the battle:
- Add 1 to rolls made for this unit’s Voltagheist Blast ability.
- Models in this unit have a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
