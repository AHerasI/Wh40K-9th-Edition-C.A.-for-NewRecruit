              </costs>
              <profiles>
                <profile name="1CP Benevolence of the Omnissiah" id="12f3-fcdd-6b7a-1f8d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in any phase, when an &lt;FORGEWORLD&gt; VEHICLE model in your army would lose a wound as the result of a mortal wound. Until the end of the phase, each time that model would lose a wound as the result of a mortal wound, roll one D6: on a 4+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
