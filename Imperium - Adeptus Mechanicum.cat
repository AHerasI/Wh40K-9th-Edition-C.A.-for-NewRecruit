            <profile name="Luminiscent blessing" id="e68d-b403-846a-9586" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one LUCIUS CORE unit within 9&quot; of this WARLORD. 
Until the start of your next Command phase, each time an attack is made against that unit, a wound roll of 1 -3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="A - Verse of vengeance" id="dfe6-1d74-296f-4acf" collective="false" hidden="true" import="true" type="upgrade">
          <constraints>
            <constraint id="d0f8-e568-6587-dfdd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4009-966c-f1de-edf0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
