      <infoGroups>
        <infoGroup name="Canticles of the Omnissiah" id="2799-01b4-d65c-ae47" hidden="false">
          <infoGroups>
            <infoGroup name="Canticles of the Omnissiah" id="ce7d-6667-0aeb-9951" hidden="false">
              <profiles>
                <profile name="-6-" id="c068-42c4-fa96-7ce5" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Litany of the Electromancer</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">While this Canticle is active, each time a melee attack is made against a CANTICLES OF THE OMNISSIAH unit, subtract 1 from that attack’s Hit roll, and cannot re-roll the Hit roll.</characteristic>
                  </characteristics>
                </profile>
                <profile name="-1-" id="693c-1c2d-8e75-8fec" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Shroudpsalm</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">While this Canticle is active, CANTICLES OF THE OMNISSIAH units counts as receiving the benefits of Light Cover.</characteristic>
                  </characteristics>
                </profile>
                <profile name="-2-" id="2d5d-8194-9d30-56b8" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Chant of the Remorseless Fist</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">While this Canticle is active, each time a model in a CANTICLES OF THE OMNISSIAH unit make a melee attack, add 1 to the Strength characteristic of that attack.</characteristic>
                  </characteristics>
                </profile>
                <profile name="-3-" id="a2e0-0bfd-9934-ff3d" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Incantation of the Iron Soul</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">Each time a Combat Attrition test is taken for a CANTICLES OF THE OMNISSIAH unit, ignore any or all modifiers. 
In addition, each time a model in that unit would lose a wound as a result of a Mortal wound, roll one D6: on a 5+, that wound is not lost. If the unit has the Refusal to Yield dogma, that wound is not lost on a 4+ instead.</characteristic>
                  </characteristics>
                </profile>
                <profile name="-4-" id="5900-7e89-6f76-2944" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Benediction of the Omnissiah</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">While this Canticle is active, each time a CANTICLES OF THE OMNISSIAH unit is selected to shoot, when resolving its attacks you can re-roll one Hit roll, one Wound roll and one Damage roll.</characteristic>
                  </characteristics>
                </profile>
                <profile name="-5-" id="e4aa-a65e-e6dc-8f64" hidden="false" typeId="a91a-94bc-68e1-7481" typeName="Canticles">
                  <characteristics>
                    <characteristic name="of the Omnissiah" typeId="246e-7747-9dfb-36c9">Invocation of the Machine Vengeance</characteristic>
                    <characteristic name="Effect" typeId="2b03-0847-11b3-6797">While this Canticle is active, each time an Advance roll or a Charge roll is made for a CANTICLES OF THE OMNISSIAH unit, roll one additional D6 and discard the lowest result.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </infoGroup>
          </infoGroups>
          <profiles>
            <profile name="Canticles of the Omnissiah" id="dd38-0dbe-c68c-5b6e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the battle round, you can select one Canticle that has not yet been active for your army, or select it randomly by rolling a D6.
If you do so, until the end of the battle round, that Canticle is active for CANTICLES OF THE OMNISSIAH units of your army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Doctrina Imperatives" id="8e80-353a-306b-4176" hidden="false">
          <infoGroups>
            <infoGroup name="Doctrina Imperatives" id="e9a9-4d14-4e2f-7adb" hidden="false">
              <profiles>
                <profile name="Agressor Imperative" id="855f-c6af-bb54-991f" hidden="false" typeId="2e2c-0520-d34e-5483" typeName="Doctrina Imperatives">
                  <characteristics>
                    <characteristic name="Optimisation effect" typeId="0770-b81c-b01b-d39f">Improve the Move characteristic of models in SKITARII units by 3&quot;</characteristic>
                    <characteristic name="Deprecation effect" typeId="1bc6-22f4-8e78-dfe3">Reduce the Save characteristic of models in SKITARII units by 1 (up to 6+)</characteristic>
                  </characteristics>
                </profile>
                <profile name="Bulwark Imperative" id="9d35-7c3b-c31c-a95f" hidden="false" typeId="2e2c-0520-d34e-5483" typeName="Doctrina Imperatives">
                  <characteristics>
                    <characteristic name="Optimisation effect" typeId="0770-b81c-b01b-d39f">Improve the Save characteristic of models in SKITARII units by 1 (up to 2+)</characteristic>
                    <characteristic name="Deprecation effect" typeId="1bc6-22f4-8e78-dfe3">Reduce the Move characteristic of models in SKITARII units by 3&quot;</characteristic>
                  </characteristics>
                </profile>
                <profile name="Conqueror Imperative" id="35eb-661d-277a-1484" hidden="false" typeId="2e2c-0520-d34e-5483" typeName="Doctrina Imperatives">
                  <characteristics>
                    <characteristic name="Optimisation effect" typeId="0770-b81c-b01b-d39f">Improve the Weapon Skill characteristic of models in SKITARII units by 1</characteristic>
                    <characteristic name="Deprecation effect" typeId="1bc6-22f4-8e78-dfe3">Reduce the Ballistic Skill characteristic of models in SKITARII units by 1</characteristic>
                  </characteristics>
                </profile>
                <profile name="Protector Imperative" id="dd53-628e-e0e4-a2ee" hidden="false" typeId="2e2c-0520-d34e-5483" typeName="Doctrina Imperatives">
                  <characteristics>
                    <characteristic name="Optimisation effect" typeId="0770-b81c-b01b-d39f">Improve the Ballistic Skill characteristic of models in SKITARII units by 1</characteristic>
                    <characteristic name="Deprecation effect" typeId="1bc6-22f4-8e78-dfe3">Reduce the Weapon Skill characteristic of models in SKITARII units by 1</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </infoGroup>
          </infoGroups>
          <profiles>
            <profile name="Doctrina Imperatives" id="fc45-0848-a52d-18c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the battle round, if there is a DOCTRINA ASSEMBLER model from your army on the battlefield, you can select one Doctrina Imperative that has not yet been active for your army. 
If you do so, until either the end of the battle or when selected another Doctrina, that Doctrina Imperative is active for SKITARII units of your army.
Unless stated otherwise, when a Doctrina Imperative is active, both of the effects it have will apply.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
