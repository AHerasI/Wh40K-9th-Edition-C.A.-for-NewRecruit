      <profiles>
        <profile name="Eye of Serberys" id="d020-14c1-23c1-0a47" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you select a target for a weapon a model in this unit is equipped with, you can ignore the Look Out, Sir rule. 
Each time a ranged attack is made by a model in this unit, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
          </characteristics>
        </profile>
        <profile name="Skirmishing Line" id="be7b-ab94-f4a2-738f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, models in this unit can make a Normal Move. They cannot end this move within 9&quot; of any enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
