                      </costs>
                      <profiles>
                        <profile name="Accelerated actuators" id="f1ea-0998-313a-7aed" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this dogma fights, if it made a charge move, was charged or performed a Heroic Intervention this turn, then until that fight is resolved, the Attacks and Strength characteristic of the models in that unit is improved by 1.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <selectionEntryGroups>
