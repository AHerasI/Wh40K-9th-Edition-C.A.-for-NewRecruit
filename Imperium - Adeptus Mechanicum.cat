    <profile name="Battle Protocols" id="28de-6b50-ada6-497d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit receives a bonus depending on which protocol is active for it. At the start of the battle, the Aegis Protocol is active for this unit.
- Aegis Protocol: While this protocol is active for this unit, models in this unit have a Save characteristic of 2+, and can re-roll armour Saving throws of 1.
- Conqueror Protocol: While this protocol is active for this unit, you can re-roll charge rolls made for it and models in this unit have a Weapon skill characteristic of 2+.
- Protector Protocol: While this protocol is active for this unit, halve the Movement characteristic of the models of the unit (rounding up), models in this unit have a Ballistic skill characteristic of 3+, and can ignore any or all modifiers to the Hit roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Repulsor Grid" id="649d-d625-a58a-6b61" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 5+ invulnerable save against ranged attacks. 
Each time an invulnerable saving throw is made for a model in this unit against a ranged attack, on an unmodified saving roll of 6, the attacking model&apos;s unit suffers 1 mortal wound.</characteristic>
      </characteristics>
    </profile>
    <profile name="Myrmidon Priest" id="5091-20cf-9afe-4d82" hidden="false" typeId="800f-21d0-4387-c943" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
        <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
        <characteristic name="T" typeId="9c9f-9774-a358-3a39">4</characteristic>
        <characteristic name="W" typeId="f330-5e6e-4110-0978">3</characteristic>
        <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">2</characteristic>
        <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">7</characteristic>
        <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Orbital Teleportarium" id="fa5d-0890-6bf7-6ed1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, you can set up this unit in orbit instead of setting it up on the battlefield. If you do so, then in the Reinforcements step of one of your Movement phases, you can set up this unit anywhere on the battlefield that is more than D3+6&quot; away from any enemy models.</characteristic>
      </characteristics>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="29b3-e383-9f1b-633e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
    </profile>
    <profile name="Mindlock" id="95cf-71a3-4357-3119" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit is within 6&quot; of any friendly MACHINE CULT units, models in this unit have a Weapon Skill and Ballistic Skill characteristic of 4+ and Leadership of 9.</characteristic>
      </characteristics>
    </profile>
    <profile name="Advanced Mindlock" id="c37e-d62a-40a0-b965" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit is within 6&quot; of any friendly MACHINE CULT units, models in this unit have a Weapon Skill and Ballistic Skill characteristic of 3+ and Leadership of 9.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
