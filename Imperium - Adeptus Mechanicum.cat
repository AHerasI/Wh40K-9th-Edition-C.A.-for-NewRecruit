                                  <characteristics>
                                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 6&quot; to the Range characteristic of rifle and carbine weapons that models with this dogma are equipped with.</characteristic>
                                  </characteristics>
