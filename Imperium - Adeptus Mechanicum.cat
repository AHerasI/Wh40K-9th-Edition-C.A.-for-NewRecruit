        <categoryLink name="No Force Org Slot" id="f6c7-f833-631c-4277" hidden="false" primary="true" targetId="ff36a6f3-19bf-4f48-8956-adacfd28fe74"/>
      </categoryLinks>
      <constraints>
        <constraint id="0536-5711-99b1-b805" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="1b74-612e-87f1-91cd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                <condition childId="18fe-defd-74a9-4653" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
              </conditions>
