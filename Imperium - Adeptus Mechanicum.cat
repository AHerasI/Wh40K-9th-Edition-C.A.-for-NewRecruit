              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Shooting phase, select one enemy VEHICLE unit within 18&quot; of the bearer for the ability &quot;The Eye of Xi-Lexum [Aura]&quot; take effect.</characteristic>
              </characteristics>
            </profile>
            <profile name="The Eye of Xi-Lexum [Aura]" id="d8a2-8bd7-7df2-2bf0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly AGRIPINAA CORE or AGRIPINAA KATAPHRON SERVITORS unit is within 6&quot; of this model, each time a model in that unit makes an attack that targets the selected VEHICLE unit, you can re-roll the wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
