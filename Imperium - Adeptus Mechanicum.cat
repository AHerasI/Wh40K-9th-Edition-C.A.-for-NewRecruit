            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Machine Sentience [Aura]" id="e33d-0730-546c-2f79" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;FORGE WORLD&gt; AUTOMATA unit is within 3&quot; of this model, that unit gains the CORE keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="[Action] Field Reprogramming" id="c1a3-b94d-94c8-9cba" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, any number of CYBERNETICA DATASMITH models from your army can start to perform this action. 
When the action is started, select one friendly &lt;FORGE WORLD&gt; AUTOMATA unit within 6&quot; of the model performing the action and one of the available protocols found on that unit’s datasheet. 
The action is completed at the end of your next Command phase. When it is completed, the selected protocol replaces that unit’s active protocol.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
