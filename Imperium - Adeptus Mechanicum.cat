                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="14e6-b35c-75fa-06ac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Steel mind, Iron logic" id="6d01-e8fc-c178-14cf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your opponent’s Psychic phase, when an enemy PSYKER attempts to manifest a psychic power within 18&quot; of any GRAIA units from your army. Roll one D6: on a 4+, that psychic power is denied.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="5 - Shooting phase" id="f985-5e9c-506f-03f4" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="3CP Rad-Bombardment" id="0414-720e-98d4-281c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="eb6e-bc89-7abe-0d17" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="3CP Rad-Bombardment" id="8fe8-cd0d-23c9-6a92" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, if a &lt;FORGEWORLD&gt; CHARACTER unit from your army is on the battlefield. Select one point on the battlefield and place a marker on that point. On your next Shooting phase you can resolve a Tactical Weapon attack with the following profile:</characteristic>
                  </characteristics>
                </profile>
                <profile name="3CP Rad-Bombardment" id="d0de-ffcc-a18a-0964" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (6&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D6</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-2</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical Weapon.
This weapon can only be fired once per battle. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords, that attack automatically hits the target.
Each time an attack is made with this weapon against units without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified wound roll of 2+ is always successful, and if a saving throw is failed for one of those units against an attack from this weapon, until the end of the turn, subtract 1 from the Toughness characteristic of each model in that unit.
When targeting units with 10 or more models, change this weapon&apos;s Type to Heavy 2D6.
Blast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Deafening Assault" id="2720-f6df-ee6a-711c" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Metalica</comment>
              <constraints>
                <constraint id="e219-8a5f-2e27-b71d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="38c7-fc6f-1445-68e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Deafening Assault" id="98e8-5c20-2dbd-f3c2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a METALICA unit from your army is selected to shoot. Select one enemy unit without INORGANIC, VEHICLE or TITANIC Keywords within 12&quot; of that unit. Until the start of your next turn:
- Halve the Move characteristic of models in that enemy unit.
- That enemy unit cannot fire Overwatch or Set to Defend.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Wrath of Mars" id="bca6-1818-619f-f71c" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Mars</comment>
              <constraints>
                <constraint id="a1e0-f68c-ca05-9491" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="38c7-fc6f-1445-68e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2CP Wrath of Mars" id="e96b-9330-ebe9-b687" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, when a MARS unit is selected to shoot. Until the end of the phase, each time a model in that unit makes an attack, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Plasma Specialists" id="83d2-5166-7c17-2147" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Ryza</comment>
              <constraints>
                <constraint id="6403-f83b-9c06-ce24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
