        <profile name="Priority Target" id="766b-be69-1c30-b710" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;CULT&gt; CORE CROSSFIRE unit within 9&quot; of this model, then select one enemy unit within 36&quot; of and visible to this model. Until the end of the turn, each time this model or a model in that friendly unit makes a ranged attack against that enemy unit, that enemy unit is treated as being Exposed for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Jackal" id="cfdf-db48-f88a-49c4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Outrider" id="60c3-182f-aaae-8bd5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this model, subtract 1 from that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
