        <profile name="Spiritual Leader [Aura]" id="50b6-d54d-3114-f562" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CULT&gt; INFANTRY or &lt;CULT&gt; BIKER unit is within 6&quot; of this model, each time a model in that unit would lose a wound as a result of a mortal wound in the Psychic phase, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Magus" id="6a4e-47cc-7a50-cb62" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
