                <profile name="Clandestine" id="5568-84cd-6067-8bc6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is within an Area Terrain feature, enemy models cannot target it with ranged attacks unless they are within 12&quot; of it. Each time a ranged attack is made against this model, subtract 1 from that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
