          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="15"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
