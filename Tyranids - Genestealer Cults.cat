        <profile name="Sacred Cult Banner [Aura]" id="0284-9b3f-6f50-edc6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CULT&gt; INFANTRY, &lt;CULT&gt; BIKER or &lt;CULT&gt; CHARACTER unit is within 6&quot; of this model, add 1 to charge rolls made for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nexus of Devotion" id="5d91-601f-f4e6-6c95" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if a friendly &lt;CULT&gt; CORE unit is within 6&quot; of this model, that unit can summon the cult, when doing so D3 destroyed models can be added back to that unit with their full wounds remaining. If the unit have the TROOPS battlefield role, D6 destroyed models can be added back instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
