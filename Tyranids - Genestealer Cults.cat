          </modifiers>
          <profiles>
            <profile name="Our Time Is Nigh" id="20da-20a9-65c0-ca82" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The first time this unit is selected to fight in this battle, until that fight is resolved, add 1 to the Attacks characteristic of models in this unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
