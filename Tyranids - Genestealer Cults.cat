              <profiles>
                <profile name="1CP Vengeance for the Martyred" id="69e8-ff4c-75cc-5164" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when a PAUPER PRINCES CHARACTER model from your army is destroyed by an enemy unit. Until the end of the battle, each time a friendly PAUPER PRINCES model makes a melee attack that targets that enemy unit, re roll the wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
