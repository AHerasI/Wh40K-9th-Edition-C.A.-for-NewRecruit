            <selectionEntry name="6 - Betraying shades" id="17ee-0dd1-08a4-6971" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6a28-188c-79f8-1c7e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
