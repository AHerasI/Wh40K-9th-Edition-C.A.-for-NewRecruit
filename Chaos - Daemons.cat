                <profile name="Unholy Frenzy" id="847a-0e54-daa0-7c50" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Keep a tally each time this model destroys an enemy model. Once this tally has reached 8, add 1 to this model’s Movement, Strength and Attacks characteristics.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Prince of Khorne [Aura]" id="b4ee-a444-29b3-797d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly FACTION: CHAOS DAEMONS KHORNE CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
                  </characteristics>
                </profile>
