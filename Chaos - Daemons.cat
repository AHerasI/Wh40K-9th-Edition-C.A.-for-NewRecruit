          <selectionEntries>
            <selectionEntry name="1CP Contempt for Sorcery" id="087a-27a6-26d3-0c0b" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Khorne</comment>
              <constraints>
                <constraint id="f4d5-2349-66f1-d900" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
