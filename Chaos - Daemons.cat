            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">10</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4</characteristic>
          </characteristics>
        </profile>
        <profile name="Agonise Machine Spirits" id="8ca7-862e-9f1c-2aa8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When you select this ability, select one enemy VEHICLE unit within 18&quot; of and visible to this model. Until the start of your next Command phase, halve the Move and Attacks characteristics of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Vashtorr the Arkifane" id="3059-1767-ae5f-6eee" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">2</characteristic>
            <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">2</characteristic>
            <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite, 2 from Warp Storm discipline.</characteristic>
            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Bringer of Scrapcode" id="eff9-9561-4014-9586" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can enrage one friendly VEHICLE model within 3&quot;. If it does so, until the start of your next Command phase, each time that VEHICLE model makes a ranged attack, add 1 to that attack’s hit roll. Each model can only be enraged once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Engine overseer" id="d895-6ffe-5739-d412" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Possessed VEHICLES within 6&quot; are not obliged to charge, and cannot become Unleashed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Mechanisms" id="a958-f11d-b3a8-c0fd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can repair up to two friendly &lt;LEGION&gt; VEHICLE models within 3&quot; of it. Each VEHICLE model regains up to D3 lost wounds. Each model can only be repaired once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Possesions" id="1a21-c697-34fd-2fc5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per Battle, in your Command phase, you can select one POSESSED VEHICLE from your Army up to 18&quot; away and visible from this model. When doing so:
- That VEHICLE loses the CORE Keyword, gains the CHARACTER Keyword, and, until the end of the battle, add 2 to the Attacks and Strength Characteristics of the Model.
- You must remove your Vashtorr the Arkifane model from the Battlefield, that model is not considered to be destroyed. If the selected VEHICLE model is destroyed, after resolving any rules affecting that unit when destroyed (as Explodes), You must place Vashtorr model back up on the battlefield as close as possible to where they were destroyed and not within Engagement Range of any enemy models, with the same wounds remaining it had before being removed in the first place.</characteristic>
          </characteristics>
        </profile>
      </profiles>
