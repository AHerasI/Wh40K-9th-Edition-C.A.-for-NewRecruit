                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Pestilent Inspiration" id="7831-e54b-8e66-00a9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Psychic phase. Select one LEGIONES DAEMONICA NURGLE PSYKER model from your army. Until the end of the phase, that model knows all of the psychic powers from the Warprot discipline.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="5 - Shooting phase" id="5948-f066-9478-9f2d" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="1CP Minions of Magic" id="92d7-2401-997a-3b11" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Tzeentch</comment>
              <constraints>
                <constraint id="4197-cead-dca7-94cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
