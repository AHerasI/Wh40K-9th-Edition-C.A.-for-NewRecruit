          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an attack is made against this model, your opponent cannot re-roll the hit roll.
- Each time an attack is made against this model, subtract 1 from that attack’s hit roll and wound roll.
- Each time a ranged attack is made against this model, subtract 1 from that attack’s Damage characteristic (to a minimum of 1).</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Torment [Aura]" id="8fd5-808d-0dd8-d139" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this model, each time a Combat Attrition test is taken for that unit, subtract 1 from that Combat Attrition test.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Dark Master [Aura]" id="7ac2-d359-923d-f3dd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly FACTION: CHAOS DAEMONS CORE or DISCIPLES OF BE’LAKOR unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spiteful Jealousy" id="cf67-001b-8006-872d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack against a GREATER DAEMON model, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Be’lakor" id="3b57-f520-6c68-b2d8" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
