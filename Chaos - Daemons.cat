                <profile name="Swallow Energy" id="672c-68d4-9b82-5afd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model would lose a wound as a result of a mortal wound, roll one D6: on a 2+, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Herald of Slaanesh [Aura]" id="1602-4360-7601-a5f9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly FACTION: CHAOS DAEMONS SLAANESH CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, you can re-roll a wound roll of 1.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Contorted Epitome" id="e4d3-19c5-33c2-bbc0" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
                  <characteristics>
                    <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">2</characteristic>
                    <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">1</characteristic>
                    <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite, 2 from the Soulstain discipline.</characteristic>
                    <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="69d7-b45e-00a2-7e46" type="set" value="Smite, 2 from the Soulstain/Noctis discipline.">
                      <conditions>
                        <condition childId="cffd-9248-7721-6a16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Horrible Fascination [Aura]" id="ee1a-f26e-0f9c-04aa" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this model, at the start of your opponent’s Command phase, your opponent must roll 2D6 for that unit. If the result is higher than that unit’s Leadership characteristic, until the start of your opponent’s next Command phase:
- Halve the Move characteristic of models in that unit.
- Each time a model in that unit makes an attack, subtract 1 from that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
