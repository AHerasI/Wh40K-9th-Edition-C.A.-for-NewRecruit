          <selectionEntries>
            <selectionEntry name="1CP Warp Portal" id="f948-bf19-1bb2-18ba" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Tzeentch</comment>
              <constraints>
                <constraint id="1519-f007-3500-abc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
