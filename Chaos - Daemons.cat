            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry name="1 - Winds of the Warp" id="06c6-149c-56e4-c7ad" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8c7d-af0b-86ec-e538" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
