                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Winds of the Warp has a warp charge value of 6. If manifested, until the start of your next Psychic phase:
- Each time this PSYKER loses a wound, roll one D6: on a 5+, that wound is not lost.
- If the result of the Psychic test was 8 or more, while a friendly VEHICLE model is within 6&quot; of this PSYKER, each time that model loses a wound, roll one D6: on a 6, that wound is not lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2 - Vortex terrors" id="6ce3-4a9c-df84-5ffd" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1967-32e9-41ab-c812" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
