                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="11a0-1562-512f-d63b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2/1CP Frenetic Bloodlust" id="955b-29d6-aece-ee5a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Fight phase. Select one BLOODLETTERS CORE unit from your army.
- If that unit is not within Engagement Range of any enemy units, make a Normal Move of up to 6&quot; with that unit. It must end this move closer to the closest visible enemy unit.
- If that unit is within Engagement Range of any enemy units, make a pile-in move with that unit.
If this unit makes a Normal Move, this Stratagem costs 2CP; otherwise, it costs 1CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Warp Jaws" id="7547-8c3b-88c9-994e" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Tzeentch</comment>
              <constraints>
                <constraint id="4f14-7f9b-4406-742d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="4097-5f68-1097-1f16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Warp Jaws" id="9f6c-91d2-2e9d-50de" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a SCREAMERS, FATESKIMMER or BURNING CHARIOT unit from your army is selected to fight. Until the end of the phase, each time an attack is made with a lamprey bite or Screamer bites by a model in that unit, add 1 to that attack’s wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP The Endless Dance" id="f6b5-0cb0-110e-cd3f" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Slaanesh</comment>
              <constraints>
                <constraint id="14d2-b9da-9843-bea9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="5b82-0ba7-db61-82db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP The Endless Dance" id="384f-08c6-c662-aa3e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when a DAEMONETTES unit from your army is selected to fight. Until the end of the phase, each time a model in that unit makes a pile-in or consolidation move, it can move up to an additional 3&quot;. This is not cumulative with any other rule that increases the distance models can pile in or consolidate.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Impossible Elegance" id="6ba9-254e-f70c-1335" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Slaanesh</comment>
              <constraints>
                <constraint id="8917-81bf-d077-7545" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="5b82-0ba7-db61-82db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Impossible Elegance" id="ce22-21d1-7d8f-785e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Fight phase. Select one FACTION: CHAOS DAEMONS SLAANESH CHARACTER model from your army (excluding CHARIOT and VEHICLE units). Until the end of the phase, each time a melee attack is made against that unit, an unmodified hit roll of 1-3 always fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="8 - Morale phase" id="32c4-c452-47da-fbe3" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Insane bravery" id="192f-bbfd-9aea-9c88" collective="false" hidden="false" import="true" targetId="fd81-28f9-2791-da19" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="9 - Taking casualties" id="8f2f-ea9d-6a56-26f3" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="1CP Emergency debarkation" id="fb35-3af4-b3d7-0702" collective="false" hidden="false" import="true" targetId="415e-3aee-52d6-8680" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="1CP Revolting constitution" id="2f03-bcbc-c15f-d552" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Nurgle</comment>
              <constraints>
                <constraint id="c6f1-0bd7-389c-b93b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="2226-f82a-fe58-178d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Revolting constitution" id="b174-0dd2-cf7b-e90e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when a PLAGUEBEARER’s unit from your army is selected as the target of an attack. Until the end of the phase, each time an attack is made against that unit, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="  Warp Storm Effects" id="4a5a-2102-7942-be93" collective="false" hidden="true" import="true" type="upgrade">
      <constraints>
        <constraint id="0955-7dc7-7690-c40a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="14bf-117c-a416-6156" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="min" value="-1"/>
        <constraint id="652e-8bc8-7a15-7509" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Warp Storm Effects Undivided" id="49d2-e82d-a408-a1b4" hidden="false">
          <profiles>
            <profile name="Undivided: Insidious Whispers" id="9d44-ed62-ad4e-1bc6" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Psychic</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, while an enemy PSYKER unit is within 12&quot; of a FACTION: CHAOS DAEMONS unit from your army, each time a Psychic test is taken for that PSYKER unit, it suffers Perils of the Warp on any dice roll that includes a double, instead of only a double 1 or double 6.</characteristic>
              </characteristics>
            </profile>
            <profile name="Undivided: Descending Shadow" id="9f3a-5656-0472-82bd" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Opp. Shooting</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time a ranged attack is made against a FACTION: CHAOS DAEMONS unit from your army, if the attacker is more than 12&quot; away, subtract 1 from that attack’s hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="Undivided: Otherworldly Tread" id="d0c0-fb43-d190-0507" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Charge</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, FACTION: CHAOS DAEMONS units from your army can ignore any or all modifiers to their Move characteristic, Advance rolls and charge rolls.</characteristic>
              </characteristics>
            </profile>
            <profile name="Undivided: Magnified Glory" id="3743-1eab-69a4-1646" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Turn start</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the turn, add 3&quot; to the range of aura abilities of FACTION: CHAOS DAEMONS units from your army.</characteristic>
              </characteristics>
            </profile>
            <profile name="Undivided: Music of the Warp" id="b946-bbf7-1ef8-aa64" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">2</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Turn start</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the turn, add 6&quot; to the range of the Daemonic Terror ability for INSTRUMENT units from your army (to a maximum of 12&quot;).</characteristic>
              </characteristics>
            </profile>
            <profile name="Undivided: Dark Invigoration" id="c3eb-a4f3-c311-0d2f" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">4</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Morale</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">One model in each FACTION: CHAOS DAEMONS unit from your army can regain up to D3 lost wounds. 
If every model in that unit has a Wounds characteristic of 1, that unit can instead be replenished. When a unit is replenished, you can return D3 destroyed models to that unit with their full wounds remaining.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Warp Storm Effects Khorne" id="f075-1eb8-5216-6c0e" hidden="true">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e066-5e09-b1d1-6ae0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="4a5a-2102-7942-be93" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Khorne: Overwhelming Rage" id="1da7-fef1-84f3-c10c" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Opp. Movement</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time an enemy unit (excluding AIRCRAFT units) within Engagement Range of any FACTION: CHAOS DAEMONS KHORNE units from your army is selected to Fall Back, roll one D6: on a 4+, that unit cannot Fall Back.</characteristic>
              </characteristics>
            </profile>
            <profile name="Khorne: Burning Terror" id="f7ee-c6ce-30aa-cfac" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Own Shooting</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Roll one D6 for each enemy unit wholly within 12&quot; of any FACTION: CHAOS DAEMONS KHORNE units from your army and that is not wholly within an Area Terrain feature. On a 6, that unit suffers D3 mortal wounds. Each unit can be affected by this ability once per phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="Khorne: Fury of Khorne" id="c0a1-997d-a921-d3a1" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Fight</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, add 1 to the Attacks characteristic of FACTION: CHAOS DAEMONS KHORNE models from your army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Warp Storm Effects Nurgle" id="64b8-299f-15cd-832c" hidden="true">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="d5ca-16c2-f4fb-1796" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="4a5a-2102-7942-be93" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Nurgle: Wave of Sickness" id="642a-cff1-a431-69b6" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Own Shooting</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Roll one D6 for each enemy unit wholly within 12&quot; of one or more FACTION: CHAOS DAEMONS NURGLE units from your army. On a 6, that unit suffers D3 mortal wounds. Each unit can be affected by this ability once per phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="Nurgle: Plague of Rust" id="0eec-fe16-b69f-428d" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Fight</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time a FACTION: CHAOS DAEMONS NURGLE model from your army makes a melee attack against an enemy VEHICLE unit, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="Nurgle: Swarming Insects" id="1fa2-2ea2-d327-9cab" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Fight</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time a FACTION: CHAOS DAEMONS NURGLE model from your army makes a melee attack, add 1 to that attack’s hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Warp Storm Effects Slaanesh" id="28f1-fb11-d03b-2c08" hidden="true">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="cf3a-c8ad-2665-4839" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="4a5a-2102-7942-be93" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Slaanesh: Dark Hallucinations" id="6cd0-9ded-04bc-90b1" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">1</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Turn start</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the turn, while an enemy unit is wholly within 12&quot; of one or more FACTION: CHAOS DAEMONS SLAANESH units from your army, each time that enemy unit starts to perform an action, roll 2D6. If the result is greater than that enemy unit’s Leadership characteristic, that action fails and that enemy unit suffers D3 mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Slaanesh: Lighting Speed" id="b4d3-107c-b1b9-c82d" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">2</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Movement / Charge</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the turn, each time an Advance roll or Charge roll is made for a FACTION: CHAOS DAEMONS SLAANESH unit from your army, add 1 to the result.</characteristic>
              </characteristics>
            </profile>
            <profile name="Slaanesh: Mesmerising Dance" id="f9d9-82c8-61d1-76ea" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Fight</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, substract 1 from the Attacks characteristic (to a minimun of 1) of models in enemy units within engagement range of FACTION: CHAOS DAEMONS SLAANESH units from your army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Warp Storm Effects Tzeentch" id="e8f0-e0c5-1669-455f" hidden="true">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="2c9f-8aba-dc69-fc5e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="4a5a-2102-7942-be93" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Tzeentch: Rampant Mutation" id="1ccc-d188-2336-7c02" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Fight</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time a FACTION: CHAOS DAEMONS TZEENTCH model from your army makes a melee attack, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
              </characteristics>
            </profile>
            <profile name="Tzeentch: Sorcerous Winds" id="af36-6512-f5b2-2a0e" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">2</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Psychic</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, each time a Psychic test is taken for a FACTION: CHAOS DAEMONS TZEENTCH unit from your army, add 1 to that Psychic test.</characteristic>
              </characteristics>
            </profile>
            <profile name="Tzeentch: Deluge of Fire" id="3ea0-e398-75a8-89be" hidden="false" typeId="c2dd-31fe-ac5b-f7e0" typeName="Warp Storm Power">
              <characteristics>
                <characteristic name="WSP" typeId="8f4d-00b0-e713-874a">3</characteristic>
                <characteristic name="Phase" typeId="4882-857e-b1c5-7768">Own Shooting</characteristic>
                <characteristic name="Description" typeId="fa6c-db41-69e9-3714">Until the end of the phase, improve the Ballistic Skill characteristic of FACTION: CHAOS DAEMONS TZEENTCH models from your army by 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
