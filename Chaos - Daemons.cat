                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase. Select one FACTION: CHAOS DAEMONS SLAANESH CHARIOT unit from your army. Remove that unit from the battlefield and place it into Strategic Reserves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
