                  <conditions>
                    <condition childId="11a0-1562-512f-d63b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Contempt for Sorcery" id="4fa7-ff27-35bb-58c7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your opponent’s Psychic phase, after a Psychic test is passed for an enemy PSYKER unit and after any Deny the Witch attempt is made. If that enemy PSYKER unit is within 24&quot; of any FACTION: CHAOS DAEMONS KHORNE units from your army, roll one D6, adding 1 to the result if that enemy PSYKER is within 12&quot; of any FLESH HOUNDS units from your army: on a 4+ that psychic power is denied.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Pestilent Inspiration" id="202e-24ee-bc7f-054a" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Nurgle</comment>
              <constraints>
                <constraint id="1d16-449e-f1a3-4b3e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
