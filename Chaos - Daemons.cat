        <profile name="Master of Magicks" id="3e6c-d22f-011f-830d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test is taken for this model, add 1 the result. If this model has 14 or more wounds remaining, add 2 to the result instead.</characteristic>
