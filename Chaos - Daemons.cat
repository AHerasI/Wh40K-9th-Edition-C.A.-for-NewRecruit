                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Fleshy Abundance has a warp charge value of 7.
If manifested, select one friendly FACTION: CHAOS DAEMONS NURGLE CORE unit within 18&quot; of and visible to this PSYKER.
Until the start of your next Psychic phase, add 1 to the Toughness characteristic of models in that unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3 - Nurgle’s Rot" id="6160-2e27-fad6-d5d6" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cc21-1848-6c4d-0ecc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
