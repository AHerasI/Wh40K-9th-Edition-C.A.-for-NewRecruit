                <profile name="One Head Looks Forward" id="057a-d6cb-975d-8092" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you or your oponnent use a Stratagem, roll one D6 for each CP used in that stratagem, on a 6, you gain one CP.</characteristic>
