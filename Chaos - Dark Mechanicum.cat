                  <conditions>
                    <condition childId="11b9-32f1-0c64-01e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Electro-shocked" id="7906-534e-0acd-e45b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Fight phase. Select one enemy unit without VEHICLE or MONSTER Keywords within Engagement Range of a HERETEK CULT CORE or HERETEK CULT CHARACTER unit from your army. Until the end of the phase, that enemy unit is not eligible to fight until after all eligible units from your army have done so.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Unbridled Canrnage" id="b729-a7aa-0e2a-cc47" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ba58-8b4e-acb8-4b9d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
