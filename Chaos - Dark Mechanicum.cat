              <profiles>
                <profile name="Dark Matter crystal" id="fecc-bca9-1207-78d9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of your Movement phase, you can select the bearer or a friendly CHAOS INFANTRY or BEAST unit within 12&quot; of him. Remove that unit from the battlefield and immediately set it up anywhere on the battlefield that is more than 9&quot; from any enemy models. This does not count as Falling Back if the unit was within 1&quot; of any enemy models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
