        <profile name="Knowlegde of flesh [Aura]" id="f1d1-2961-353e-6b9d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HERETEK&gt; CORE unit is within 6&quot; of this model, each time a model would lose a wound, roll one D6: on a 5+, that wound is not lost. If the model already has a similar ability, add 1 to the result of the roll.</characteristic>
          </characteristics>
        </profile>
