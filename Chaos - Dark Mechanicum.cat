        <profile name="Aura of Dark Majesty" id="6ab2-6337-12f9-9a7b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save. Each time an attack is made against this model, subtract 1 from that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gift of the Hellforge [Aura]" id="a93d-4975-3a39-53ba" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HERETEK&gt; VEHICLE unit is within 6&quot; of this model, add 1 to the Attacks and Leadership characteristics of models in its unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Infernal Augmetics" id="012f-8cca-6ff3-a87a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Command phase, this model regains 1 lost wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Engine overseer [Aura]" id="e002-e763-16bb-3e01" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Possessed VEHICLES within 6&quot; are not obliged to charge, and pass automatically Unleash checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
