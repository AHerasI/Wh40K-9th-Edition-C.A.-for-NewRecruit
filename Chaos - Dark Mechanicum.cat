                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a HERETEK CULT CORE or CHARACTER unit within 6&quot; of this WARLORD makes an attack with a Plasma weapon using the Overcharged profile, on a hit roll of 1 neither the bearer of that weapon is destroyed or the unit suffers Mortal wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="RX - Master Genetor" id="d214-974f-fb3e-497b" collective="false" hidden="true" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
