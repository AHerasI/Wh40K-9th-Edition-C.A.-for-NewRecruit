              </modifiers>
              <profiles>
                <profile name="1CP Restore Reactive armour" id="8e53-6359-fdcb-436c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the end of your Movement phase. Select one HERETEK CULT VEHICLE model in your army. Ir restores up to D3 used Reactive Armour Packages it had at the beggining of the battle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
