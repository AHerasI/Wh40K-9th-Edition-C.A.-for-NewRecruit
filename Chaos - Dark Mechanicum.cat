              </modifiers>
              <profiles>
                <profile name="2CP Daemonforge" id="9295-5571-9b70-ac8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting or Fight phase when a HERETEK CULTS DAEMON ENGINE unit is chosen to attack. You can re-roll all failed hit and wound rolls for that unit until the end of the phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3CP Rad-Bombardment" id="bdfc-34b8-69a1-afea" collective="false" hidden="false" import="true" type="upgrade">
              <comment>Heretek</comment>
              <categoryLinks>
                <categoryLink name="Tactical Weapon" id="0777-3c59-4285-d115" hidden="false" primary="false" targetId="9369-4930-4f3e-67a4"/>
              </categoryLinks>
              <constraints>
                <constraint id="5772-ed38-afbc-34b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
