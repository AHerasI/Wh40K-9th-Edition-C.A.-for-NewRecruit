                            <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
                            <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">If a CHARACTER is destroyed by this weapon, you can add a Chaos Spawn to your army. Set up the Chaos Spawn within 6&quot; of Magnus and more than 1&quot; from any enemy models.</characteristic>
                          </characteristics>
                        </profile>
