                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each  time this WARLORD uses Master of Technology ability, do not roll a D3, The target unit regains up to 5 Wounds instead.</characteristic>
                  </characteristics>
