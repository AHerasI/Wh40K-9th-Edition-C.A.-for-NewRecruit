          <selectionEntries>
            <selectionEntry name="Adeptus Mechanicus Explorator Fleets" id="11b9-32f1-0c64-01e2" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
