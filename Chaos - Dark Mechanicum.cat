                  <conditions>
                    <condition childId="11b9-32f1-0c64-01e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="3CP Rad-Bombardment" id="20b6-e04d-bdb7-b155" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, if a HERETEK CULT CHARACTER unit from your army is on the battlefield. Select one point on the battlefield and place a marker on that point. On your next Shooting phase you can resolve a Tactical Weapon attack with the following profile:</characteristic>
                  </characteristics>
                </profile>
                <profile name="3CP Rad-Bombardment" id="2359-a660-ec1c-534c" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (6)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D6</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">2</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical Weapon.
This weapon can only be fired once per battle. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords, that attack automatically hits the target.
Each time an attack is made with this weapon against units without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified wound roll of 2+ is always successful, and if a saving throw is failed for one of those units against an attack from this weapon, until the end of the turn, subtract 1 from the Toughness characteristic of each model in that unit.
When targeting units with 10 or more models, change this weapon&apos;s Type to Heavy 2D6.
Blast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Methodical Destruction" id="0ef7-c35e-7363-9ccd" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="50e7-e3d9-7961-85c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="2d09-dec9-0451-4187" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Methodical Destruction" id="9300-5550-def6-ec81" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase, after a HERETEK CULT unit from your army has finished making its attacks. Select one enemy unit that was targeted by an attack made by a model in that unit this phase. Until the end of the phase, each time an attack is made by a model in another friendly HERETEK CULT unit against that enemy unit, add 1 to that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Phospex weaponary" id="be0e-ecde-5e49-3a8e" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e6c6-7f71-6d17-b6fb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="2d09-dec9-0451-4187" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Phospex weaponary" id="b4be-8ea8-6315-687d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Shooting phase when an HERETEK CULT unit from your army is selected to shoot. Until the end of the phase, each time a model in that unit makes an attack with a flame weapon or a phosphor weapon, on a wound roll of 6+, the target suffers 1 mortal wound in addition to any normal damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
