  <sharedInfoGroups>
    <infoGroup name="Out of Bounds ability table" id="c602-4abb-0beb-74f4" hidden="false">
      <profiles>
        <profile name="-6-" id="5505-cc0c-5937-9954" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units reduce their Leadership characteristic by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="-5-" id="03a2-2583-7bbc-1c7d" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units, when receiving a Stratagem, must first roll 2D6, if the result is less than the Leadership characteristic of the unit, the Stratagem has no effect on that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="-4-" id="1595-a996-87cc-087a" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units are always considered to be in Difficult Ground.</characteristic>
          </characteristics>
        </profile>
        <profile name="-3-" id="bd42-8491-eec7-e8d3" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units cannot re-roll the Hit roll, irrespective of any abilities that the weapon or the unit may have.</characteristic>
          </characteristics>
        </profile>
        <profile name="-2-" id="d2b4-0737-ee11-2bd6" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units cannot be affected by friendly Aura abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="-1-" id="3320-a8bb-ba62-3213" hidden="false" noindex="true" typeId="7197-cdbf-69ea-aee8" typeName=" D6 Roll">
          <characteristics>
            <characteristic name="Out of Bounds ability" typeId="aba7-eecc-2e6b-c033">HERETEK CULT units, when making an attack, must re-roll wounds rolls of 6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
  </sharedInfoGroups>
  <sharedProfiles>
    <profile name="Repulsor Grid" id="ea6a-edd6-66f6-ec80" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 5+ invulnerable save against ranged attacks. 
Each time an invulnerable saving throw is made for a model in this unit against a ranged attack, on an unmodified saving roll of 6, the attacking model&apos;s unit suffers 1 mortal wound.</characteristic>
      </characteristics>
    </profile>
