          <selectionEntries>
            <selectionEntry name="1CP Chaos Boon" id="699c-badb-a778-ab50" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fe01-033f-46ea-cd07" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="2d09-dec9-0451-4187" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Chaos Boon" id="a206-f13a-3f49-6548" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the end of a Fight phase in which one of your HERETEK CULT CHARACTERS (excluding DAEMONIC CHARACTERS) slays an enemy CHARACTER, VEHICLE or MONSTER. Roll 2D6 and look up the result below.

- 2----------	Your character suffers 1D6 Mortal wounds. If the character is slain by those Mortal Wounds, before removing the model as a casualty, you can add a Chaos Spawn to your army. If you do so, set up the Chaos Spawn within 6&quot; of the character and more than 1&quot; from any enemy models before removing them as a casualty.
- 3-4	-------	Until the end of the Battle, you can re-roll the Hit roll for attacks made by this character and add 1 to all saving throws made for the character.
- 5-6	-------	Until the end of the Battle, add 1 to the character’s Strength and Attacks characteristics.
- 7-8	-------	Until the end of the Battle, unmodified hit rolls of 1-3 that target the character in the Fight phase fail, irrespective of any abilities that the weapon or the model making the attack may have, and add 3&quot; to the character’s Move characteristic.
- 9-10------	Until the end of the Battle, add 1 to the character’s Toughness and Wounds characteristic.
- 11-12----	Your character regains all it&apos;s lost Wounds and, until the end of the Battle, gains DAEMONIC Keyword and abilities.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Electro-shocked" id="d4ec-7624-2bbe-ce3c" collective="false" hidden="false" import="true" type="upgrade">
              <comment>Heretek</comment>
              <constraints>
                <constraint id="fadf-e53d-bec3-2754" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
