              </modifiers>
              <profiles>
                <profile name="1CP Unbridled Canrnage" id="f43c-e96a-21b1-5911" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the Fight phase. Select one CHAOS CORE, HERETEK CULT CORE or HERETEK CULT CHARACTER unit from your army. Until the end of the phase, each time a model in that unit makes an attack, it scores an additional hit on an unmodified hit roll of 6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
