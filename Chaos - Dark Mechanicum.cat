            <selectionEntry name="Heretek Cult - Radical Xenobiologists" id="b833-3092-cceb-3666" collective="false" hidden="false" import="true" type="upgrade">
              <comment>Unidades biológicas mejoradas (tipo Fabius bile)
EldarN1 +1&quot; M
EldarN2 +Esquiva
EldarN3 +1BS +1WS
OrkN1 +1T +1A
OrkN2 +1WS -1BS +1A
OrkN3 +1S +1A +FNP5+
NydsN1 +1W +1Sv
NydsN2 +Weapons -1Ld
NydsN3 +Chamaleon</comment>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="-1"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="11b9-32f1-0c64-01e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ea6d-e6f8-94d0-e336" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
