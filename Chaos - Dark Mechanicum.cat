              </costs>
              <infoGroups>
                <infoGroup name="Adaptative Approach" id="e417-00ed-bcd8-4c32" hidden="false">
                  <infoGroups>
                    <infoGroup name="Adaptative Approach table" id="23f5-17fa-2fed-cbab" hidden="false">
                      <profiles>
                        <profile name="1" id="b09a-b3b9-f70b-0561" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units automatically pass Morale Tests on a roll of 6.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="2" id="00cf-f723-b5c9-c8f9" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units ignore Movement modifiers due to Difficult Ground.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="3" id="1344-b29c-0ff4-b2a2" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units add 2&quot; to Advance and Charge rolls.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="4" id="9922-8db6-edcf-fc57" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units can Fall back and Shoot in the same turn.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="5" id="a39c-19c1-fd6c-796e" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units can Advance and Charge in the same turn.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="6" id="79aa-4b29-6dc3-76a5" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units can Fight first during the Fight phase.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="7" id="320a-d148-4bb3-f0cf" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units add 1 to rolls regarding Abilities that allow prevent Wound loses.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="8" id="9c11-fc25-0f7a-2e9c" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units are considered to have be Remained Stationary during the Psychic, Shooting and Charge phases, even if a unit have made a Normal Move, Advanced, Fell back or Disembarked during the previous Movement Phase.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="9" id="a188-d113-dc7e-e462" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units can re-roll Invulnerable Saving throws.</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="10" id="8147-ef83-b137-8042" hidden="false" noindex="true" typeId="d76d-1615-c572-a21b" typeName="  Adaptation Points">
                          <characteristics>
                            <characteristic name="Adaptation ability" typeId="103a-0e4b-e6dc-87ec">HERETEK CULT units can re-roll rolls regarding Abilities that allow prevent Wound loses.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </infoGroup>
                  </infoGroups>
                  <infoLinks>
                    <infoLink name="Out of Bounds ability table" id="a09d-7f0b-670d-3c72" hidden="false" targetId="c602-4abb-0beb-74f4" type="infoGroup"/>
                  </infoLinks>
                  <profiles>
                    <profile name=" Adaptative Approach " id="91e9-481f-7150-1656" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beginning of the first Battle Round and in each of your Command phases, generate Adaptation points for your army as follows:
- If you choose to Adapt within parameters, roll a 1D3 and add the current Battle round to the result.
- If you choose to Push, roll a 1D6, and add the current Battle round number to the result.
Once the Evolution points have been calculated, choose one ability with an equal value or lesser than your Evolution points from the Adaptation abilities table. Until the end of the battle HERETEK CULT units from your army gain the chosen Adaptation ability.
If you have chosen to Push to the limit, HERETEK CULT units from your army gain the corresponding ability from the Out of Bounds ability table. If you already have the corresponding ability, no Out of Bounds ability is gained.
Any unspent Evolution points are lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
              </infoGroups>
              <profiles>
                <profile name="Heretek" id="f830-8510-8d46-1416" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Heretek cults have Imperium Keyword an allegiances.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
