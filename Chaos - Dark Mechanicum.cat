                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an friendly unit is within 6&quot; of this WARLORD, each time a ranged attack is made against that unit, a hit roll of 1-3 for that attack fails. Substract 1 from that attack&apos;s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="L - Enhanced fail-safes" id="0498-1966-3f64-7f2d" collective="false" hidden="true" import="true" type="upgrade">
              <costs>
