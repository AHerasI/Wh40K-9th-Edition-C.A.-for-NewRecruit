    <categoryEntry name="Faction: T&apos;au Empire" id="77ee-b03b-d244-d535" hidden="false">
      <rules>
        <rule name="Counter-fire training" id="59d1-5654-a864-afa8" hidden="false">
          <description>When a unit from Faction: T&apos;au Empire fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+ instead of a 6.
If the unit has the INFANTRY Keyword and is in a terrain with the DEFENSIBLE trait, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
