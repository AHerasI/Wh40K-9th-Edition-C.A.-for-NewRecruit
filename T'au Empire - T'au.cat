      <profiles>
        <profile name="The Eight" id="8f96-e8a3-b302-84ff" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, every model in this unit must be set up at the same time, though they do not need to be set up in unit coherency.
From that point onwards, each CHARACTER model is treated as a separate unit with it&apos;s own Power Rating.</characteristic>
          </characteristics>
        </profile>
        <profile name="Accompanying Drones" id="25fa-aba9-ba0a-2307" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a CHARACTER from the Eight is set up on the battlefield, any accompanying Drones are set up in unit coherency with it.
O&apos;vesa - 2xMV84
Ob&apos;lotai - 2xMV8
Torchstar - 2xMV7
Brightsword - 2xMV4
Farsight - Selection</characteristic>
          </characteristics>
        </profile>
      </profiles>
