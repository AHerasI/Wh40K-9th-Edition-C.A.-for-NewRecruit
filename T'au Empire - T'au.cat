                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="1CP Uplinked markerlight" id="aa4b-867e-fa98-1da4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">T’au Empire
Use this Stratagem after an enemy unit has been hit by a markerlight fired by a model from your army. Place D3+1 markerlight counters next to that unit instead of only 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2/1CP Strike and fade" id="ef47-89a7-2c1f-1258" collective="false" hidden="false" import="true" type="upgrade">
              <comment>T&apos;au Empire/Enclaves</comment>
              <constraints>
                <constraint id="3c8d-2125-8112-bde8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2/1CP Strike and fade" id="08ec-eaae-f9b8-4449" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">T’au Empire
Use this Stratagem at the start of your Shooting phase. Select one T’AU EMPIRE JET PACK unit from your army. You can shoot with that unit and then it can make a Normal Move of up to 6&quot;. That unit cannot shoot again this phase.
If that unit contains 5 or fewer models (excluding DRONE models), this Stratagem costs 1CP; otherwise, it costs 2CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Experimental weaponary" id="84b1-b992-4551-0038" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Bork&apos;an</comment>
              <constraints>
                <constraint id="595c-addc-7392-a62b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="ee1c-bd4c-f3cd-7f91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="2CP Experimental weaponary" id="444e-2866-face-73d3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bork’an
Use this Stratagem in your shooting phase, when a BORK’AN unit from your army is selected to shoot. Select one model in that unit and one weapon that model is equipped with. Until the end of the phase, each time that model makes an attack with that weapon, invulnerable saving throws cannot be taken against that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2CP Orbital ion beam" id="1f97-f321-e672-d326" collective="false" hidden="false" import="true" type="upgrade">
              <comment>T&apos;au Empire/Enclaves</comment>
              <categoryLinks>
                <categoryLink name="Tactical Weapon" id="9d81-e2c5-5961-5fbd" hidden="false" primary="false" targetId="9369-4930-4f3e-67a4"/>
              </categoryLinks>
              <constraints>
                <constraint id="405c-17ac-fa54-1ebf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="2CP Orbital ion beam" id="30ea-8924-eb31-b268" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">T&apos;au Empire
Use this Stratagem at the start of any of your Shooting phase while your Warlord is deployed on the Battlefield. You can make an attack with the Orbital ion beam weapon as the Tactical weapon rules state.
After Rectifying Telemetry, Roll 1D6 and add 6 to the result. Draw a straight, imaginary line, 2&quot; width, between the Tactical weapon marker, and put a second marker within the distance marked by the roll result. Roll attacks for each unit that the line between the two points crosses over.
You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Orbital ion beam" id="a870-5a93-f557-e7f0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (2&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D6</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">12</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">3</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">3</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical weapon. 
This weapon is fired with an unmodifiable BS of 3+. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords, that attack automatically hits the target.
Blast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
