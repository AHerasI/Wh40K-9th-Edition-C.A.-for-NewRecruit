    <categoryEntry name="Faction: T&apos;au Auxiliaries" id="4b49-c0ad-8dce-853d" hidden="false">
      <infoLinks>
        <infoLink name="For the Greater Good" id="ffad-2ba7-7d11-5afd" hidden="false" targetId="6eba-a2ea-07cd-a81d" type="profile">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="bf09-6007-1a8f-792b" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Enhanced Martial drills" id="6670-d230-1ac9-8165" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a AUXILIARY unit of a FARSIGHT ENCLAVES Detachment makes a melee attack, you can ignore any or all Hit roll modifiers. 
In addition, add 1 to the Attacks characteristic of AUXILIARY models of a FARSIGHT ENCLAVES Detachment.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="9e82-c782-b939-36b4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Trading Partners" id="8fa7-390f-3b33-ad78" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">AUXILIARY unit of a DAL&apos;YTH Detachment gains For the Greater Good ability and benefits from the Tactical Philosophy active for the Army.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="f4eb-68c4-6c1f-a9e1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Aggresive Tactics" id="6d94-1bbc-2c25-5aea" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a AUXILIARY unit of a VIOR&apos;LA Detachment makes a ranged attack with a weapon that targets a unit within 12&quot;, make an additional attack with the weapon (Rapid Fire 1--&gt; Rapid Fire 1+1), if that weapon is Twin-Linked (includes Twin in it&apos;s name), make 2 additional attacks instead.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="ccde-9fff-e83a-c26b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Defensive Tactics" id="311d-4370-93fb-4f23" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is allocated to a AUXILIARY unit of a KE&apos;LSHAN Detachment, add 1 to the Saving throw. If that AUXILIARY unit is in an Area terrain feature, add 2 to the Saving throw instead.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="1743-c8d8-9cd2-7d78" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Improved Wargear" id="8943-5d99-7d9e-bc41" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to a AUXILIARY unit of a BORK&apos;AN Detachment, add 1 to the Saving throw.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="ee1c-bd4c-f3cd-7f91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="CQB Mastery" id="6218-ac6e-fefa-d5b7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a AUXILIARY unit of a SA&apos;CEA Detachment makes a ranged attack with a weapon that targets a unit within 12&quot;, you can re-roll the Hit roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditions>
                <condition childId="70d7-6877-d9ab-20e1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Coordinated Strikes" id="8d1a-5855-2c2f-94b4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a AUXILIARY unit of a T&apos;AU Sept Detachment or a CUSTOM Sept Detachment makes an attack against a unit within 12&quot;, you can re-roll hit rolls of 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <comment>Enclaves</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="cd11-3986-f127-1a5b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                    <condition childId="367b-e23e-9f04-4be6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
      <rules>
        <rule name="Faction: T&apos;au Auxiliaries" id="2bd6-af81-d7ac-73b1" hidden="false">
          <description>Units with this Faction Keyword, in regard army making, should be treated as T&apos;AU EMPIRE SEPT units, except for the Auxiliaries of the T&apos;au Empire Rule.</description>
        </rule>
        <rule name="Urban combat training" id="12e0-4caa-cd20-56c7" hidden="false">
          <description>When a unit from Faction: T&apos;au Auxiliaries fires Overwatch or Searching for Targets, it scores a hit on a unmodified roll of 5+ instead of a 6.
If the unit has the INFANTRY Keyword and is in a terrain with the DEFENSIBLE trait, it scores a hit on a unmodified roll of 4+.</description>
        </rule>
      </rules>
    </categoryEntry>
