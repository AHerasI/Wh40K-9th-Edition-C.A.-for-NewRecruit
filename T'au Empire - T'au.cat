    <profile name="For the Greater Good" id="6eba-a2ea-07cd-a81d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly unit with this ability is within 6&quot; of this unit, each time an enemy unit declares a charge against this unit, that friendly unit can fire Overwatch before the charge roll is made. If it does so, until the end of the phase, that friendly unit cannot fire Overwatch again.</characteristic>
      </characteristics>
    </profile>
