                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DAL&apos;YTH or T&apos;AU AUXILIARY unit (excluding CHARACTER units) is within 6&quot; of this WARLORD, add 1 to the Leadership characteristic of models in that unit.</characteristic>
                  </characteristics>
                </profile>
