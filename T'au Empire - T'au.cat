      </characteristics>
    </profile>
    <profile name="Threat Identification Protocol" id="7ce6-3920-7846-6dd5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this ability makes a ranged attack, it can only target the closest eligible unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Twin Pulse Carbine" id="2338-c2c9-13fd-5600" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 4</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">5</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">1</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Pulse Weapon. If the unit of the weapon&apos;s bearer is in engagement range of enemy units, this weapon changes it&apos;s profile to Pistol 4.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stealth Field Technology" id="e886-c67d-9e70-1b70" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a ranged attack is made against this unit, a hit roll of 1-3 for that attack fails. Substract 1 from that attack&apos;s hit roll.
- Each time a melee attack is made against this unit, a hit roll of 1-2 for that attack fails. Substract 1 from that attack&apos;s hit roll.
- Each time a ranged attack is allocated to a model in this unit while it is receiving the benefits of cover, add an additional 1 to any armour saving throw made against that attack.
- Enemy models cannot target a model in this unit with ranged attacks unless they are within 18&quot; of it.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Burst Cannon" id="98c5-4aec-8d03-a5ba" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 6</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">6</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">1</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Pulse Weapon.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shield Generator" id="1f25-2f70-147a-da53" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Positional Relay" id="8eff-4f5e-5707-b6e9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle round, when you set up a friendly SEPT Strategic Reserves unit, the bearer can use this wargear item. If it does, that unit counts the battle round as being one higher than the current battle round number for the purposes of determining where it can be set up, but when doing so it must be set up within 6&quot; of the bearer.</characteristic>
      </characteristics>
    </profile>
    <profile name="Counterfire Defence System" id="e644-3d8a-6730-b621" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per phase, the first time a saving throw against a ranged attack of strength 6 or more is failed for the bearer’s unit, the Damage characteristic of that attack is changed to 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Advanced Targeting System" id="4da7-d875-5254-178c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer&apos;s unit makes a ranged attack, it ignores any or all wound roll modifiers.</characteristic>
      </characteristics>
    </profile>
    <profile name="Early Warning Override" id="eb0d-103c-db2f-f3f9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer fires Overwatch, it scores hits on unmodified hit rolls of 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Multi-tracker" id="a2d9-8fb4-d0cd-69f9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer&apos;s unit is selected to shoot, for the purposes of determining how many attacks are made by Blast weapons models in this unit are equipped with, double the number of models in the target unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Target Lock" id="dd5b-32a9-ee1b-56f2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer&apos;s unit can advance and fire Rapid Fire, Assault, Pistol and Grenade weapons as if they had not advanced, and also shoot with Heavy Weapons, but must subtract 1 from the roll to hit when doing so, except when the target has 4+ markers, then there is no penalty to the roll to hit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Velocity Tracker" id="cb8d-7981-d717-28b5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made by the bearer&apos;s unit against a unit that can FLY, add 1 to that attack&apos;s hit roll. All attacks made by the bearer ignore the Hard to hit ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Destroyer Missile" id="d38a-74f6-ad60-31f2" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">72</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">12</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">5</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D3+3</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">The bearer can only shoot with each destroyer missile it is equipped with once per battle. Each time the bearer is selected to shoot, it cannot shoot with more than two of the destroyer missiles it is equipped with.</characteristic>
      </characteristics>
    </profile>
    <profile name="Commander in XV8 Crisis Battlesuit" id="0f18-103c-0bf8-75a7" hidden="false" typeId="800f-21d0-4387-c943" typeName="Model">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">10</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">2</characteristic>
        <characteristic name="S" typeId="2218-aa3c-265f-2939">5</characteristic>
