            <profile name="Volley Fire [Aura]" id="f61d-a782-07f7-66c6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly SEPT INFANTRY CORE unit is within 6&quot; of this model, each time a CORE model in that unit, excluding BATTLESUIT models, makes an attack with a pulse weapon, an unmodified hit roll of 6 scores one additional hit.</characteristic>
              </characteristics>
