        <profile name="Enclave Commander" id="d5e8-cf2d-8190-95f4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, this model must be your army&apos;s WARLORD. If more than one model in your army has a rule to this effect, then one of those models must be your army&apos;s WARLORD.</characteristic>
          </characteristics>
        </profile>
        <profile name="Way of the Short Blade" id="7eed-1d60-1be1-de20" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, you can select one friendly FARSIGHT ENCLAVES CORE unit within 6&quot; of this model, until the end of the phase, each time a CORE model in that unit makes an attack, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
