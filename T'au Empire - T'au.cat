            <profile name="Hardened Armour" id="e062-63db-5ec0-1f4e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this unit&apos;s XV85 ENFORCER BATTLESUIT COMMANDER model, subtract 1 from the Damage characteristic of that attack (to a minimum of 1).</characteristic>
              </characteristics>
            </profile>
            <profile name="Resolute Firebase" id="1699-ea97-7404-c0c5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly SEPT BATTLESUIT CORE unit within 9&quot; of this unit&apos;s XV85 ENFORCER BATTLESUIT model. Until the start of your next Command phase, that unit gains the Objective Secured ability.</characteristic>
              </characteristics>
            </profile>
