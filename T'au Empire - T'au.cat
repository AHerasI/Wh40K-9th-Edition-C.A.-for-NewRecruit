              </costs>
              <profiles>
                <profile name="Precision of the Hunter" id="44e1-f269-12e0-7a16" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD makes an attack, you can re-roll the Hit roll and you can re-roll the Wound roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="2. Through Unity, Devastation" id="0691-c761-7f70-b0ca" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f3d9-8517-9894-ad8b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="d9d8-697b-a9d2-5af9" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Through Unity, Devastation [Aura]" id="30b8-38ee-3a44-fd3c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly SEPT CORE unit within 9&quot; of this WARLORD. Until the start of your next Command phase, each time a CORE model in that unit makes a ranged attack, an unmodified hit roll of 6 scores an additional hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="3. A Ghost Walks Among Us" id="dbea-7777-90b2-3af0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="312e-92f9-5d51-af8f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="df1d-c8cd-9311-7ed8" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="A Ghost Walks Among Us" id="50a3-b5c6-2588-9ea5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a melee attack is made against this WARLORD, a hit roll of 1-3 always fail.
- Each time an attack is made against this WARLORD, subtract 1 from that attack&apos;s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="4. Through Boldness, Victory" id="7c4c-06f2-ca8d-4e1d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f951-a2bf-cd6e-6002" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="8877-0898-5f9a-d6ee" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Through Boldness, Victory [Aura]" id="9135-3003-edff-a6cf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD Moves, Advances or Falls back, it counts as remained stationary.
T&apos;AU EMPIRE CORE units within 6&quot; of this WARLORD add 2&quot; to it&apos;s Advance and Charge rolls.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="5. Exemplar of the Kauyon" id="fb8e-32f6-cd63-e49c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="298b-d094-e0d4-fc93" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="003a-d17b-ae6d-be4f" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Exemplar of the Kauyon [Aura]" id="13bb-7bd9-05ff-cd74" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After both players have deployed their armies and determined who has the first turn, select up to one friendly SEPT unit, or up to three friendly SEPT units if you have selected the Kauyon Tactical Philosophy this battle, and redeploy them. If the mission uses Strategic Reserves rules, any of these units can be placed into Strategic Reserves without having to spend any additional CPs, regardless of how many units are already in Strategic Reserves. If both players have abilities that redeploy units, roll off, the winner chooses who deploys their units first.
In addition, if you have selected the Kauyon Tactical Philosophy this battle, units at 6&quot; of this WARLORD dont receive the hit roll penalty when Fell back.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="6. Exemplar of the Mont&apos;ka" id="4ca4-3797-ed65-c2d0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2afe-d8c5-dd14-8e68" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="14a6-8b7f-7fbd-5359" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="Exemplar of the Mont&apos;ka [Aura]" id="9615-502d-8f30-74dc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if you did not selected the Mont&apos;ka Tactical Philosophy this battle; select one friendly SEPT CORE unit within 9&quot; of this WARLORD. Until the start of your next Command phase, each time an attack is allocated against a CORE model in that unit, add 1 to armor saving throws.
If you selected the Mont&apos;ka Tactical Philosophy this battle, when a CORE unit within 6&quot; of this WARLORD, add 1 to armor saving throws.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
