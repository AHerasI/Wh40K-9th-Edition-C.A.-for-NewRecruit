      <profiles>
        <profile name="Redundant systems" id="5bea-7d28-30b1-ac80" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a DRONE model would lose a wound, roll one D6: on a 6+ that wound is not lost.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="self" shared="true" type="instanceOf" value="0"/>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Redundant systems" id="4030-59c4-5edf-c9d5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time a DRONE model would lose a wound, roll one D6: on a 6+ that wound is not lost.
- Each time an attack is allocated to a DRONE model subtract 1 from the Damage characteristic of that attack (to a minimum of 1).</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="self" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="7035-f55a-35c4-a233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
