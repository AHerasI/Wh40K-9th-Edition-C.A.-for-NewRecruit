                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this WARLORD would lose a wound, roll one D6; on a 4+ that wound is not lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="IH: 6. Will of Iron" id="ee43-9764-cf35-532c" collective="false" hidden="false" import="true" type="upgrade">
