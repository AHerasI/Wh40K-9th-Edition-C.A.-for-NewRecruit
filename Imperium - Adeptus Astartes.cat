            <selectionEntryGroup id="f9f6-bf96-a48a-4753" name="Warlord Traits (Space Wolves)" hidden="true" collective="false" import="true">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="3fde-546f-54d3-9266" type="equalTo"/>
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry id="3594-2b9b-38ec-a8ab" name="SW: 1. Aura of Majesty" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9962-5dfb-2314-76a6" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f417-772a-d8e4-50c7" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="1629-dbaf-6c58-673e" name=" Aura of Majesty" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Add 3&quot; to the range of this WARLORD&apos;s Rites of Battle, Tactical Precision, Chapter Master and Spiritual Leaders abilities (to a maximum of 9&quot;).
- Add 3&quot; to the range of any litanies recited by this WARLORD (to a maximum of 9&quot;).</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="c6bd-bb22-4409-96fa" name="Saga of Majesty [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">At the start of any of your Command phases, this WARLORD is within range of an objective marker that is more than 12&quot; away from your Deployment zone.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">While a friendly SPACE WOLVES CORE unit is within 6&quot; of this WARLORD, each time a Morale test is taken for that unit, it is automatically passed.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="2e00-c449-ba12-dc64" name="SW: 2. Beastslayer" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b4c7-0052-c474-c25c" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3381-7506-fa46-a308" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="3049-bd85-20c2-2495" name=" Beastslayer" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- While this WARLORD is is within Engagement Range of any enemy MONSTER or VEHICLE units, add 1 to its Attacks characteristic.
- Each time this WARLORD makes an attack against a MONSTER or VEHICLE unit, add 1 to that attack&apos;s Hit roll and add 1 to that attack&apos;s Wound roll.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="c853-da39-a581-51f6" name="Saga of the Beastslayer [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">An enemy MONSTER or VEHICLE unit is destroyed as the result of an attack made by this WARLORD.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">SPACE WOLVES CORE units within 6&quot; of this WARLORD add 1 to Wound rolls for melee attacks against VEHICLES and MONSTERS.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="02d2-aaad-13a1-8846" name="SW: 3. Hunter" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7671-2b11-5e7b-2d63" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="108b-f413-2be1-5589" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="0a9e-bcb5-071d-86a9" name=" Hunter" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Add 1 to Advance and charge rolls made for this WARLORD.
- This WARLORD is eligible to charge in a turn in which it Advanced or Fell Back.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="d1ac-e887-1acb-a619" name="Saga of the Hunter [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">Successfully charge an enemy unit with this WARLORD.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">- While a friendly SPACE WOLVES CORE unit is within 6&quot; of this WARLORD, that unit is eligible to declare a charge in a turn in which they Advanced. 
- While a friendly SPACE WOLVES CORE unit with the Swift Hunters ability is within 6&quot; of this model, that unit is eligible to declare a charge in a turn in which they Fell Back.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="f375-331f-cd43-afa6" name="SW: 4. Resolve of the Bear" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4cb7-35b7-8c5b-5d4e" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bb8f-e08b-f386-dd92" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="e1d8-6782-ffd5-696a" name=" Resolve of the Bear [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD would lose a wound, roll one D6, on a 6, that wound is not lost.
- Each time an attack is made against this WARLORD, your opponent cannot re-roll the Wound roll and cannot re-roll the Damage roll.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="a72a-7162-3ca9-dd8d" name="Saga of the Bear [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">This WARLORD loses any wounds.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">While a friendly SPACE WOLVES CORE unit is within 6&quot; of this WARLORD, each time a model in that unit would lose a wound, roll one D6; on a 6, that wound is not lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
