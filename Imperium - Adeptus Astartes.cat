                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During your Command phase, select a IGNIS KEEPERS VEHICLE within 6&quot; of this WARLORD, until your next command phase, add 1 to the Hit rolls, and during each phase, that unit can re-roll: a roll determining the number of attacks made by a weapon, a Hit roll, a Wound roll, and a Damage roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TL: 2. Fire on my Mark" id="fd1d-4e23-b805-134c" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a456-789a-e59f-8c41" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                    <constraint id="25ef-9461-312b-e464" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Fire on my Mark" id="9434-b4e1-539c-5abd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beggining of each shooting phase, this WARLORD can select one enemy MONSTER, VEHICLE, TITANIC or BUILDING unit at 36&quot; and visible to it. Add 1 to the Strength characteristic of Attacks made by IGNIS KEEPERS VEHICLE units against that target.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TL: 3. Flanking speed" id="33e3-8520-dc1d-3f1b" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="61bb-afdf-98a2-4720" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                    <constraint id="d5be-7c2c-08c6-bf56" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
