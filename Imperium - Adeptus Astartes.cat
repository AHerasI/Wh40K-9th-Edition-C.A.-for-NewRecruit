        <infoLink id="c8e0-aff4-b0fb-66ff" name="Concealed Positions" hidden="false" targetId="a6dc-059d-a47a-a49c" type="profile"/>
      </infoLinks>
    </categoryEntry>
    <categoryEntry id="b1ba-77f6-efb7-cff6" name="Wulfen" hidden="false">
      <profiles>
        <profile id="8d62-7831-ad23-3a85" name="Bestial Rage" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform any actions.</characteristic>
          </characteristics>
        </profile>
        <profile id="e05e-3d98-13f3-3dcf" name="Death Frenzy" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c8fd-783f-3230-493e" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit is destroyed by a melee attack, if that model has not fought this phase, do not remove it from play. The destroyed model can fight after the attacking model’s unit has finished making attacks, and is then removed from play.</characteristic>
          </characteristics>
        </profile>
        <profile id="fb01-b12e-950e-4d32" name="Wulfen Howl [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly SPACE WOLVES INFANTRY, SPACE WOLVES BIKER or SPACE WOLVES CAVALRY unit is within 6&quot; of this unit, you can re-roll charge rolls made for that unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="02db-8904-b7b1-386a" name="Murderlust" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c8fd-783f-3230-493e" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll charge rolls made for this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </categoryEntry>
    <categoryEntry id="4254-4792-81ec-a092" name="Saturnine Armour" hidden="false">
      <profiles>
        <profile id="feb9-7088-863a-1caf" name="Extremly bulky" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each model is considered as a Dreadnought in regard being in a TRANSPORT.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="2909-857a-fd60-a2f2" name="Additional armour plating" hidden="false" targetId="5b3f-8e7c-f7ae-0f7c" type="profile"/>
