                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD makes a ranged attack against a unit without MONSTER, VEHICLE or TITANIC Keywords, an unmodified Hit roll of 2+ is successful and an unmodified Wound roll of 2+ is successful.</characteristic>
                      </characteristics>
