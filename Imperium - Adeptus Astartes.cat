            </profile>
            <profile id="0b6c-9bf2-0c52-e346" name="Slayer’s Oath" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an enemy CHARACTER or MONSTER model is destroyed by an attack made by this model, then until the end of the battle, do not roll to see if litanies recited by this model are inspiring; they are automatically inspiring.</characteristic>
              </characteristics>
            </profile>
