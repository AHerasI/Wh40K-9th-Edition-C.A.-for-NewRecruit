                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c17c-7759-1886-8d98" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="86f2-3134-2fec-7cc4" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="fe8b-1934-5404-7414" name="Daemon slayer" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD fights, if it made a charge move this turn, then until that fight is resolved, add 1 to its Attacks characteristic.
- Each time this WARLORD makes a melee attack against a DAEMON unit, Invulnerable Saving throws cannot be made against that attack.</characteristic>
                      </characteristics>
                    </profile>
