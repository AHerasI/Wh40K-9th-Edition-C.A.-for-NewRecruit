            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="50bb-6709-4de0-9e8f" name="1 - Veil of Time" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5eac-461b-9ec1-212e" type="max"/>
