                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to the Toughness characteristic of this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="SA: 4. Patient and Determined" id="3b52-6d01-90a3-0e64" collective="false" hidden="false" import="true" type="upgrade">
