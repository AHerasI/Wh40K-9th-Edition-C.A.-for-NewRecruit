    </categoryEntry>
    <categoryEntry id="600c-7021-5f80-be5b" name="Frost weapon" hidden="false"/>
    <categoryEntry id="ba29-cfac-95f3-7a63" name="Combat Squads" hidden="false">
      <rules>
        <rule id="bb1f-fa10-ad34-5cfd" name="Combat Squads" hidden="false">
          <description>Before any models are deployed at the start of the game, this unit when containing its maximum number of models, may be split into two units each containing an equal number of models.</description>
        </rule>
      </rules>
    </categoryEntry>
