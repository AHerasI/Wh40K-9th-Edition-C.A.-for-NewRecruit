              <selectionEntries>
                <selectionEntry id="7a37-585e-18b7-bd99" name="GT: 6. Psychic epitome" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="129b-7f57-58d3-512c" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a27d-86af-e3ef-8acc" type="max"/>
