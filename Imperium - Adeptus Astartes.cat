                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this WARLORD declares a charge, enemy units that were targeted by that charge cannot fire Overwatch or Set to Defend against that charge.
- You can re-roll charge rolls made for this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
