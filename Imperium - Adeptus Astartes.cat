              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="23a5-61e9-cdbb-40b6" type="max"/>
              </constraints>
              <profiles>
                <profile id="628d-de15-0820-f836" name="Psychic Fortress [Aura]" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Details: Blessing: Psychic Fortress has a Warp charge value of 6. If manifested, then until the start of your next Psychic phase, while a friendly CHAPTER unit is within 6&quot; of this PSYKER, models in that unit have a 5+ invulnerable save.</characteristic>
                  </characteristics>
