                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">-</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Blast. Each time an attack made with this weapon successfully wounds, do not make a saving throw: the target suffers 3 mortal wounds and the attack sequence ends.</characteristic>
              </characteristics>
            </profile>
