              <selectionEntries>
                <selectionEntry id="13a9-c682-6bfc-d19c" name="CF: 3. Tenacious Opponent" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="edd1-e5da-9605-8829" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="278d-6aec-9a5a-6d2f" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="6090-695e-28e3-d6bf" name="Tenacious Opponent" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When you choose this WARLORD to fight with, if there are at least five enemy models within 6&quot; of them, add D3 to this model’s Attacks characteristic until the end of the phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="2df2-c118-89ae-542f" name="CF: 1. Refuse to Die" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed97-1055-8c4e-cf5b" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="62ad-9218-2a35-2655" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="9902-6dad-c0d0-f455" name="Refuse to Die" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The first time this WARLORD is destroyed, roll one D6 at the end of the phase. On a 3+, return this WARLORD to play with D3 wounds remaining, placing them as close as possible to their previous position and not within Engagement Range of any enemy units.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="0459-7cd1-4258-fbe9" name="CF: 2. Stoic Defender" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="32eb-22a6-86a9-8c03" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f803-2699-76ba-8433" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="6908-1422-a31e-7ed9" name="Stoic Defender [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly CRIMSON FISTS units have the Objective Secured ability whilst they are within 6&quot; of this WARLORD. If such a unit already has that ability, each model counts it&apos;s wounds characteristic thrice instead of twice when determining control of an objective marker.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
