              </constraints>
              <profiles>
                <profile id="fef0-853d-565a-073e" name="Ghostly Bonds" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">5</characteristic>
