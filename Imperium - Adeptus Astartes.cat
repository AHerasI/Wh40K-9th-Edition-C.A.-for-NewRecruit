                  <constraints>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b682-e754-0a67-3bb1" type="max"/>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d3b-d99d-4811-0dd6" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="ede1-f53c-cb41-ab63" name="Know Thy Enemy [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly EXORCISTS CORE or EXORCISTS CHARACTER unit is within 6&quot; of this WARLORD, each time a model in that unit makes an attaack against the enemy unit you selected, add 1 to the hit roll.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="1b5a-5848-8554-995b" name="Know Thy Enemy" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Before the battle, select one unit in your opponent&apos;s army.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
