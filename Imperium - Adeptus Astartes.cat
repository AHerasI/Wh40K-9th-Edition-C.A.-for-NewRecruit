            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f1fe-42a2-0f77-ee28" type="max"/>
          </constraints>
          <profiles>
            <profile id="837e-b9bc-ff13-fde6" name="Tactic: Duellists" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Tactic makes a melee attack against a unit without BUILDING, VEHICLE or MONSTER Keywords, an unmodified Hit roll of 6 automatically wounds the target.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="eb12-48c3-64f1-7eb6" name="Tactic: Born Heroes" hidden="false" collective="false" import="true" type="upgrade">
