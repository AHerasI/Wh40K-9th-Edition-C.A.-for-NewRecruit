                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by this WARLORD, an unmodified Hit roll of 6 scores an additional hit.</characteristic>
                      </characteristics>
                    </profile>
