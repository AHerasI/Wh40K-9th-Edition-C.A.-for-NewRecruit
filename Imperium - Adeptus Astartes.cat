                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <profiles>
                <profile name="3CP Orbital Bombardment" id="f49d-41df-34f4-1b74" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of any of your Shooting phase while your Warlord is deployed on the Battlefield. You can make an attack with the Orbital Bombardment weapon as the Tactical weapon rules state.
You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Orbital Bombardment" id="b272-fa59-910f-1742" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (9&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D3</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">14</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-4</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D3+3</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical weapon. Blast. This weapon is fired with an unmodifiable BS of 3+. If the target unit has 6 or more models, the type of weapon changes to Heavy D6. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords that are inside 3&quot; of the Tactical weapon marker, that attack automatically hits the target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Marked for death" id="49b9-388e-36a3-3ee7" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Swordbearers</comment>
              <constraints>
                <constraint id="bd48-2974-1403-1a96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="6789-c573-fbba-b05c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="1CP Marked for death" id="35db-e508-0312-ab62" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of your Shooting phase. Select one enemy unit within 12&quot; of and visible to a SWORDBEARERS PSYKER unit from your army. Until the end of the phase, each time a friendly SWORDBEARERS unit makes a ranged attack against that enemy unit, add 1 to that attack’s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Foresight" id="22b8-ba91-023b-1f15" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Prescient Brethren</comment>
              <constraints>
                <constraint id="609e-9c50-11d2-8ba7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
