              </costs>
              <profiles>
                <profile name="Invocation of focus [Aura]" id="778f-d805-bd15-68fe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this litany is inspiring, while a friendly GREY KNIGHTS CORE or GREY KNIGHTS CHARACTER unit is within 6&quot; of this PRIEST, each time that unit attempts to manifest a Blessing psychic power, add 1 to that attempt’s Psychic test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
