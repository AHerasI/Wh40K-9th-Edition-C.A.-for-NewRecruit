                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="44c1-9c37-384e-0bbe" type="max"/>
              </constraints>
              <profiles>
                <profile id="7a91-266d-995f-0238" name="Sarger Marterum&apos;s Blizzard" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction: Sarger Marterum&apos;s Blizzard has a warp charge value of 7. If manifested: Select a visible enemy unit at 24&quot;, then roll 3D6, if the result is more than the Leadership characteristic of the selected unit, halve the movement characteristic, advance rolls and charge rolls of that unit until the end of your next psychic phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="f89b-825a-99ea-9bd0" name="4 - Subjugate gravity" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="40c9-39ed-8922-da6a" type="max"/>
              </constraints>
              <profiles>
                <profile id="b865-0acd-865b-80e5" name="Subjugate gravity" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction: Subjugate gravity has a warp charge value of 7. If manifested: Select a enemy unit within 18&quot; of the Psyker.
Until your next psychic phase, each enemy unit within 3&quot; of the targeted unit (targeted unit included) reduce the Attacks characteristic of its models by 1 (1D3 if the unit has the MONSTER or VEHICLE keywords) to a minimun of 1. TITANIC units are unnafected.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
