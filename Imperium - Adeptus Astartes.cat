                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly SILVER TEMPLARS CORE unit within 6&quot; of this WARLORD. Until the start of your next Command phase, each time that unit is selected to shoot or fight you can re-roll one Hit roll and you can re-roll one Wound roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
