                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In the Shooting phase, select a friendly &lt;CHAPTER&gt; CORE unit is within 6&quot; of this WARLORD, every weapon in that unit which make a random number of attacks, makes at least 3 attacks.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="6. Shoot and Fade" id="95ad-a6ee-e2ae-a267" collective="false" hidden="false" import="true" type="upgrade">
