                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unmodified hit roll of 6+ made by a TWILIGHT LURKER INFANTRY unit within 6&quot; of this Warlord, it scores an additional hit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="TL: 3. Duty ends only with death" id="6f34-f95a-87c7-ba89" collective="false" hidden="false" import="true" type="upgrade">
