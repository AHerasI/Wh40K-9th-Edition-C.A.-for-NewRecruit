                <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">2+</characteristic>
              </characteristics>
            </profile>
            <profile id="c9fa-9068-be6a-8ca6" name="On alert brothers, the enemy must be nearby." hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per phase, one BLOOD RAVENS unit at 9&quot; of this Warlord can shoot enemy reinforcements deployed within 12&quot; of this Warlord, as if were in it&apos;s shooting phase.</characteristic>
              </characteristics>
            </profile>
            <profile id="9c21-7069-c314-7479" name="My faith is my shield!" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The unit can attempt to deny one Psychic power in the opponent&apos;s Psychic Phase by taking a Deny the Witch test as if they were a PSYKER.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
