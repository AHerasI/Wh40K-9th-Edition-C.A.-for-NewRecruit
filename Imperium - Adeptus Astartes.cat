                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Optimised priority [Aura]" id="3c3c-27a4-fc70-6d0c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DEATHWATCH CORE or DEATHWATCH CHARACTER unit that is performing an action is within 6&quot; of this WARLORD, that unit can make ranged attacks without that action failing.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
