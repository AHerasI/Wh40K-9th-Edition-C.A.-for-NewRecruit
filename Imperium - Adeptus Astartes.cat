              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2498-a12b-e11f-7ef2" type="max"/>
              </constraints>
              <profiles>
                <profile id="d20c-c2ce-ea72-5f25" name="Astral Aim" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">-</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Astral aim has a Warp charge value of 6. If manifested, until the start of the next Psychic phase:
- Each time this PSYKER&apos;s unit is selected to shoot, you can re-roll one hit roll when resolving that units attacks
- Each time a model in this PSYKER&apos;s unit makes a ranged attack, the targest does not receive the benefits of cover against that attack</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8523-6a95-73b5-890f" name="6 - Etheral Castigation" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c203-69f2-6fc1-b4bd" type="max"/>
              </constraints>
              <profiles>
                <profile id="9246-5fd9-92c0-88f1" name="Ethereal Castigation" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">Self</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Ethereal Castigation has a Warp charge value of 6. If manifested, this PSYKER&apos;s unit can shoot as if it were your Shooting phase, and then it can make a Normal Move as if it were your Movement phase. After making this move and/or resolving these shooting attacks, until the end of the turn, this PSYKER&apos;s unit cannot make a Normal Move, Advance, charge, or shoot.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
