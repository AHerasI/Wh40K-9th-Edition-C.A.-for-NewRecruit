                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly EXORCISTS CORE or EXORCISTS CHARACTER unit is within 6&quot; of this WARLORD, each time a model in that unit makes an attaack against the enemy unit you selected, add 1 to the hit roll.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Know Thy Enemy" id="1b5a-5848-8554-995b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Before the battle, select one unit in your opponent&apos;s army.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="EX: 2. Erudite in the Verses" id="2cda-5602-39df-5e35" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="b855-a2b0-7e05-42ba" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
