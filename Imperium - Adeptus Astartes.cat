                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of your Fight phase, if this WARLORD remained stationary and did not make any attacks this turn it can call down an Orbital strike.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
