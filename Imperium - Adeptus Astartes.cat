                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly DARK ANGELS unit within 6&quot; of this WARLORD. Until the start of your next Command phase all Combat Doctrines are active for that unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DA: 3. Calibanite Knight" id="8378-3cf2-6aae-bd17" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="e403-e7ef-5b3e-21c4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="63f6-131d-9c37-2c2b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
