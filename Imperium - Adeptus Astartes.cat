            <profile id="bf83-0aa6-05c5-439a" name="Apothecarion Master" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot be selected as Warlord or receive other Warlord trait by any means, instead has Selfless Healer trait by default.</characteristic>
              </characteristics>
            </profile>
            <profile id="3bbf-f31d-e57f-0e5b" name="Artificier Armour" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has 5+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
            <profile id="c993-fa53-78d8-ae7b" name="Narthecium [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <comment>2e33-41b1-0ca6-a3f3</comment>
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ADEPTUS ASTARTES INFANTRY or ADEPTUS ASTARTES BIKER unit is within 6&quot; of this model, each time a model in that unit would lose a wound, roll one D6; on a 5, that wound is not lost.</characteristic>
              </characteristics>
            </profile>
