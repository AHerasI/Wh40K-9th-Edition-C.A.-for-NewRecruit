            <profile name="Oath of Glory" id="3f08-9354-cf38-3a98" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring:
- At the start of the Fight phase, if this PRIEST model is within Engagement Range of any enemy units, it can fight first that phase.
- Each time this PRIEST model makes an attack, an unmodified hit roll of 6 scores 2 additional hits.
- Add 1 to the Strength characteristic of this PRIEST model.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
