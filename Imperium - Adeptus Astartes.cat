              <profiles>
                <profile name="1CP Gene-wrought Might" id="8c0a-fb07-993c-681c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when one ADEPTUS ASTARTES INFANTRY unit from your army is selected to fight. Until the end of the phase, each time a model in that unit makes a melee attack against a unit without VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Aggresive Onslaugth" id="101b-43b2-d696-14db" collective="false" hidden="true" import="true" type="upgrade">
              <comment>Flesh tearers</comment>
              <constraints>
                <constraint id="030f-10e2-96bf-6a5e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="73ee-5c9d-5ddd-7e43" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                      </conditions>
                    </conditionGroup>
