              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="711b-48e9-fbec-d34d" type="max"/>
              </constraints>
              <profiles>
                <profile id="7b4e-64af-fe15-13a7" name="1CP Hunter&apos;s Fusillade" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when a WHITE SCARS unit from your army Advances. Until the end of the turn, Heavy weapons and Rapid Fire weapons models in that unit are equipped with are treated as Assault weapons (e.g. a Rapid Fire 2 weapon is treated as an Assault 2 weapon).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="093e-8ea3-4e10-e51b" name="3CP Orbital Bombardment" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f1dc-cd59-8c1e-33d2" type="max"/>
              </constraints>
              <profiles>
                <profile id="f49d-41df-34f4-1b74" name="3CP Orbital Bombardment" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of any of your Shooting phase while your Warlord is deployed on the Battlefield. You can make an attack with the Orbital Bombardment weapon as the Tactical weapon rules state.
You can only use this Stratagem once.</characteristic>
                  </characteristics>
                </profile>
                <profile id="b272-fa59-910f-1742" name="Orbital Bombardment" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Tactical (9&quot;)</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D3</characteristic>
                    <characteristic name="S" typeId="59b1-319e-ec13-d466">14</characteristic>
                    <characteristic name="AP" typeId="75aa-a838-b675-6484">-4</characteristic>
                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D3+3</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Tactical weapon. Blast. This weapon is fired with an unmodifiable BS of 3+. If the target unit has 6 or more models, the type of weapon changes to Heavy D6. Each time an attack is made with this weapon against units without MONSTER, VEHICLE or TITANIC Keywords that are inside 3&quot; of the Tactical weapon marker, that attack automatically hits the target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="a2fb-697d-3845-b5b4" name="Tactical Weapon" hidden="false" targetId="9369-4930-4f3e-67a4" primary="false"/>
                <categoryLink id="084c-3b2c-934d-4d15" name="Blast" hidden="false" targetId="a30d-0055-6710-6284" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="49b9-388e-36a3-3ee7" name="1CP Marked for death" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Swordbearers</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
