                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per phase, you can modify the result of a Hit roll, Wound roll or Saving throw made for this WARLORD to a 6.</characteristic>
                      </characteristics>
