        <profile id="421f-7440-3a19-a8a2" name="Command Rhino" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 6 &lt;CHAPTER&gt; INFANTRY models. Each PRIMARIS model counts as 2 other INFANTRY models. It cannot transport JUMP PACK, TERMINATOR, WULFEN, GRAVIS or CENTURION models.</characteristic>
          </characteristics>
        </profile>
        <profile id="5bb8-38f2-5061-481a" name="Servo-skull Hub" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Shooting phase, select one of the following:
- Targeting Data Skull: Select one friendly &lt;CHAPTER&gt; unit within 12&quot; of this model. Until the end of the phase, when resolving an attack made by a model in that unit, add 1 to the hit roll.
- Repair Skull: Select one friendly &lt;CHAPTER&gt; VEHICLE model within 12&quot; of this unit. That model regains 1 lost wound.
- Vox Skull: Until the start of your next Shooting phase, when a Morale test is taken for a friendly &lt;CHAPTER&gt; unit within 12&quot; of this model, subtract 1 from the result.</characteristic>
          </characteristics>
        </profile>
        <profile id="a551-48fc-cbe5-6e77" name="Self-repair" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model has lost any wounds, you can roll one D6 at the start of your turn; on a 5+ this model regains 1 lost wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
