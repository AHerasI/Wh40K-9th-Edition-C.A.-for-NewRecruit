        <selectionEntry id="a077-2656-a975-eb28" name="6. Canticle of Hate" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4108-a6f8-f259-35d5" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0c01-cdc1-9d72-6c21" type="max"/>
          </constraints>
          <profiles>
            <profile id="13f1-dcf5-b46a-c75d" name="Canticle of Hate [Aura]" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, then while a friendly CHAPTER CORE or CHARACTER unit within 6&quot; of this PRIEST:
- Add 2 to charge rolls made for that unit. This is not cumulative with any other rule that adds to a unit&apos;s charge roll.
- Each time a model in that unit makes a pile-in or consolidation move, it can move up to an additional 3&quot;. This is not cumulative with any other rule that increases the distance models can pile in or consolidate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="42db-6186-c51d-bd0c" name="0. Litany of Hate" hidden="false" collective="false" import="true" type="upgrade">
