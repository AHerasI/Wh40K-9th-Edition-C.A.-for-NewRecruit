          </characteristics>
        </profile>
        <profile id="30d3-0a37-79ca-9e67" name="The Aegis" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
