                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">24&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: Telepathic Assault has a Warp charge value of 7. If manifested, select one enemy unit within 24&quot; of and visible to this PSYKER. Roll 2D6 and add 2 to the result; that unit suffers 1 mortal wound for each point by which the total exceeds the highest Leadership characteristic of models in that unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
