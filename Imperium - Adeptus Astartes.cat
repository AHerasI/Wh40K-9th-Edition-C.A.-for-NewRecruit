                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly BLACK TEMPLARS CORE INFANTRY unit is within 3&quot; of this model, models in that unit have a 5+ invulnerable save.&apos;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
