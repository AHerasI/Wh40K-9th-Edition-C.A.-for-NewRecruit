                        <characteristic name="S" typeId="59b1-319e-ec13-d466">x2</characteristic>
                        <characteristic name="AP" typeId="75aa-a838-b675-6484">-3</characteristic>
                        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon against a FALLEN or HERETIC ASTARTES unit, an unmodified wound roll of 4+ inflicts 2 mortal wounds on the target and the attack sequence ends.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Mace of Redemption" id="0319-6f35-c666-e502" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
