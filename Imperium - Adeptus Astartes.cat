                  </constraints>
                  <profiles>
                    <profile id="964e-73df-bc35-ddc4" name="Vigilance incarnate" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly DEATHWATCH CORE unit within 6&quot; of this WARLORD. Each time you do, select one Battlefield Role; until the start of your next Command phase, each time a model in that unit makes an attack against an enemy unit with that Battlefield Role, re-roll a wound roll of 1.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
