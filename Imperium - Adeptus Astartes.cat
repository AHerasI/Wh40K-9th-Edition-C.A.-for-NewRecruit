              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c35f-b725-5232-ba40" type="max"/>
              </constraints>
              <profiles>
                <profile id="1afc-8626-8e79-5a8c" name="1CP Refusal to die" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem after a DEATH COMPANY unit from your army is selected as the target of an attack. Until the end of the phase, each time a model in that unit would lose a wound, roll one D6: on a 5+, that wound is not lost. You can only use this Stratagem once per turn. If that unit contains 5 or fewer models, this Stratagem costs 1CP; otherwise, it costs 2CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
