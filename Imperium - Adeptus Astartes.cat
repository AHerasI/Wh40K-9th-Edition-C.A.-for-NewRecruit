            <profile id="30d8-1ab5-690f-b085" name="Galvanic shock field" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer hits an enemy unit without INORGANIC, VEHICLE or TITANIC Keywords with a melee attack, until the end of the phase, that unit is electro-shocked. 
Substract 1 from the Attacks characteristic of the models in the electro-shocked unit, and when a model makes an attack, subtract 1 from that attack’s hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
