    <selectionEntry id="750a-cc34-b832-e348" name=" Stratagem List" hidden="false" collective="false" import="true" type="upgrade">
      <selectionEntries>
        <selectionEntry id="a1ba-74a5-80bb-d48e" name="2CP Commanding Oratory" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7f65-50f4-029e-3534" type="max"/>
          </constraints>
          <profiles>
            <profile id="c962-a076-abf2-ed5c" name="2CP Commanding Oratory" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of any of your phases other than your Command phase. Select one ADEPTUS ASTARTES CHAPLAIN unit from your army that has not recited a litany this turn. That model can recite one litany that has not already been recited by a friendly model this turn. That litany is automatically inspiring (do not roll) and takes effect until the start of your next Command phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0dfc-591d-9bce-b6a2" name="1CP A deadly prize" hidden="true" collective="false" import="true" type="upgrade">
          <comment>Raven Guard</comment>
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4141-2c38-e535-8f37" type="equalTo"/>
                    <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="532d-0d0a-60bd-f226" type="equalTo"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="31e6-2cca-de75-ffe3" type="max"/>
          </constraints>
          <profiles>
            <profile id="fd5d-1ecb-dab9-84f4" name="1CP A deadly prize" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the end of your turn. Select one objective marker that is within 3&quot; of any RAVEN GUARD INFANTRY units from your army and not within 3&quot; of any enemy units. The next time an enemy unit ends a move within 3&quot; of that objective marker, make an attack with the profile below. You cannot use this Stratagem on the same objective marker more than once per battle.</characteristic>
              </characteristics>
            </profile>
            <profile id="d9aa-0366-5ba7-ff59" name="1CP A deadly prize" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Bomb (3&quot;)</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2D3</characteristic>
                <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
                <characteristic name="AP" typeId="75aa-a838-b675-6484">-3</characteristic>
                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Bomb. Blast.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="57ae-b953-241d-ceff" name="1CP Stranglehold" hidden="true" collective="false" import="true" type="upgrade">
          <comment>Raven Guard</comment>
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4141-2c38-e535-8f37" type="equalTo"/>
                    <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="532d-0d0a-60bd-f226" type="equalTo"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7649-8a48-188e-db8c" type="max"/>
          </constraints>
          <profiles>
            <profile id="3c96-d15e-7024-0f84" name="1CP Stranglehold" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem after your opponent uses a Stratagem (excluding Command Re-roll). Until the end of the battle, the CP cost your opponent must pay to use that Stratagem again is increased by 1. This Stratagem can only be used once.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="ae45-aa8b-c922-f76d" name="1 - Before battle" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="b671-9e57-129e-b4e1" name="2CP Rapid redeployment" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Ultramarines</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2460-98c3-9419-f02c" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c548-e8b7-9a6f-7575" type="max"/>
              </constraints>
              <profiles>
                <profile id="0338-cad7-6b71-c6ee" name="2CP Rapid redeployment" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the first battle round, before the first turn begins, select up to three ULTRAMARINES units from your army on the battlefield. Remove them from the battlefield and set them up again as described in the Deployment section of the mission (if both players have abilities that redeploy units, roll off; the winner chooses who redeploys their units first).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6bbe-4b4c-b4bd-8c8a" name="1CP Teleportarium" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Deathwatch</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a1be-ee90-b5b3-388d" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3a92-0b87-bfd9-b4e7" type="max"/>
              </constraints>
              <profiles>
                <profile id="1cd8-d032-20d1-60f9" name="1CP Teleportarium" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during deployment. Select one DEATHWATCH INFANTRY, DEATHWATCH DREADNOUGHT or DEATHWATCH BIKER unit from your army. All models in that unit gain the Teleport Strike ability. You can only use this Stratagem once, unless you are playing a Strike Force battle (in which case you can use this Stratagem twice), or an Onslaught battle (in which case you can use this Stratagem three times).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="5fbc-b3a2-6fdc-2d8c" name="1CP Encirclement" hidden="true" collective="false" import="true" type="upgrade">
              <comment>White Scars</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="12f0-57a9-2a5d-af11" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="5f72-7584-6a50-ed63" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="60e4-c4b7-5b4e-641a" type="max"/>
              </constraints>
              <profiles>
                <profile id="4d3c-9dc1-0fe0-8df9" name="1CP Encirclement" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem during the Declare Reserves and Transports step of your mission. Select one WHITE SCARS unit (excluding BUILDINGS) from your army. You can set up that unit in outflank instead of setting it up on the battlefield. If you do, at the end of one of your Movement phases you can set up that unit wholly within 6&quot; of any battlefield edge and more than 9&quot; away from any enemy models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="47a7-9a0f-35d2-f5f2" name="2 - Command Phase" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="9e59-5bb4-df1c-797f" name="1CP Wisdom of the Ancients" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9d11-5b18-9ef4-6c03" type="max"/>
              </constraints>
              <profiles>
                <profile id="94d5-cd98-3837-0ae8" name="1CP Wisdom of the Ancients" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase. Select one ADEPTUS ASTARTES DREADNOUGHT model from your army (excluding WULFEN and DEATH COMPANY models). Until either the end of the battle or the next use of this Stratagem, that model gains either the Rites of Battle ability or the Tactical Precision ability, as shown below:
- Rites of Battle [Aura]: While a friendly &lt;CHAPTER&gt; CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.
- Tactical Precision [Aura]: While a friendly &lt;CHAPTER&gt; CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2a67-08fb-59e6-8c0e" name="1CP Cycle of War" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Ultramarines</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2460-98c3-9419-f02c" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="0bfd-a983-317b-51ff" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4481-3ff4-559e-7def" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="445b-f13f-335b-7c12" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1f1e-85f5-7d9a-62ff" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7a95-83e0-5cc9-85a4" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c368-a9bf-d9ba-a579" type="max"/>
              </constraints>
              <profiles>
                <profile id="e5ba-ea64-b088-042b" name="1CP Cycle of War" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem at the start of the battle round if an ULTRAMARINES WARLORD from your army is on the battlefield and the Assault Doctrine was active during the previous battle round. The currently active doctrine is changed so that the Devastator Doctrine is now active (with the Assault Doctrine cumulative with the rule Codex-Compliant Chapter).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="f5d3-cf20-dd67-e100" name="2CP Bombastic Delivery" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Black Templars</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4108-a6f8-f259-35d5" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3fc6-5104-b5a3-6957" type="max"/>
              </constraints>
              <profiles>
                <profile id="0e74-2768-942c-4f2c" name="2CP Bombastic Delivery" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase, when you select a BLACK TEMPLARS CHAPLAIN unit to recite a litany. One litany that unit recites this phase is automatically inspiring (do not roll), and that unit can recite one additional litany during this phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b2bb-e3c2-b5d9-fca2" name="2CP Red Rampage" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Blood Angels</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="897f-25a8-7032-e0f4" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="11d3-8c84-8dc6-7c69" type="max"/>
              </constraints>
              <profiles>
                <profile id="12ec-5baa-a4f7-1e02" name="2CP Red Rampage" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in your Command phase if the Assault Doctrine is active for your army. Until your next Command phase, each time a BLOOD ANGELS model from your army makes an attack with a Pistol or melee weapon, an unmodified hit roll of 6, scores an additional hit. This bonus is cumulative with the Combat Doctrines ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
