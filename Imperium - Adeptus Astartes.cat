                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Fury of the Lion [Aura]" id="5759-fabd-d47c-17d9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DARK ANGELS unit is within 6&quot; of this WARLORD, if this WARLORD has made a charge move, was charged or performed a Heroic Intervention this turn, add 1 to the Strength Characteristic of models in that unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DA: 4. Stubborn Tenacity" id="8af7-d758-e112-9a4e" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="b0db-5a5d-8176-dfd3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="189d-92dd-87f3-2c44" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Stubborn Tenacity" id="afc8-4385-893f-c0e0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this WARLORD is destroyed, if it does not explode, you can use this Warlord Trait instead of using any other abilities that take effect as a result of this model being destroyed (e.g. Astartes Banner). If you do, this WARLORD is not removed from play until the start of the next turn or the end of the battle (whichever comes first). Until that happens, it is still considered to be in play, but any further wounds this WARLORD would lose are not lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DA: 5. Decisive Tactician" id="ae81-8c20-8dc2-dfad" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="f732-3b73-ca24-8ab9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="01b0-7b59-236d-31d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Decisive Tactician" id="98a2-5fb0-78d9-a1f1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whilst this WARLORD is on the battlefield, you can roll one D6 for each Command Point you or your opponent spend to use a Stratagem; on a 6+ you gain a Command Point.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DA: 6. Honour of the First Legion" id="a420-2d59-0002-5fa2" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="e34d-3ab4-271e-c2e0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="8213-8fbc-1ae5-7876" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
