                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry name="TL: 1. Ballistics mastery" id="1bf0-c2b1-a17e-83c5" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="b139-d5dd-dc68-d021" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
