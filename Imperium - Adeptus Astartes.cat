          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cad3-a490-a7f3-2eef" type="max"/>
          </constraints>
          <profiles>
            <profile id="ab86-426c-71e1-d68e" name="Psalm of remorseless persecution" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, select one friendly BLACK TEMPLARS CORE unit within 6&quot; of this PRIEST. Each time a model in that unit makes a melee attack, an unmodified Wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
