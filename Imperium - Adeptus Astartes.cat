                <condition childId="4108-a6f8-f259-35d5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Litany of Faith [Aura]" id="354e-c956-a97f-2ca8" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, then while a friendly CHAPTER CORE or CHARACTER unit is within 6&quot; of this PRIEST, each time a model that unit would lose a wound as the result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
