    <selectionEntryGroup id="82d6-f1c3-be0c-a74e" name=" Litanies of Battle" hidden="false" collective="false" import="true">
      <modifiers>
        <modifier type="set" field="cf60-88f3-b27c-10bb" value="3">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f607-a955-f123-1d7e" type="equalTo"/>
              </conditions>
