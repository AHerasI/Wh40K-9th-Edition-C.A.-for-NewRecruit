                  </constraints>
                  <profiles>
                    <profile id="a78a-ab17-2e1d-595d" name=" Wolfkin" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">On each Fight phase, add D3 to the Attacks characteristic of this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="6535-8562-01d2-84ac" name="Saga of the Wolfkin [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">An enemy model is destroyed as the result of a melee attack made by this WARLORD.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">While a friendly SPACE WOLVES CORE unit is within 6&quot; of this WARLORD, add 1 to the Attacks characteristic of models in that unit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
