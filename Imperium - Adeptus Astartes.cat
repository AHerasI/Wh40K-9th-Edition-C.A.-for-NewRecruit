                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This WARLORD is eligible to perform a Heroic Intervention if it is within 6&quot; horizontally of an enemy unit, andwhen performing a Heroic Intervention you can can move them up to 6&quot; rather than 3&quot;. All other restrictions for Heroic Interventions still apply.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
