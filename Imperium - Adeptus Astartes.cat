          </modifiers>
          <profiles>
            <profile name="Fervent acclamation" id="a6a2-b038-9fbc-2088" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, select one Templar Vow that is not in effect and select one friendly BLACK TEMPLARS CORE or BLACK TEMPLARS CHARACTER unit within 6&quot; of this PRIEST. 
While the Litany effects lasts, that unit gains the effects of that vow.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
