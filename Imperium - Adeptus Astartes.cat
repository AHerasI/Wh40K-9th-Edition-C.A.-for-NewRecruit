            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a33d-9a94-3515-ea1a" type="min"/>
          </constraints>
          <profiles>
            <profile id="3b43-b756-dde3-07ed" name="Litany of Hate [Aura]" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <comment>Litany of Leisure (As stated in SM Codex 9th (Spanish))</comment>
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, then while a friendly CHAPTER CORE or CHAPTER CHARACTER unit is within 6&quot; of this PRIEST, each time a model in that unit makes a melee attack, you can re-roll the Hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
