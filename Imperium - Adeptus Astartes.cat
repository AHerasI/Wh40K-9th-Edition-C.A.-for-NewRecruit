            <modifier field="43c0-78ca-28d5-885c" type="set" value="0">
              <conditions>
                <condition childId="9f9f-25e8-8ae3-6818" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="f986-e432-8e72-c513" shared="true" type="equalTo" value="1"/>
              </conditions>
