          <constraints>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dc28-db73-2478-a883" type="max"/>
          </constraints>
          <profiles>
            <profile id="b48f-a81b-57c6-134f" name="Augury of Aggression" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, when a friendly GREY KNIGHTS CORE or GREY KNIGHTS CHARACTER unit within 12&quot; of this model is selected to fire Overwatch, this model can experience this vision, If it does, then until the end of the phase, each time a model in that unit makes an Overwatch attack, a hit is scored on an unmodified roll of 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="15"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
