                        <condition childId="d29c-a288-fa27-2ac5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
