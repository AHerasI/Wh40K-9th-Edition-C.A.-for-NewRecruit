          </constraints>
          <profiles>
            <profile id="ff8b-b70e-9409-7443" name="Tactic: Stealthy" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against a INFANTRY unit with this Tactic while is in an Area terrain feature, add 1 to any Armour saving throw made against that attack in addition to any other modifier.</characteristic>
