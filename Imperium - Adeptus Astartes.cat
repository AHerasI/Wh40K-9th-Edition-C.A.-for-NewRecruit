                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="23c9-73c8-617e-c91b" name="ST: 2. Precision Commander" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="63c6-50b6-7ca7-da0b" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="c77d-8536-c014-415f" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="a1fc-bc0d-5fc1-e2e3" name="Precision Commander" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly SILVER TEMPLARS CORE unit within 6&quot; of this WARLORD. Until the start of your next Command phase, each time that unit is selected to shoot or fight you can re-roll one Hit roll and you can re-roll one Wound roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="852c-053e-ddc8-dc72" name="ST: 3. Spiritual Synergy" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8912-4852-2a8d-6ee4" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="a63b-c74d-fd90-4649" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="238d-0e95-e4c0-f1d9" name="Spiritual Synergy" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one weapon this WARLORD is equipped with (exlcluding Relics). Each time this WARLORD makes an attack with that weapon, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any other normal damage.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
              </selectionEntries>
