            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="706a-e47a-d5f0-7540" type="max"/>
          </constraints>
          <profiles>
            <profile id="ef3c-a46c-7603-9444" name="Tactic: Born Heroes" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Tactic makes a melee attack, if that model&apos;s unit made a Charge move, has been charged or has done an Heroic intervention this turn, add 1 to that attack&apos;s Hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="96b7-1c19-4595-6ac3" name="Tactic: Scions of the Forge" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7a82-d05b-3b34-6005" type="max"/>
          </constraints>
          <profiles>
            <profile id="ce83-c7cc-d196-22a1" name="Tactic: Scions of the Forge" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models with this Tactic whose characteristics can change as they suffer damage are considered to have double the number of Wounds remaining for the purposes of determining what those characteristics are.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d07c-02d4-6dd5-24e0" name="Tactic: Stalwart" hidden="false" collective="false" import="true" type="upgrade">
