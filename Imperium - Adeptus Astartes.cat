          </modifiers>
          <selectionEntries>
            <selectionEntry id="4d95-9a50-1460-05fd" name="1 - Premorphic Resonance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d399-7526-4b8e-c10a" type="max"/>
              </constraints>
              <profiles>
                <profile id="3705-9d65-db6e-0d05" name="Premorphic Resonance" page="40" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Premorphic Resonance has a Warp charge value of 6. If manifested, select one friendly DEATHWATCH unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase:
- Any Overwatch attacks made by that unit score hits on rolls of 4+.
- If that unit starts the Fight phase within Engagement Range of any enemy models, it can fight first in that phase.
- Each time a melee attack is made by a model in that unit, add 1 to that attack&apos;s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
