                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This WARLORD cannot Fall Back. When resolving an attack against this Warlord, halve any damage inflicted (rounding up).</characteristic>
                      </characteristics>
