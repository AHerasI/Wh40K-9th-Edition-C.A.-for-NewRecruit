          </constraints>
          <profiles>
            <profile id="ea0f-66c6-d5cf-a0a8" name="Heroism’s Favour" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of your opponent’s Charge phase, you can select one friendly GREY KNIGHTS CORE unit within 12&quot; of this model. That unit can perform a Heroic Intervention as if it were a CHARACTER.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
