          </costs>
        </selectionEntry>
        <selectionEntry id="36ce-ce17-15c5-a00b" name="Tactic: Rapid Assault" hidden="true" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="78eb-e8ac-94f1-b36e" type="max"/>
          </constraints>
          <profiles>
            <profile id="538e-d23f-1b71-0efa" name="Tactic: Rapid Assault" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models with This tactic do not suffer the penalty incurred to their Hit rolls for firing Assault weapons in the same turn their unit Advanced.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="dfb4-60a8-e71d-3f50" name="Tactic: Preferred Enemy" hidden="true" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="00b9-434e-2fa9-05c3" type="max"/>
          </constraints>
          <profiles>
            <profile id="e4d2-e6af-19a6-51c6" name="Tactic: Preferred Enemy" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- When you select this tactic, select one of the following Faction keywords: CHAOS KNIGHTS; TYRANIDS; AELDARI; ORK; HERETIC ASTARTES; NECRONS; T&apos;AU EMPIRE. 
- Each time a model with this Tactic makes a melee attack against a unit with that Faction keyword, re-roll hit rolls of 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
