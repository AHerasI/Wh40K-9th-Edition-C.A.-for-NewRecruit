                <selectionEntry id="10bc-6f22-bbf1-2f4c" name="RG: 3. Swift and deadly" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ced9-952e-ca00-6c7e" type="max"/>
