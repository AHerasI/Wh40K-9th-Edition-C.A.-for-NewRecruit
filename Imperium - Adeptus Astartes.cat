            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="e943-d6ee-6991-77dd" name="Tactic: Whirlwind of Rage" hidden="false" collective="false" import="true" type="upgrade">
