                <profile name="1CP Sons of Guilliman" id="281e-f44f-64c0-9070" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when an ULTRAMARINES INFANTRY or ULTRAMARINES BIKER unit from your army is chosen to shoot with in your Shooting phase or fight with in the Fight phase. If that unit has the Troops Battlefield Role, until the end of that phase, when resolving an attack made by that unit, you can re-roll a hit roll. Otherwise, until the end of that phase, when resolving an attack made by that unit, you can re-roll a hit roll of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="1CP Heretic&apos;s Pyre" id="a36d-4731-3973-8c2f" collective="false" hidden="true" import="true" type="upgrade">
