            <profile id="f2b6-9b4a-54b6-b24f" name="Aquila" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- After selecting a Battlefield Role for the purposes of the Xenos Hunters Chapter Tactic for your army, select one additional Battlefield Role. 
- Until the end of the battle, each time a model in this unit makes an attack against an enemy unit with either of the selected Battlefield Roles, re-roll a wound roll of 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="points" value="10"/>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
