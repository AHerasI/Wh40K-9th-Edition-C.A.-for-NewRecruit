              <selectionEntries>
                <selectionEntry id="821e-ea31-fd4c-32c2" name="SA: 2. Miraculous Constitution" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d1ec-8c95-3964-d3e7" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0fab-e048-b132-e7b7" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="2895-73f3-157c-1b8c" name="Miraculous Constitution" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this WARLORD would lose a wound, roll one D6; on a 5+, that wound is not lost. In addition, at the start of your Movement phase, this WARLORD regains 1 lost wound.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="a373-4038-3eec-8bd5" name="SA: 3. Never Give Up" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8091-b0e2-2fb4-d239" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d139-d757-4f82-733a" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="3601-8ba2-62a9-b55a" name="Never Give Up" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Command phase, you can select one friendly SALAMANDERS unit within 6&quot; of this WARLORD. Until the end of your next Command phase, that unit has the Objective Secured ability. If a model in such a unit already has this ability, that model counts as if were with one additional wound when determining control of an objective marker.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="33db-f630-9182-2f28" name="SA: 1. Forge Master" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a11-8cb6-674f-32f6" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3c88-7201-cca9-650c" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="a70c-5c4f-39e9-4865" name="Forge Master" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to the Toughness characteristic of this WARLORD.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
