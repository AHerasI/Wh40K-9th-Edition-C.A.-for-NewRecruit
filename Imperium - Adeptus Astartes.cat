                    <profile name="Calm Under Fire [Aura]" id="28ae-1ac0-ac54-bbc6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ULTRAMARINES unit is within 6&quot; of this WARLORD, each time a model in that unit makes a ranged attack in a turn in which it Fell Back, do not subtract 1 from that attack’s hit roll due to the Codex Discipline Chapter Tactic.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
