      <selectionEntries>
        <selectionEntry id="43f7-f6ac-d7a4-fa8e" name="Tactic: Bolter Fusillades" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7b11-3edd-27ad-dc27" type="max"/>
          </constraints>
          <profiles>
            <profile id="6e3b-e15b-f240-840a" name="Tactic: Bolter Fusillades" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this Tactic makes a ranged attack with a bolt weapon, re-roll Hit rolls and Wound rolls of 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
