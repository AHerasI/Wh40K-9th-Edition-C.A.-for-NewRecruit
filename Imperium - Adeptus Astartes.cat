            </selectionEntry>
            <selectionEntry id="6542-72b5-248e-71d8" name="2 - Twilight Storm" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9bbf-45fb-bc4f-170e" type="max"/>
              </constraints>
              <profiles>
                <profile id="b222-1b5f-8bca-a2d3" name="Twilight Storm" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">8</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: Twilight Storm has a warp charge value of 8. If manifested, select a enemy unit within 18&quot; of this PSYKER, the selected unit suffers D3 mortal wounds. Roll 1D6 for each unit (friendly or foe) at 6&quot; of the selected enemy unit, each roll of 3+, adding 1 to the roll if the unit is INFANTRY, SWARM or BEAST, the unit suffers 1 mortal wound. If the warp charge is 11+, add 1D3 mortal wounds against all the affected units.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
