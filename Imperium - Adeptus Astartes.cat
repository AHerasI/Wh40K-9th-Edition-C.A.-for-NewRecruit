              <profiles>
                <profile name="Rites of War" id="e942-d55a-b9ec-1db5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CHAPTER&gt; CORE or &lt;CHAPTER&gt; CHARACTER unit is within 6&quot; of this WARLORD, that unit has the Objective Secured ability. If a model in such a unit already has this ability, that model counts as if were with one additional wound when determining control of an objective marker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
