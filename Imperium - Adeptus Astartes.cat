            <selectionEntry id="0ae9-f6c7-bfa4-b546" name="1 - Umbral Form" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dbe2-0356-69dd-e7ba" type="max"/>
              </constraints>
              <profiles>
                <profile id="73dd-acf3-12e8-50b6" name="Umbral Form" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">5</characteristic>
                    <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">-</characteristic>
                    <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing: Umbral Form has a Warp charge value of 5. If manifested, until the start of your next Psychic phase this PSYKER has a 3+ invulnerable save.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
