        <selectionEntry id="3159-24b7-c5c1-f9f4" name="5. Fervent acclamation" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4108-a6f8-f259-35d5" type="atLeast"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a8a6-6587-ca06-615a" type="max"/>
          </constraints>
          <profiles>
            <profile id="a6a2-b038-9fbc-2088" name="Fervent acclamation" hidden="false" typeId="2489-961a-f4fc-d026" typeName="Litany">
              <characteristics>
                <characteristic name="Effect" typeId="3279-0878-4777-b0cb">If this Litany is inspiring, select one Templar Vow that is not in effect and select one friendly BLACK TEMPLARS CORE or BLACK TEMPLARS CHARACTER unit within 6&quot; of this PRIEST. 
While the Litany effects lasts, that unit gains the effects of that vow.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
