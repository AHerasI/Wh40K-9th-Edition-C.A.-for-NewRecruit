                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="6fda-202d-e717-c44d" name="IH: 2. All Flesh is Weakness" hidden="false" collective="false" import="true" type="upgrade">
