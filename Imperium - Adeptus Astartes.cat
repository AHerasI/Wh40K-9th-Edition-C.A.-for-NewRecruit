                  <profiles>
                    <profile id="1a6d-4981-e549-b8d2" name=" Warrior Born" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this WARLORD is within Engagement Range of any enemy units, it can fight first that phase.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="a695-a700-6cb6-18d0" name="Saga of the Warrior Born [Aura]" hidden="false" typeId="fbbd-059b-5d80-5ce2" typeName="Deeds and Sagas">
                      <characteristics>
                        <characteristic name="Deed" typeId="275a-71d2-b468-18ae">An enemy CHARACTER model is destroyed as the result of a melee attack made by this WARLORD.</characteristic>
                        <characteristic name="When the Deed is achieved, the Saga is active." typeId="dd67-afc0-b97e-9bd5">At the start of the Fight phase, each friendly SPACE WOLVES CORE unit that is within 6&quot; of this WARLORD and within Engagement Range of any enemy units fights first that phase.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
