            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="43c0-78ca-28d5-885c" type="min"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="4108-a6f8-f259-35d5" name="Imperial Fists Successor - Black Templars" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5baf-eed5-bb85-7325" type="instanceOf"/>
                  </conditions>
                </modifier>
              </modifiers>
              <infoGroups>
                <infoGroup id="9632-391d-0b75-1fbe" name="Templar Vows" hidden="false">
                  <profiles>
                    <profile id="fa81-fd66-491c-f4c7" name="Abhor the Witch, Destroy the Witch" hidden="false" typeId="1740-4726-0359-3ba1" typeName="Templar Vows">
                      <characteristics>
                        <characteristic name="Vow" typeId="69ef-160b-c6dd-9ec2">In your first Movement phase, if there are any enemy PSYKER units in your opponent’s army, until the end of the phase, add 3&quot; to the Move characteristic of models of BLACK TEMPLARS units from your army.
Each time a BLACK TEMPLARS model from your army makes a melee attack against a PSYKER unit, re-roll a wound roll of 1.</characteristic>
                        <characteristic name="Passion" typeId="d75c-5488-db51-e70f">While an enemy PSYKER unit is within 18&quot; of a BLACK TEMPLARS unit from your army, that unit cannot perform any actions.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="fada-8e26-9bef-50e2" name="Accept Any Challenge, No Matter the Odds" hidden="false" typeId="1740-4726-0359-3ba1" typeName="Templar Vows">
                      <characteristics>
                        <characteristic name="Vow" typeId="69ef-160b-c6dd-9ec2">Each time a BLACK TEMPLARS unit from your army fights, until that fight is resolved, add 1 to the Attacks characteristic of models in that unit.</characteristic>
                        <characteristic name="Passion" typeId="d75c-5488-db51-e70f">BLACK TEMPLARS units from your army cannot Fall Back.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="410f-8473-321f-7df9" name="Suffer Not the Unclean to Live" hidden="false" typeId="1740-4726-0359-3ba1" typeName="Templar Vows">
                      <characteristics>
                        <characteristic name="Vow" typeId="69ef-160b-c6dd-9ec2">Each time a BLACK TEMPLARS model from your army makes a melee attack against a unit without INORGANIC, VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
                        <characteristic name="Passion" typeId="d75c-5488-db51-e70f">Each time a BLACK TEMPLARS unit from your army is selected to charge, the closest enemy non-AIRCRAFT unit that is within 12&quot; and not within Engagement Range of any other BLACK TEMPLARS units from your army must be declared as a target of that charge.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="b6c1-588f-0af2-389c" name="Uphold the Honour of the Emperor" hidden="false" typeId="1740-4726-0359-3ba1" typeName="Templar Vows">
                      <characteristics>
                        <characteristic name="Vow" typeId="69ef-160b-c6dd-9ec2">BLACK TEMPLARS models from your army add 1 to any Armour saving throws made. In addition, each time an attack is made against that unit, an unmodified wound roll of 1-2 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
                        <characteristic name="Passion" typeId="d75c-5488-db51-e70f">Each time an enemy model makes an attack against a BLACK TEMPLARS unit from your army, the unit does not receive the benefits of cover against that attack.</characteristic>
                      </characteristics>
                    </profile>
                    <profile id="0752-901d-833d-ce76" name=" Templar Vows" hidden="false" typeId="1740-4726-0359-3ba1" typeName="Templar Vows">
                      <characteristics>
                        <characteristic name="Vow" typeId="69ef-160b-c6dd-9ec2">At the end of the Read Mission Briefing step, you can select one of the following Templar Vows.</characteristic>
                        <characteristic name="Passion" typeId="d75c-5488-db51-e70f">Vow and Passion abilities are active for BLACK TEMPLARS units from your army.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
              </infoGroups>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
