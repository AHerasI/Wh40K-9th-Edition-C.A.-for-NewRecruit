                  </costs>
                  <profiles>
                    <profile name="Tactical maneuvering" id="33a8-8eec-2639-0134" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the Shooting phase, select one TWILIGHT LURKERS INFANTRY unit at 6&quot; of this Warlord, that unit can make a Normal move or an Advance move.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
