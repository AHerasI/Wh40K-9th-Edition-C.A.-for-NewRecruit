    <categoryEntry name="Frost weapon" id="600c-7021-5f80-be5b" hidden="false"/>
    <categoryEntry name="Combat Squads" id="ba29-cfac-95f3-7a63" hidden="false">
      <rules>
        <rule name="Combat Squads" id="bb1f-fa10-ad34-5cfd" hidden="false">
          <description>Before any models are deployed at the start of the game, this unit when containing its maximum number of models, may be split into two units each containing an equal number of models.</description>
        </rule>
      </rules>
