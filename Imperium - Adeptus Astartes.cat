              <profiles>
                <profile name="1CP Aggresive Onslaugth" id="12a8-b257-477f-f38e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase. Select one FLESH TEARERS INFANTRY unit from your army. Until the end of the phase, each time a model in that unit makes a pile-in or consolidation move, it can move up to an additional 3&quot;.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
