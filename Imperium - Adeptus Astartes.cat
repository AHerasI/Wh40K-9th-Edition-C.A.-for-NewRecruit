        <selectionEntryGroup id="765c-48d0-0d47-9022" name="7 - Fight phase" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="044b-0e99-0e0e-ac6e" name="1CP Gene-wrought Might" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="28f2-cfb7-e12e-af4a" type="max"/>
              </constraints>
              <profiles>
                <profile id="8c0a-fb07-993c-681c" name="1CP Gene-wrought Might" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase, when one ADEPTUS ASTARTES INFANTRY unit from your army is selected to fight. Until the end of the phase, each time a model in that unit makes a melee attack against a unit without VEHICLE or TITANIC Keywords, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="101b-43b2-d696-14db" name="1CP Aggresive Onslaugth" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Flesh tearers</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="73ee-5c9d-5ddd-7e43" type="equalTo"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="030f-10e2-96bf-6a5e" type="max"/>
              </constraints>
              <profiles>
                <profile id="12a8-b257-477f-f38e" name="1CP Aggresive Onslaugth" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in the Fight phase. Select one FLESH TEARERS INFANTRY unit from your army. Until the end of the phase, each time a model in that unit makes a pile-in or consolidation move, it can move up to an additional 3&quot;.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
