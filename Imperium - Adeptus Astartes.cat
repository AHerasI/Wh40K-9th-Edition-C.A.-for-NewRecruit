          <profiles>
            <profile id="5095-f221-b84d-78f1" name="Tactic: Hungry for Battle" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to Advance rolls and charge rolls made for units with this Tactic.</characteristic>
              </characteristics>
            </profile>
