                    <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                    <cost name="Pts" typeId="points" value="0"/>
                    <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Calibanite Knight" id="3c68-9466-59e7-1623" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD makes a melee attack against an unit without VEHICLE or TITANIC Keywords, an unmodified wound roll of 2+ is always successful.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="DA: 2. Fury of the Lion" id="a5a6-ba92-da55-2b16" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="c4ca-8806-dc8f-4050" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="2cf4-e8e3-f035-330e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
