              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test or Deny the Witch test is taken for a PSYKER unit with this Tactic, re-roll any or all dice results of 1.</characteristic>
              </characteristics>
