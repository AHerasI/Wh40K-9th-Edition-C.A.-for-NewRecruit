                  <profiles>
                    <profile id="9603-dcc1-c917-6a61" name="Nemesis lord" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD makes a melee attack with a Nemesis weapon, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
