            <profile id="24cc-aaa2-3d64-4ec6" name="Blood Claws Hero [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly BLOOD CLAWS, SKYCLAWS or SWIFTCLAWS unit is within 6&quot; of this model, each time a BLOOD CLAWS, SKYCLAWS or SWIFTCLAWS model in that unit makes a melee attack, you can re-roll the hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile id="e21c-b4e7-2ad4-7c3b" name="Rebellious Presence" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While another friendly SPACE WOLVES unit is within 3&quot; of this model, subtract 1 from the Leadership characteristic of models in that unit.</characteristic>
              </characteristics>
            </profile>
            <profile id="8eff-f5ca-2278-8919" name="The Last Laugh" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In the Fight phase, if this model is destroyed by a melee attack made by an enemy model, roll off with your opponent; if you win the roll off, that enemy model’s unit suffers D6 mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile id="59e9-da07-f4f8-5392" name="Pelt of the Doppegangrel" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this unit, an unmodified hit roll of 1-3 always fails, irrespective of any abilities that the weapon or the model making that attack may have.</characteristic>
              </characteristics>
            </profile>
            <profile id="41bb-df9e-4414-c0a8" name="Master of Mischief" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
