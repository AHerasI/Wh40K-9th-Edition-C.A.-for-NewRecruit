          <selectionEntries>
            <selectionEntry id="13f2-dfe8-ef8b-d03c" name="2CP Transhuman Physiology" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a76c-4467-8644-bc12" type="max"/>
              </constraints>
              <profiles>
                <profile id="f588-abe9-e325-b9a6" name="2CP Transhuman Physiology" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem in any phase, when a CENTURION, SATURNINE ARMOUR, GRAVIS ARMOUR or TERMINATOR ARMOUR unit from your army is selected as the target of an attack. Until the end of the phase, each time an attack is made against that unit, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="Pts" typeId="points" value="0"/>
                <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="3544-c78d-545f-ef59" name="1CP Refusal to die" hidden="true" collective="false" import="true" type="upgrade">
              <comment>Blood Angels</comment>
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="73ee-5c9d-5ddd-7e43" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="897f-25a8-7032-e0f4" type="equalTo"/>
                        <condition field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4b31-59ac-a27f-ba2b" type="equalTo"/>
