            <profile id="c4d5-6cf6-515c-05ee" name="Master of Prescience" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the battle round, you can select one friendly ULTRAMARINES CORE or ULTRAMARINES CHARACTER unit within 6&quot; of this model. Until the end of that battle round, when resolving an attack against that unit, subtract 1 from that attack’s hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile id="e1eb-03ce-73f8-8e9b" name="Hood of Hellfire" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a Psychic test is taken for this model, you can re-roll the result. When a Psychic test or a Deny the Witch test is taken for this model, add 1 to the total.</characteristic>
              </characteristics>
            </profile>
          </profiles>
