  <sharedRules>
    <rule name="Helfrost weapon profile" id="4ef9-7104-9097-df89" hidden="false">
      <description>Before selecting targets, select one of the Helfrost profiles to make attacks with.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name=" Detachment Chapter Selection" id="f986-e432-8e72-c513" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="d6f5-62e1-d3bc-2461" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="5d84-2d05-746f-7f74" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="Pts" typeId="points" value="0"/>
        <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
      </costs>
      <infoGroups>
        <infoGroup name="Combat Doctrines" id="0c14-b310-b631-f37a" hidden="false">
          <profiles>
            <profile name="  Combat Doctrines" id="8132-9b18-a209-9f19" hidden="false" typeId="809e-ce1d-5157-2df5" typeName="Combat Doctrines">
              <characteristics>
                <characteristic name="Effect" typeId="7eed-c315-4cf8-7087">At the beginning of your Command Phase, if your Warlord is on the Battlefield, you can select a Combat Doctrine to take effect until your next Command Phase.
This Doctrines will affect all units of your army which have the ADEPTUS ASTARTES Keyword present on the battlefield.
From the beginning of the first battle round until changed, the Devastator Doctrine is considered to be active.</characteristic>
              </characteristics>
            </profile>
            <profile name="Devastator Doctrine" id="64c7-925d-31f2-d7e9" hidden="false" typeId="809e-ce1d-5157-2df5" typeName="Combat Doctrines">
              <characteristics>
                <characteristic name="Effect" typeId="7eed-c315-4cf8-7087">Whilst is active, ADEPTUS ASTARTES models from your army do not suffer the penalty for moving and firing Heavy weapons, and when resolving an attack made with a Heavy weapon by a unit with this ability, you can re-roll one hit roll when resolving that weapon’s attacks.</characteristic>
              </characteristics>
            </profile>
            <profile name="Tactical Doctrine" id="b1f6-657f-a93e-a7e8" hidden="false" typeId="809e-ce1d-5157-2df5" typeName="Combat Doctrines">
              <characteristics>
                <characteristic name="Effect" typeId="7eed-c315-4cf8-7087">Whilst is active, ADEPTUS ASTARTES models from your army do not suffer the penalty for advancing and firing Assault weapons, and when advanced, is possible to shoot with a Rapid-Fire or Pistol weapon, but must substract 1 from the hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="Assault Doctrine" id="7a5d-5b46-8c6e-ecf0" hidden="false" typeId="809e-ce1d-5157-2df5" typeName="Combat Doctrines">
              <characteristics>
                <characteristic name="Effect" typeId="7eed-c315-4cf8-7087">Whilst is active, ADEPTUS ASTARTES models from your army do not suffer the penalty for firing Heavy weapons in Engagement Range, and when resolving an attack made with a Pistol or Melee weapon by a unit with this ability, re-roll one hit roll for each model when resolving that unit’s attacks.</characteristic>
              </characteristics>
            </profile>
            <profile name=" Codex-Compliant" id="3f9c-8615-f579-1d02" hidden="false" typeId="809e-ce1d-5157-2df5" typeName="Combat Doctrines">
              <characteristics>
                <characteristic name="Effect" typeId="7eed-c315-4cf8-7087">For Codex-compliant Chapter&apos;s units, if the cycling of the Combat Doctrines is as it follows, during the turn the doctrine has changed, the previous doctrine is considered to be still in effect.
1 - Devastator Doctrine
2 - Tactical Doctrine
3 - Assault Doctrine</characteristic>
              </characteristics>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="9f9f-25e8-8ae3-6818" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Angels of Death" id="4b61-c6d2-2d57-3fdf" hidden="false">
          <profiles>
            <profile name="And They Shall Know No Fear" id="cf1a-5b16-d705-3b5a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Combat Attrition test is taken for an ADEPTUS ASTARTES unit, ignore any or all modifiers.</characteristic>
              </characteristics>
            </profile>
            <profile name="Bolter Discipline" id="c2de-7c95-2dcd-9280" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Instead of following the normal rules for Rapid Fire weapons, ADEPTUS ASTARTES models shooting Rapid Fire Bolt weapons make double the number of attacks if any of the following apply:
- The shooting model&apos;s target is within half the weapon&apos;s range
- The shooting model is INFANTRY and it&apos;s unit Remained Stationary in your previous Movement Phase.
- The shooting model is a Terminator, Centurion, Sternguard Veteran or Biker.

For the purposes of this ability, a Rapid Fire Bolt weapon is any Bolt weapon with the Rapid Fire type.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <selectionEntryGroups>
        <selectionEntryGroup name="2 - Non-Codex Chapters" id="f093-5379-f520-a3e1" collective="false" hidden="true" import="true">
          <constraints>
            <constraint id="884b-a29c-27e1-0143" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
