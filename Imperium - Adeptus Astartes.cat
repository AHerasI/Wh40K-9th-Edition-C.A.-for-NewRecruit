                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">After deployment, you can select one friendly BLADES OF VICTORY CORE unit within 9&quot; of this WARLORD. This WARLORD and the selected unit can each make a Normal Move of up to 6&quot;.</characteristic>
                      </characteristics>
