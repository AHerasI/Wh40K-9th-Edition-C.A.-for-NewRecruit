                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- At the start of the Fight phase if this model is within Engagement Range of any enemy units, it can fight first that phase. 
- Each time this WARLORD makes a melee attack, if it made a Charge move, was charged or performed a Heroic Intervention this turn you can re-roll the Wound roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
