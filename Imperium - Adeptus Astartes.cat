      <selectionEntries>
        <selectionEntry id="f1db-c376-edd9-fb44" name="Chapter Ancient" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="b571-1da7-f228-dd06" value="-1">
              <conditions>
                <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="58c5-1d35-3869-613f" type="equalTo"/>
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="be0e-a2db-6bec-2377" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b571-1da7-f228-dd06" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="06b3-281d-f9c5-5cf3" type="max"/>
          </constraints>
          <profiles>
            <profile id="1e89-4b7b-1b49-bf51" name="Chapter Banner" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in a friendly CHAPTER CORE unit within 6&quot; of the bearer makes a melee attack, add 1 to that attacks hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="points" value="15"/>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d51f-5dd9-0da9-a758" name="Chapter Champion" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="dd4c-caba-1d9c-ac3b" value="-1">
              <conditions>
                <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="58c5-1d35-3869-613f" type="equalTo"/>
              </conditions>
            </modifier>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f410-0dae-24ab-c46c" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dd4c-caba-1d9c-ac3b" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f059-fff6-f6d0-a5c2" type="max"/>
          </constraints>
          <profiles>
            <profile id="87f5-679e-2e4b-3e7a" name="Superlative Duellist" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made with a melee weapon by this model against a CHARACTER unit, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2ff5-e15f-bc48-6e2e" name="Skillful Parry" hidden="false" targetId="4ee4-0937-e94e-6728" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="Pts" typeId="points" value="15"/>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c213-4507-359f-087b" name="Chapter Master" hidden="true" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="ancestor" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="37fe-e3a5-9a4d-0af1" type="instanceOf"/>
              </conditions>
            </modifier>
            <modifier type="set" field="6eb5-e01b-51f4-58aa" value="-1">
              <conditions>
                <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="58c5-1d35-3869-613f" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6eb5-e01b-51f4-58aa" type="max"/>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c301-d7d9-bab4-be8a" type="max"/>
          </constraints>
          <profiles>
            <profile id="d9b7-1807-6af3-d7b7" name="Chapter Master" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase select one friendly CHAPTER CORE or CHAPTER CHARACTER within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="points" value="25"/>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
