        <selectionEntry id="dfd0-11cb-d3b7-8432" name="Reclusiarch Merek Grimaldus" hidden="false" collective="false" import="true" type="model">
          <comment>WT: Epitome of Piety</comment>
          <constraints>
            <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8c58-eb76-ecda-2f14" type="max"/>
          </constraints>
          <profiles>
            <profile id="772c-b2f8-d18d-6326" name="Reclusiarch Merek Grimaldus" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
              <characteristics>
                <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
                <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
                <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
                <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
                <characteristic name="T" typeId="9c9f-9774-a358-3a39">4</characteristic>
                <characteristic name="W" typeId="f330-5e6e-4110-0978">5</characteristic>
                <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">5</characteristic>
                <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">10</characteristic>
                <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
              </characteristics>
            </profile>
            <profile id="02c7-8d29-cdf2-e7ea" name="Mindless Followers" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit contains any Cenobyte Servitor models, each time an attack successfully wounds this unit, that attack must be allocated to one of those models. The destruction of Cenobyte Servitor models is ignored for the purposes of Morale tests. If Chaplain Grimaldus is ever destroyed, any remaining Cenobyte Servitor in this unit are also destroyed. In addition, Cenobyte Servitor models cannot be your WARLORD.</characteristic>
              </characteristics>
            </profile>
            <profile id="dd1a-e83b-fe8b-d89e" name="Devout" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your opponent’s Psychic phase, this unit can attempt to deny one psychic power as if it were a PSYKER.</characteristic>
              </characteristics>
            </profile>
            <profile id="a7f2-9b80-fab7-955c" name="Indomitable Resolve" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, when this unit’s Chaplain Grimaldus model is destroyed, you can choose to roll one D6 at the end of the phase instead of using any rules that are triggered when that model is destroyed (e.g. the Only in Death Does Duty End Stratagem). If you do, then on a 4+, set this unit’s Chaplain Grimaldus model back up on the battlefield as close as possible to where they were destroyed and not within Engagement Range of any enemy units, with 3 wounds remaining.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="281c-94f1-8df9-df1d" name="Rosarius" hidden="false" targetId="ace1-892d-7d99-bc9e" type="profile"/>
          </infoLinks>
