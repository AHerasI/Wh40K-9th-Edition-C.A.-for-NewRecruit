        <profile id="ef61-0649-b5b7-9fc8" name="Sacred Banner [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;BROTHERHOOD&gt; CORE unit is within 6&quot; of this model, add 1 to the Leadership characteristic of models in that unit. In addition, while a friendly &lt;BROTHERHOOD&gt; CORE INFANTRY unit is within 6&quot; of this model, add 1 to the Attacks characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="bfd9-1f01-3123-5875" name="Chapter Banner [Aura]" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly GREY KNIGHTS CORE unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a melee attack, add 1 to that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
