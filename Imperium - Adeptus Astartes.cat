                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5832-b597-8f57-7405" type="max"/>
                    <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0ae7-e5a4-2964-c47b" type="max"/>
                  </constraints>
