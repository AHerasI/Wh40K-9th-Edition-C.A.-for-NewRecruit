        <profile name="Stirring Rhetoric [Aura]" id="223e-9d8d-a664-b912" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ADEPTA SORORITAS unit is within 6&quot; of this model, each time that unit (or a model in that unit) performs an Act of Faith, you can increase or decrease the value of 1 Miracle dice by 1 before you use it to perform that Act of Faith. This is not cumulative with any other abilities that can increase or decrease the value of a Miracle dice.</characteristic>
          </characteristics>
        </profile>
        <profile name="Laud Hailer [Aura]" id="11d1-0c88-d632-83ad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ADEPTA SORORITAS CORE or ADEPTA SORORITAS CHARACTER unit is within 6&quot; of this model, add 1 to the Leadership characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
