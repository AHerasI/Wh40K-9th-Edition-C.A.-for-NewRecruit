                <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">6+</characteristic>
              </characteristics>
            </profile>
            <profile name="Recount the Deeds of the Saints" id="e77b-74cc-b20f-75df" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly ADEPTA SORORITAS CHARACTER unit within 9&quot; of AGATHAE DOLAN. Until the start of your next Command phase, each time that unit is selected to fight, you can re-roll one hit roll, one wound roll or one damage roll when resolving that unit’s attacks.</characteristic>
              </characteristics>
            </profile>
          </profiles>
