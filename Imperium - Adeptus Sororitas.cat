            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Inspiring Orator" id="fcaf-9e07-7fc1-090e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD intones a hymn or uses an ability in your Command phase that specifies a range, you can add 3&quot; to the range of that hymn or ability. This does not affect the Miracle range of any abilities.</characteristic>
              </characteristics>
            </profile>
            <profile name="Inspiring Orator [Aura]" id="773f-e48a-d1e2-5eb0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE unit is within 6&quot; of this WARLORD, that unit ignores the Combat Attrition penalty for being below Half-strength.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="TEC - Terrible Knowledge" id="e728-f8aa-3167-e0cf" collective="false" hidden="true" import="true" type="upgrade">
          <constraints>
