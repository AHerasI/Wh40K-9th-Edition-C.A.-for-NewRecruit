            <conditionGroup type="and">
              <conditions>
                <condition childId="2702-5e01-3b9c-d462" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
                <condition childId="45ec-6088-d124-c308" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Blinding Radiance" id="21cc-6224-a8e8-29ff" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="757c-47b0-62c2-f5e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="2"/>
            <cost name="Pts" typeId="points" value="30"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Blessing of the Faithful" id="4110-6fd0-df71-bd91" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">To activate a Blessing of the Faithful ability, during your Command Phase, discard 1 Miracle dice, and, until your next Command phase, that ability is active for that model.

Value of discarded Dice--&gt;Range of Blessing ability:
1 --&gt; 1&quot;
2-5 --&gt; 3&quot;
6 --&gt; 6&quot;</characteristic>
              </characteristics>
            </profile>
            <profile name="Blinding Radiance" id="fc68-b765-9e11-dbc6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against this model, subtract 1 from that attack’s wound roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="Blessing: Blinding Radiance" id="e422-d5ab-f704-7638" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER unit is within Blessing range of this model, each time a ranged attack is made against that unit, subtract 1 from that attack’s hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Emperor’s Grace" id="bda0-3bfb-4213-2045" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="59d1-2598-f91e-1d6d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="20"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Blessing of the Faithful" id="437a-fedc-3c1e-99b7" hidden="false" targetId="4110-6fd0-df71-bd91" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Blessing: The Emperor’s Grace" id="35dd-d35c-8753-a307" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER unit is within Blessing range of this model, each time an attack is made against that unit, your opponent cannot re-roll the hit roll, cannot re-roll the wound roll and cannot re-roll the damage roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="The Emperor’s Grace" id="189b-dc09-1da7-cd4c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each of your Command phases, this model is healed and regains D3 lost wounds. Each model can only be healed once per turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rapturous Blows" id="b705-3753-58a2-ea31" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d54a-98a2-a40f-5ed4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="25"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Blessing of the Faithful" id="8537-f2b7-d6ed-ff6b" hidden="false" targetId="4110-6fd0-df71-bd91" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Blessing: Rapturous Blows" id="d1cc-36f6-bd84-58cc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER unit is within Blessing range of this model, each time a model in that unit makes a melee attack, on an unmodified wound roll of 6, that attack inflicts one mortal wound in addition to the normal damage.</characteristic>
              </characteristics>
            </profile>
            <profile name="Rapturous Blows" id="7eb5-da74-5399-73ab" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Strength and Damage characteristics of all melee weapons this model is equipped with (excluding Relics).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Righteous Judgement" id="8197-9ec6-5be0-1792" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc52-d68a-e566-038d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="25"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Blessing of the Faithful" id="5343-b623-79c0-4130" hidden="false" targetId="4110-6fd0-df71-bd91" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Blessing: Righteous Judgement" id="de5f-1d29-3e98-03e5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER model is within Blessing range of this model, each time that model makes a ranged attack, the target does not receive the benefits of cover against that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="Righteous Judgement" id="fd76-592e-6bbd-25a7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you select a target for this model’s ranged weapons, you can ignore the Look Out, Sir rule. Each time this model makes a ranged attack, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Divine Deliverance" id="8094-2cb0-2926-e053" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="077c-19bc-db35-b5f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="Pts" typeId="points" value="15"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Blessing of the Faithful" id="3bbf-5044-14c0-3dd7" hidden="false" targetId="4110-6fd0-df71-bd91" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Divine Deliverance" id="06fd-e84f-1b1c-f8c0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your opponent’s Command phase, select one enemy unit within 6&quot; of this model and select one Aura ability that unit has. Roll 2D6: if the result is equal to or greater than that enemy unit’s Leadership characteristic, then until the start of your opponent’s next Command phase, that enemy unit loses that Aura ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Blessing: Divine Deliverance" id="e493-ed57-0432-d9d0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER model is within Blessing range of this model, each time that model makes a ranged attack, if that attack causes an enemy model to be destroyed, until the end of the turn, subtract 1 from that enemy unit’s Leadership characteristic.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Word of the Emperor" id="1040-c156-282f-9cb2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6789-f800-7d43-3528" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="2"/>
            <cost name="Pts" typeId="points" value="40"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Blessing of the Faithful" id="788d-baf8-c246-be5f" hidden="false" targetId="4110-6fd0-df71-bd91" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Blessing: Word of the Emperor" id="715f-bc2f-44bd-ff63" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within Blessing range of this model, each time a model in a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER unit makes a melee attack against that enemy unit, invulnerable saving throws cannot be made against that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="Word of the Emperor" id="5a2b-f376-1211-3c10" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, you can select one enemy unit within 3&quot; of this model. That unit is not eligible to fight this phase until after all eligible units from your army have done so.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
