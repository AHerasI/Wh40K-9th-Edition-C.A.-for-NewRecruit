          <profiles>
            <profile name="Selfless heroism" id="5248-51a4-3384-ddb7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- This WARLORD is eligible to perform a Heroic Intervention if it is within 6&quot; horizontally and 5&quot; vertically of any enemy unit, instead of 3&quot; horizontally and 5&quot; vertically. Each time this WARLORD makes a Heroic Intervention move, it can move up to 6&quot;. All other rules for Heroic Interventions still apply.
- At the start of the Fight phase, if this WARLORD is within Engagement Range of any enemy units, it can fight first that phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="OML - Shield Bearer" id="b529-9a86-0ec7-48fb" collective="false" hidden="true" import="true" type="upgrade">
