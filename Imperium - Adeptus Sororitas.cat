    <selectionEntryGroup name="Hymns of Battle" id="396f-b578-f5d6-2c38" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="85a2-5088-6d83-d49f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
        <constraint id="8b22-8b7d-2e65-d00f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="2"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="0 - War Hymn" id="c54c-16c3-8bd8-2359" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc7a-950b-8e89-cb92" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c402-2421-33f2-d687" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="War Hymn" id="e389-0111-96eb-b032" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this hymn is inspiring, select one friendly ADEPTUS SORORITAS CORE, ADEPTUS SORORITAS CHARACTER or IMPERIUM SERVANT CORE unit within 6&quot; of this PRIEST model. 
Until the end of the battle, add 1 to the attacks characteristic of models in that unit.
A unit can be affected by this hymn once per battle.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="1 - Refrain of blazing Piety" id="13f9-cd5c-fc3b-14a9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7039-e6bf-5827-4f5c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Refrain of blazing Piety" id="b70e-b938-0bca-bfd7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this hymn is inspiring, select one enemy unit that is within 12&quot; of and visible to this PRIEST model. Until the start of your next Command phase, that unit reduces their Leadership characteristic by 2.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="2 - Chorus of Spiritual fortitude" id="4240-1705-721f-e8e1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dcc2-2de4-6e1a-c809" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="Pts" typeId="points" value="0"/>
            <cost name="RP" typeId="ed03-25cc-2681-bdce" value="0"/>
          </costs>
          <profiles>
            <profile name="Chorus of Spiritual fortitude" id="6f80-f6c0-210e-db25" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this hymn is inspiring, select one friendly ADEPTUS SORORITAS CORE, ADEPTUS SORORITAS CHARACTER or IMPERIUM SERVANT CORE unit within 6&quot; of this PRIEST model.
- If that unit or its models are being affected by any psychic powers manifested by enemy models, the effects of those psychic powers on that unit and its models end.
- Until the start of your next Command phase, that unit and the models it contains are not affected by any psychic power manifested by enemy units.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="3 - Psalm of righterous Smiting" id="9409-6d26-56d1-a0ee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dd6c-e3ac-6b2c-ba1f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
