            <profile name="Beacon of Faith [Aura]" id="6aa2-c4fe-1fa9-8cad" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER unit is within 6&quot; of this WARLORD, that unit has the Objective Secured ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6 - Pure of Will" id="53f1-c695-5243-4617" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9a65-72ce-6e01-c459" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="bc50-bbde-9443-036f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
