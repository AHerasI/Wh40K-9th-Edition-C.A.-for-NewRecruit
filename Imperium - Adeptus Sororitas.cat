              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- This WARLORD can attempt to deny one additional psychic power in your opponent’s Psychic phase, as described in the Shield of Faith ability.
- Add 1 to Deny the Witch tests taken for this WARLORD.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
