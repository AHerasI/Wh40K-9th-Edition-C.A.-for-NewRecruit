              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when this WARLORD performs an Act of Faith, 1 Miracle dice used in that Act of Faith is considered to be a 6 (irrespective of its actual value).</characteristic>
              </characteristics>
            </profile>
            <profile name="Light of the Divine [Aura]" id="234a-dcbe-4e1f-b521" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ORDER OF THE SACRED ROSE CORE unit is within 6&quot; of this WARLORD, if that CORE unit Falls Back then is still eligible to shoot this turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
