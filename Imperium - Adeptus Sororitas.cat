        <profile name="Sacred Task [Aura]" id="d858-8e9e-d228-be9d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;ORDER&gt; CORE unit that is performing an action is within 6&quot; of this model, that unit can shoot without that action failing.</characteristic>
