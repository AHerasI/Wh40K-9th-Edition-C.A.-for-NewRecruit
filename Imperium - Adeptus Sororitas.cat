    <selectionEntry name="Saint Celestine" id="5d78-a42d-ef4d-86fe" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Faction: Imperium" id="072b-f22f-613b-051a" hidden="false" primary="false" targetId="84e2-9fa9-ebe6-1d18"/>
