          </characteristics>
        </profile>
        <profile name="Righteous Repugnance" id="4029-07b2-af90-dc1d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of the Fight phase, if this model is within Engagement Range of any enemy units, it can fight again.</characteristic>
          </characteristics>
        </profile>
        <profile name="Commander of the Adepta Sororitas" id="6eff-5ac4-299e-ea5a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly ADEPTA SORORITAS CORE or ADEPTA SORORITAS CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Abbess Sanctorum [Aura]" id="9c63-c0a2-e2bf-9bdd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ADEPTA SORORITAS CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1 and re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Holy Aegis" id="5f54-1a61-efea-bcb6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this model, halve the Damage characteristic of that attack (rounding up).</characteristic>
          </characteristics>
        </profile>
      </profiles>
